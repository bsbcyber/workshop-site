---
import { profile } from '../../../../starters/portfolio/src/data/profile.js';
import Resume from '../../../../starters/portfolio/src/layouts/Resume.astro';
const assetBase = import.meta.env.BASE_URL + 'starter-assets/';
const pageBase = import.meta.env.BASE_URL + 'previews/resume/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#000000" />
  <title>Resume site preview</title>
  <style>html,body{margin:0;background:#fff}</style>
</head>
<body>
  <Resume profile={profile} assetBase={assetBase} pageBase={pageBase} />
</body>
</html>
