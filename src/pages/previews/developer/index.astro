---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Developer portfolio preview">
<div class="container"><section class="page-hero"><div class="eyebrow">Portfolio demo · 02 / Developer</div><h1>Projects and code samples.</h1><p>A portfolio for students applying to software, data, cloud, security, and IT roles. Put projects near the top and explain what each one does.</p><div class="actions"><a class="btn" href={import.meta.env.BASE_URL+'designs/'}>← Back to designs</a><button class="btn primary" onclick="window.print()">Print / save PDF</button></div></section>
<section id="portfolio-preview" class="dev-demo"><div class="dev-nav"><span>JL<span class="dev-dot">.</span></span><span>ABOUT&nbsp;&nbsp; / &nbsp;&nbsp;PROJECTS&nbsp;&nbsp; / &nbsp;&nbsp;CONTACT</span></div><div class="dev-hero"><div><div class="dev-badge">AVAILABLE FOR INTERNSHIPS</div><h2>Hi, I'm Jordan.<br/><span>I study MIS and work on small software projects.</span></h2><p>I’m interested in software, cloud platforms, automation, and security. I learn by building small projects.</p><div class="tag-row"><span>Python</span><span>SQL</span><span>GitHub</span><span>Cloud</span></div></div><div class="dev-terminal"><div class="terminal-top"><i></i><i></i><i></i><span>profile.ts</span></div><pre><b>const</b> jordan = &#123;
  focus: <em>"technology"</em>,
  approach: <em>"learn by building"</em>,
  currently: <em>"building small projects"</em>
&#125;;</pre></div></div><div class="dev-section-title"><span>01 / SELECTED PROJECTS</span><span>Selected projects ↓</span></div><div class="dev-cards"><article><span>WEB / UX</span><h3>Campus Resource Finder</h3><p>A responsive interface to help students find useful campus services quickly.</p><small>HTML · CSS · UX RESEARCH</small></article><article><span>DATA / AUTOMATION</span><h3>Student Budget Analyzer</h3><p>A small tool that categorizes spending and visualizes monthly trends.</p><small>PYTHON · PANDAS · CHARTS</small></article><article><span>SECURITY / LEARNING</span><h3>Secure Setup Checklist</h3><p>A documented starter checklist for safer development environments.</p><small>GIT · DOCUMENTATION · SECURITY</small></article></div></section></div>
<style>.dev-demo{background:#111711;color:#edf1e7;border:1px solid #29352a;border-radius:20px;padding:clamp(18px,4vw,44px);font-family:'DM Mono',monospace}.dev-nav{display:flex;justify-content:space-between;gap:15px;font-size:10px;color:#bbc5b5;border-bottom:1px solid #344035;padding-bottom:18px}.dev-nav>span:first-child{font-size:22px;color:white;font-weight:700}.dev-dot{color:#c8ef62}.dev-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:center;padding:50px 0}.dev-badge{font-size:10px;color:#d2ee6a;border:1px solid #5e704b;border-radius:99px;display:inline-block;padding:8px 10px}.dev-hero h2{font:bold clamp(34px,6vw,62px)/1.08 'DM Sans',sans-serif;letter-spacing:-.06em;margin:18px 0}.dev-hero h2 span{color:#c9ef65}.dev-hero p{font:14px/1.7 'DM Sans',sans-serif;color:#a9b5a7;max-width:500px}.dev-hero .tag-row span{border:1px solid #43513f;padding:6px 9px;border-radius:6px;font-size:10px;color:#d0e0c9}.dev-terminal{border:1px solid #3b4b39;border-radius:12px;overflow:hidden;background:#1a241a}.terminal-top{display:flex;align-items:center;gap:5px;padding:12px;border-bottom:1px solid #344235}.terminal-top i{width:7px;height:7px;border-radius:50%;background:#839d65}.terminal-top span{font-size:10px;color:#a1ad9b;margin-left:auto}.dev-terminal pre{white-space:pre-wrap;padding:18px;font:12px/2 'DM Mono',monospace;color:#d9e2d1}.dev-terminal b{color:#bfe77a}.dev-terminal em{color:#e5c98b;font-style:normal}.dev-section-title{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;border-bottom:1px solid #344035;padding:16px 0;font-size:10px;color:#b7c7ab}.dev-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding-top:16px}.dev-cards article{padding:18px;background:#1c261c;border:1px solid #354335;border-radius:12px}.dev-cards article span,.dev-cards small{font-size:9px;letter-spacing:.06em;color:#c5ec72}.dev-cards h3{font:600 17px 'DM Sans',sans-serif}.dev-cards p{font:12px/1.7 'DM Sans',sans-serif;color:#b0bdad}.dev-cards small{color:#8ca186}@media(max-width:700px){.dev-hero,.dev-cards{grid-template-columns:1fr}.dev-nav span:last-child{font-size:8px}}</style>
</BaseLayout>