---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Developer portfolio preview" description="Dark, projects-first portfolio layout for technical roles.">
<div class="container">
  <section class="page-hero">
    <div class="eyebrow">Portfolio demo · 02 / Developer</div>
    <h1>Projects first. Dark technical theme.</h1>
    <p>This is the same Developer theme students download. Projects appear near the top. Edit <code>src/data/profile.js</code> and optional <code>public/photo.jpg</code>.</p>
    <div class="actions">
      <a class="btn" href={base + 'designs/'}>← Back to designs</a>
      <a class="btn primary" href={base + 'downloads/portfolio-developer.zip'}>Download Developer theme ↓</a>
      <a class="btn" href={base + 'student-guide/#step-4'}>How to personalize ↗</a>
    </div>
  </section>
  <div class="live-frame">
    <iframe src={base + 'previews/developer/embed/'} title="Developer portfolio theme" loading="eager"></iframe>
  </div>
</div>
<style>
.live-frame{border:1px solid #2a352a;border-radius:8px;overflow:hidden;background:#111711;min-height:70vh}
.live-frame iframe{display:block;width:100%;height:min(85vh,920px);border:0}
.page-hero code{font:12px 'DM Mono',monospace;background:#f0f0ec;padding:2px 5px;border-radius:4px}
</style>
</BaseLayout>
