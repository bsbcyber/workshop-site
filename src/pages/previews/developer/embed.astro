---
import { profile as baseProfile } from '../../../../starters/portfolio/src/data/profile.js';
import Developer from '../../../../starters/portfolio/src/layouts/themes/Developer.astro';
const profile = { ...baseProfile, theme: 'developer' };
const assetBase = import.meta.env.BASE_URL + 'starter-assets/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#111711" />
  <title>Developer portfolio preview</title>
  <style>html,body{margin:0;background:#111711}</style>
</head>
<body>
  <Developer profile={profile} assetBase={assetBase} />
</body>
</html>
