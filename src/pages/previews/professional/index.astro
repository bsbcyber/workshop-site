---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Professional portfolio preview" description="Two-column recruiter-friendly resume layout.">
<div class="container">
  <section class="page-hero">
    <div class="eyebrow">Portfolio demo · 03 / Professional</div>
    <h1>A clear, recruiter-friendly resume layout.</h1>
    <p>This is the same Professional theme students download. Sidebar contact and skills, main column for experience and projects.</p>
    <div class="actions">
      <a class="btn" href={base + 'designs/'}>← Back to designs</a>
      <a class="btn primary" href={base + 'downloads/portfolio-professional.zip'}>Download Professional theme ↓</a>
      <a class="btn" href={base + 'student-guide/#step-4'}>How to personalize ↗</a>
      <button class="btn" type="button" onclick="window.print()">Print / save PDF</button>
    </div>
  </section>
  <div class="live-frame">
    <iframe src={base + 'previews/professional/embed/'} title="Professional portfolio theme" loading="eager"></iframe>
  </div>
</div>
<style>
.live-frame{border:1px solid #d7d7d2;border-radius:8px;overflow:hidden;background:#fff;min-height:70vh}
.live-frame iframe{display:block;width:100%;height:min(85vh,920px);border:0}
.page-hero code{font:12px 'DM Mono',monospace;background:#f0f0ec;padding:2px 5px;border-radius:4px}
@media print{.site-header,.site-footer,.page-hero{display:none!important}.live-frame{border:0}.live-frame iframe{height:100vh}}
</style>
</BaseLayout>
