---
import { profile as baseProfile } from '../../../../starters/portfolio/src/data/samples/professional.js';
import Professional from '../../../../starters/portfolio/src/layouts/themes/Professional.astro';
const profile = { ...baseProfile, theme: 'professional' };
const assetBase = import.meta.env.BASE_URL + 'starter-assets/';
const pageBase = import.meta.env.BASE_URL + 'previews/professional/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#000000" />
  <title>Professional portfolio preview</title>
  <style>html,body{margin:0;background:#fff}</style>
</head>
<body>
  <Professional profile={profile} assetBase={assetBase} pageBase={pageBase} />
</body>
</html>
