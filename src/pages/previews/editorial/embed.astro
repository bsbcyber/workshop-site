---
import { profile as baseProfile } from '../../../../starters/portfolio/src/data/profile.js';
import Editorial from '../../../../starters/portfolio/src/layouts/themes/Editorial.astro';
const profile = { ...baseProfile, theme: 'editorial' };
const assetBase = import.meta.env.BASE_URL + 'starter-assets/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#fbf7ed" />
  <title>Editorial portfolio preview</title>
  <style>html,body{margin:0;background:#fbf7ed}</style>
</head>
<body>
  <Editorial profile={profile} assetBase={assetBase} />
</body>
</html>
