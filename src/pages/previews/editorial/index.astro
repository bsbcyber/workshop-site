---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Editorial portfolio preview" description="Warm, story-led portfolio layout with photo support and an experience timeline.">
<div class="container">
  <section class="page-hero">
    <div class="eyebrow">Portfolio demo · 01 / Editorial</div>
    <h1>Warm layout with room for your story.</h1>
    <p>This is the same Editorial theme students download. Edit <code>src/data/profile.js</code>, add a photo in <code>public/</code>, then publish with GitHub Pages.</p>
    <div class="actions">
      <a class="btn" href={base + 'designs/'}>← Back to designs</a>
      <a class="btn primary" href={base + 'downloads/portfolio-editorial.zip'}>Download Editorial theme ↓</a>
      <a class="btn" href={base + 'student-guide/#step-4'}>How to personalize ↗</a>
    </div>
  </section>
  <div class="live-frame">
    <iframe src={base + 'previews/editorial/embed/'} title="Editorial portfolio theme" loading="eager"></iframe>
  </div>
</div>
<style>
.live-frame{border:1px solid #d7d7d2;border-radius:8px;overflow:hidden;background:#fbf7ed;min-height:70vh}
.live-frame iframe{display:block;width:100%;height:min(85vh,920px);border:0}
.page-hero code{font:12px 'DM Mono',monospace;background:#f0f0ec;padding:2px 5px;border-radius:4px}
</style>
</BaseLayout>
