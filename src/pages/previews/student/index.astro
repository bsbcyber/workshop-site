---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Student portfolio preview" description="Coursework- and activities-first portfolio layout for students without internships yet.">
<div class="container">
  <section class="page-hero">
    <div class="eyebrow">Portfolio demo · 01 / Student</div>
    <h1>Built for classes, clubs, and projects.</h1>
    <p>This is the same Student theme students download. Edit <code>src/data/profile.js</code>, add a photo in <code>public/</code>, then publish with GitHub Pages.</p>
    <div class="actions">
      <a class="btn" href={base + 'designs/'}>← Back to designs</a>
      <a class="btn primary" href={base + 'downloads/portfolio-student.zip'}>Download Student theme ↓</a>
      <a class="btn" href={base + 'student-guide/#step-4'}>How to personalize ↗</a>
    </div>
  </section>
  <div class="live-frame">
    <iframe src={base + 'previews/student/embed/'} title="Student portfolio theme" loading="eager"></iframe>
  </div>
</div>
<style>
.live-frame{border:1px solid #d7d7d2;border-radius:8px;overflow:hidden;background:#f4f7fb;min-height:70vh}
.live-frame iframe{display:block;width:100%;height:min(85vh,920px);border:0}
.page-hero code{font:12px 'DM Mono',monospace;background:#f0f0ec;padding:2px 5px;border-radius:4px}
</style>
</BaseLayout>
