font-weight:700;text-underline-offset:3px}.finish-links{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.finish-links .btn:not(.primary){color:#fff;border-color:#555}.finish-links .btn:not(.primary):hover{color:#000}
@media(max-width:650px){.guide-status{align-items:flex-start;flex-direction:column}.guide-progress{width:100%}.command-grid,.command-grid-short{grid-template-columns:1fr}.guide-step{grid-template-columns:42px 1fr;gap:12px;padding:28px 0}.step-number{width:38px;height:38px;font-size:19px}.tool-cards,.student-designs,.tool-cards-five{grid-template-columns:1fr}.tool-check{grid-template-columns:1fr}.design-swatch{height:180px}.deploy-illustration{grid-template-columns:1fr}.deploy-illustration>div{transform:rotate(90deg)}.step-task{padding:15px}.walkthrough-figure{padding:6px}.prompt-heading{align-items:flex-start;flex-direction:column}.mini-workflow{gap:6px}.mini-workflow span{font-size:10px;padding:7px 8px}}

.hero-accent{color:#5b5b57}
.mission-map{margin:0 0 28px;background:#111;color:#f6f6f2;padding:clamp(20px,3.5vw,34px);border-radius:8px;position:relative;overflow:hidden}
.mission-map:before{content:"";position:absolute;inset:0 auto 0 0;width:5px;background:#FFDB00}
.mission-map-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}
.mission-map-head .eyebrow{color:#FFDB00}
.mission-map-head h2{font:700 clamp(25px,3.2vw,35px)/1.05 'Titillium Web',sans-serif;margin:7px 0 0;letter-spacing:-.025em}
.mission-map-head>p{max-width:390px;margin:0;color:#c4c4bf;font:13px/1.6 'Roboto',sans-serif}
.route-track{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin:28px 0 25px;position:relative}
.route-track:before{content:"";position:absolute;left:5%;right:5%;top:18px;height:2px;background:#4d4d49}
.route-track:after{content:"";position:absolute;left:5%;top:18px;width:0;height:2px;background:#FFDB00;animation:routeDraw 2.2s .3s ease-out forwards;max-width:90%}
@keyframes routeDraw{to{width:90%}}
.route-stop{position:relative;z-index:1;text-decoration:none;color:#f5f5f1;display:grid;justify-items:start;gap:6px;min-width:0}
.route-node{width:38px;height:38px;display:grid;place-items:center;border:2px solid #777772;background:#111;border-radius:50%;font:700 11px 'DM Mono',monospace;transition:background .2s,border-color .2s,color .2s,transform .2s}
.route-stop b{font:700 14px 'Titillium Web',sans-serif}
.route-stop small{font:10px 'Roboto',sans-serif;color:#aaa}
.route-stop:hover .route-node,.route-stop.is-current .route-node{background:#FFDB00;color:#000;border-color:#FFDB00;transform:translateY(-2px)}
.route-stop.is-current b{color:#FFDB00}
.route-stop.is-done .route-node{background:#242420;border-color:#FFDB00;color:#FFDB00}.route-stop.is-done .route-node:after{content:"✓";font-size:12px}.route-stop.is-done .route-node{font-size:0}
.route-rescue{display:grid;grid-template-columns:minmax(160px,.7fr) 1.4fr;gap:10px 22px;border-top:1px solid #42423d;padding-top:18px}
.route-rescue>div:first-child{display:grid;align-content:start;gap:4px}
.route-rescue>div:first-child b{font:700 13px 'Titillium Web',sans-serif}
.route-rescue>div:first-child span{font:11px/1.45 'Roboto',sans-serif;color:#aaa}
.rescue-options{display:flex;gap:7px;flex-wrap:wrap}
.rescue-options button{background:#20201e;color:#eee;border:1px solid #565650;border-radius:4px;padding:8px 10px;font:600 10px 'Roboto',sans-serif;cursor:pointer}
.rescue-options button:hover,.rescue-options button.chosen{background:#FFDB00;border-color:#FFDB00;color:#111}
#route-advice{grid-column:2;margin:0;color:#d7d7d1;font:12px/1.5 'Roboto',sans-serif}
#route-next-link{grid-column:2;color:#FFDB00;font:700 11px 'Roboto',sans-serif;text-underline-offset:3px;justify-self:start}
.guide-status{border-radius:7px}
.guide-status .eyebrow{color:#555}
.guide-status .progress-bar{background:#111;position:relative}
.guide-status .progress-bar:after{content:"";position:absolute;right:0;top:0;bottom:0;width:3px;background:#FFDB00}
.guide-step{position:relative;transition:opacity .4s ease,transform .4s ease}
.guide-step:before{content:"";position:absolute;left:27px;top:92px;bottom:-1px;width:1px;background:#d8d8d2}
.guide-step:last-of-type:before{display:none}
.guide-step .step-number{z-index:1;position:relative;border-radius:50%;font-size:17px}
.step-kicker{display:flex;align-items:center;gap:8px}
html.guide-enhanced .guide-step{opacity:.74;transform:translateY(12px)}
html.guide-enhanced .guide-step.is-visible{opacity:1;transform:translateY(0)}
html.guide-enhanced .guide-step.is-visible .step-number{box-shadow:0 0 0 5px #ffdb0030}
.actual-product-screen{border:1px solid #d5d5d0;border-radius:5px;padding:10px;background:#f5f5f3}
.screen-label{display:flex;align-items:center;justify-content:space-between;gap:10px;font:700 9px 'Titillium Web',sans-serif;letter-spacing:.07em;color:#555;padding:1px 1px 7px}
.screen-label a{font:700 10px 'Roboto',sans-serif;color:#222;text-underline-offset:2px;white-space:nowrap}
.actual-product-screen img{width:100%;max-height:440px;object-fit:contain;object-position:top center;background:#fff;border:1px solid #ddd;border-radius:3px}
.actual-product-screen figcaption{font:12px/1.5 'Roboto',sans-serif;padding:9px 2px 0;color:#555}
.actual-product-screen figcaption a{font-weight:700}
.git-state-lab{background:#f0f0ed;border:1px solid #d3d3cd;border-top:4px solid #111;margin:22px 0;padding:clamp(15px,2.4vw,24px)}
.lab-heading{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}
.lab-heading h3{font:700 23px/1.1 'Titillium Web',sans-serif;margin:6px 0}
.lab-heading p{font:12px/1.5 'Roboto',sans-serif;color:#555;margin:0}
.lab-status{font:700 9px 'DM Mono',monospace;letter-spacing:.08em;padding:6px 8px;border:1px solid #bbb;color:#555;white-space:nowrap}
.git-state-track{display:grid;grid-template-columns:1fr 22px 1fr 22px 1fr 22px 1fr;gap:5px;align-items:center;margin:20px 0}
.git-state-button{display:grid;grid-template-columns:25px 1fr;gap:1px 8px;align-items:center;text-align:left;border:1px solid #c9c9c3;background:#fff;border-radius:2px;padding:9px 10px;cursor:pointer;min-width:0;transition:background .2s,border-color .2s,transform .2s}
.git-state-button>span{grid-row:span 2;width:25px;height:25px;display:grid;place-items:center;background:#e8e8e4;color:#555;font:700 10px 'DM Mono',monospace}
.git-state-button>b{font:700 12px 'Titillium Web',sans-serif}
.git-state-button>small{font:9px 'Roboto',sans-serif;color:#666}
.git-state-button:hover{transform:translateY(-2px)}
.git-state-button.is-current{border-color:#111;background:#111;color:#fff}
.git-state-button.is-current>span{background:#FFDB00;color:#111}
.git-state-button.is-current>small{color:#ccc}
.state-connector{color:#999;text-align:center}
.git-state-detail{display:grid;grid-template-columns:1fr 1fr;gap:15px;transition:opacity .2s,transform .2s}
.git-state-detail.state-updated{animation:stateEnter .23s ease-out}
@keyframes stateEnter{from{opacity:.65;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.fake-terminal-real-meaning{background:#171717;color:#f3f3ef;min-width:0;border-radius:0;overflow:hidden}
.terminal-chrome{display:flex;align-items:center;gap:12px;padding:10px 12px;border-bottom:1px solid #41413c}
.terminal-chrome span{font-size:8px;letter-spacing:2px;color:#999}
.terminal-chrome b{font:700 9px 'Titillium Web',sans-serif;letter-spacing:.08em;color:#aaa}
.fake-terminal-real-meaning pre{white-space:pre-wrap;overflow-wrap:anywhere;margin:0;padding:14px;font:11px/1.65 'DM Mono',monospace;color:#eee}
.git-state-explanation{padding:3px 0}
.state-number{font:700 9px 'DM Mono',monospace;letter-spacing:.1em;color:#666}
.git-state-explanation h4{font:700 19px/1.15 'Titillium Web',sans-serif;margin:8px 0}
.git-state-explanation>p{font:12px/1.55 'Roboto',sans-serif;color:#555}
.next-command{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px 0;border-top:1px solid #ccc;border-bottom:1px solid #ccc}
.next-command>div{display:grid;gap:5px;min-width:0}
.next-command>div>span{font:700 9px 'Titillium Web',sans-serif;letter-spacing:.1em;color:#666}
.next-command code{overflow-wrap:anywhere;font:11px 'DM Mono',monospace}
.next-command .copy-button{flex-shrink:0}
.lab-small-note{font:10px/1.5 'Roboto',sans-serif!important;color:#666!important;margin:8px 0 0!important}
@media(max-width:760px){
 .mission-map-head{align-items:flex-start;flex-direction:column}
 .route-track{grid-template-columns:repeat(3,minmax(0,1fr));row-gap:18px}
 .route-track:before,.route-track:after{display:none}
 .route-rescue{grid-template-columns:1fr}
 #route-advice,#route-next-link{grid-column:1}
 .guide-step:before{left:19px}
 .git-state-track{grid-template-columns:1fr 15px 1fr;gap:6px}
 .git-state-track .state-connector:nth-of-type(4){display:none}
 .git-state-detail{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){
 .route-track:after{animation:none;width:90%}
 .route-node,.git-state-button,.guide-step{transition:none}
 html.guide-enhanced .guide-step{opacity:1;transform:none}
 .git-state-detail.state-updated{animation:none}
}
</style>
<script>
const checks=[...document.querySelectorAll('[data-step-check]')];
const storageKey='mis-workshop-student-walkthrough';
try{const saved=JSON.parse(localStorage.getItem(storageKey)||'{}');checks.forEach(c=>c.checked=!!saved[c.dataset.stepCheck])}catch{}
function updateGuideProgress(){const done=checks.filter(c=>c.checked).length;const pct=Math.round(done/checks.length*100);document.querySelector('#guide-progress-label').textContent=done+' of '+checks.length+' steps complete';document.querySelector('#guide-progress-percent').textContent=pct+'%';document.querySelector('#guide-progress-bar').style.width=pct+'%';checks.forEach(c=>{const stop=document.querySelector('[data-route-step="'+c.dataset.stepCheck+'"]');if(stop)stop.classList.toggle('is-done',c.checked)});try{localStorage.setItem(storageKey,JSON.stringify(Object.fromEntries(checks.map(c=>[c.dataset.stepCheck,c.checked]))))}catch{}}
checks.forEach(c=>c.addEventListener('change',updateGuideProgress));updateGuideProgress();
document.querySelectorAll('[data-copy-prompt]').forEach(button=>button.addEventListener('click',async()=>{const target=document.getElementById(button.dataset.copyPrompt);try{await navigator.clipboard.writeText(target.textContent.trim());button.textContent='Copied ✓'}catch{const range=document.createRange();range.selectNodeContents(target);const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Select text and copy'}setTimeout(()=>button.textContent='Copy prompt',1800)}));
document.querySelectorAll('[data-copy-command]').forEach(button=>button.addEventListener('click',async()=>{const target=document.getElementById(button.dataset.copyCommand);try{await navigator.clipboard.writeText(target.textContent.trim());button.textContent='Copied ✓'}catch{const range=document.createRange();range.selectNodeContents(target);const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Select text and copy'}setTimeout(()=>button.textContent='Copy',1800)}));

const routeAdvice=document.querySelector('#route-advice');
const routeNext=document.querySelector('#route-next-link');
const rescueAdvice={
 start:{text:'Check that you can sign in to GitHub and open VS Code. Then download a theme ZIP and create an empty public repository.',href:'#step-1',label:'Go to step 1 →'},
 local:{text:'If the local site already works, go to Step 4 to edit profile.js (or Step 5 if you already personalized and need the Git review path).',href:'#step-4',label:'Go to step 4 →'},
 push:{text:'Before trying again, run git status and git remote -v. Check auth (browser login or PAT). Push steps live in Step 3; do not force-push.',href:'#step-3',label:'Go to step 3 →'},
 actions:{text:'Open the latest Actions run, expand the failed job, and read the first error that explains why it stopped. Step 6 covers common deployment problems.',href:'#step-6',label:'Go to step 6 →'}
};
document.querySelectorAll('[data-route-help]').forEach(button=>button.addEventListener('click',()=>{
  const item=rescueAdvice[button.dataset.routeHelp];
  document.querySelectorAll('[data-route-help]').forEach(b=>b.classList.toggle('chosen',b===button));
  routeAdvice.textContent=item.text;routeNext.href=item.href;routeNext.textContent=item.label;
}));
const missionSteps=[...document.querySelectorAll('.guide-step[data-step]')];
const routeStops=[...document.querySelectorAll('[data-route-step]')];
if('IntersectionObserver' in window){
  const stepObserver=new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        const active=entry.target.dataset.step;
        routeStops.forEach(stop=>stop.classList.toggle('is-current',stop.dataset.routeStep===active));
      }
    });
  },{rootMargin:'-16% 0px -58% 0px',threshold:0});
  missionSteps.forEach(step=>stepObserver.observe(step));
}else{missionSteps.forEach(step=>step.classList.add('is-visible'))}
document.documentElement.classList.add('guide-enhanced');
const gitStateDetails=[
 {heading:'The edit exists only on your computer.',copy:'Git can see the change, but it is not selected for the next commit.',output:'On branch add-featured-project\nChanges not staged for commit:\n  modified: src/data/profile.js\n\nno changes added to commit',command:'git add src/data/profile.js',note:'Staging a file does not upload it to GitHub.'},
 {heading:'You selected this file for the next commit.',copy:'The staged diff is the exact snapshot the commit will record. Read it before saving history.',output:'On branch add-featured-project\nChanges to be committed:\n  modified: src/data/profile.js',command:'git diff --staged',note:'If the diff is wrong, unstage the file before committing.'},
 {heading:'Git saved a snapshot in local history.',copy:'The commit exists locally. GitHub has not received it yet.',output:'On branch add-featured-project\nnothing to commit, working tree clean\n\nLatest commit: Add featured project',command:'git push -u origin add-featured-project',note:'A local commit is not a push and does not trigger the live deployment.'},
 {heading:'GitHub now has the branch.',copy:'The change is shared, but it is not merged into main. Open a pull request to review it.',output:'On branch add-featured-project\nYour branch is up to date with origin/add-featured-project.\nnothing to commit, working tree clean',command:'Open GitHub → Pull requests → New pull request',note:'After the PR is reviewed and merged to main, check Actions and test the live URL.'}
];
document.querySelectorAll('[data-git-state]').forEach(button=>button.addEventListener('click',()=>{
  const n=Number(button.dataset.gitState),item=gitStateDetails[n];
  document.querySelectorAll('[data-git-state]').forEach(b=>{const active=b===button;b.classList.toggle('is-current',active);b.setAttribute('aria-pressed',String(active))});
  document.querySelector('#git-state-number').textContent='STATE '+String(n+1).padStart(2,'0')+' / 04';
  document.querySelector('#git-state-heading').textContent=item.heading;
  document.querySelector('#git-state-copy').textContent=item.copy;
  document.querySelector('#git-state-output').textContent=item.output;
  document.querySelector('#git-state-command').textContent=item.command;
  document.querySelector('#git-state-note').textContent=item.note;
  document.querySelector('.git-state-detail').classList.remove('state-updated');
  requestAnimationFrame(()=>document.querySelector('.git-state-detail').classList.add('state-updated'));
}));
document.querySelector('#copy-tool-check').addEventListener('click',async()=>{const button=document.querySelector('#copy-tool-check');try{await navigator.clipboard.writeText(document.querySelector('#tool-check-commands').textContent);button.textContent='Copied ✓'}catch{const range=document.createRange();range.selectNodeContents(document.querySelector('#tool-check-commands'));const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Text selected'}setTimeout(()=>button.textContent='Copy commands',1400)});
document.querySelector('#copy-git-state').addEventListener('click',async()=>{
 const text=document.querySelector('#git-state-command').textContent,button=document.querySelector('#copy-git-state');
 try{await navigator.clipboard.writeText(text);button.textContent='Copied ✓'}
 catch{const range=document.createRange();range.selectNodeContents(document.querySelector('#git-state-command'));const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Text selected'}
 setTimeout(()=>button.textContent='Copy command',1400);
});

</script>
</BaseLayout>