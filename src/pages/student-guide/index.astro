<script>
const checks=[...document.querySelectorAll('[data-step-check]')];
const storageKey='mis-workshop-student-walkthrough';
try{const saved=JSON.parse(localStorage.getItem(storageKey)||'{}');checks.forEach(c=>c.checked=!!saved[c.dataset.stepCheck])}catch{}
function updateGuideProgress(){const done=checks.filter(c=>c.checked).length;const pct=Math.round(done/checks.length*100);document.querySelector('#guide-progress-label').textContent=done+' of '+checks.length+' steps complete';document.querySelector('#guide-progress-percent').textContent=pct+'%';document.querySelector('#guide-progress-bar').style.width=pct+'%';checks.forEach(c=>{const stop=document.querySelector('[data-route-step="'+c.dataset.stepCheck+'"]');if(stop)stop.classList.toggle('is-done',c.checked)});try{localStorage.setItem(storageKey,JSON.stringify(Object.fromEntries(checks.map(c=>[c.dataset.stepCheck,c.checked]))))}catch{}}
checks.forEach(c=>c.addEventListener('change',updateGuideProgress));updateGuideProgress();
document.querySelectorAll('[data-copy-prompt]').forEach(button=>button.addEventListener('click',async()=>{const target=document.getElementById(button.dataset.copyPrompt);try{await navigator.clipboard.writeText(target.textContent.trim());button.textContent='Copied ✓'}catch{const range=document.createRange();range.selectNodeContents(target);const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Select text and copy'}setTimeout(()=>button.textContent='Copy prompt',1800)}));
document.querySelectorAll('[data-copy-command]').forEach(button=>button.addEventListener('click',async()=>{const target=document.getElementById(button.dataset.copyCommand);try{await navigator.clipboard.writeText(target.textContent.trim());button.textContent='Copied ✓'}catch{const range=document.createRange();range.selectNodeContents(target);const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Select text and copy'}setTimeout(()=>button.textContent='Copy',1800)}));

const routeAdvice=document.querySelector('#route-advice');
const routeNext=document.querySelector('#route-next-link');
const rescueAdvice={
 start:{text:'Begin with account access and the clean starter. Do not create a repo until you know which local folder you will push.',href:'#step-1',label:'Begin at mission 01 →'},
 local:{text:'Skip setup. Commit to one small task, create a feature branch, and inspect the diff before you push.',href:'#step-5',label:'Go to mission 05 →'},
 push:{text:'Stop before retrying. Run git status and git remote -v. Confirm your branch and remote; do not force-push.',href:base+'resources/',label:'Open the recovery field guide →'},
 actions:{text:'Open the latest Actions run, expand the failed job, and read the first actionable error. Then compare it with the deploy troubleshooting prompt.',href:'#step-6',label:'Go to mission 06 →'}
};
document.querySelectorAll('[data-route-help]').forEach(button=>button.addEventListener('click',()=>{
  const item=rescueAdvice[button.dataset.routeHelp];
  document.querySelectorAll('[data-route-help]').forEach(b=>b.classList.toggle('chosen',b===button));
  routeAdvice.textContent=item.text;routeNext.href=item.href;routeNext.textContent=item.label;
}));
const missionSteps=[...document.querySelectorAll('.guide-step[data-step]')];
const routeStops=[...document.querySelectorAll('[data-route-step]')];
if('IntersectionObserver' in window){
  const stepObserver=new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        const active=entry.target.dataset.step;
        routeStops.forEach(stop=>stop.classList.toggle('is-current',stop.dataset.routeStep===active));
      }
    });
  },{rootMargin:'-16% 0px -58% 0px',threshold:0});
  missionSteps.forEach(step=>stepObserver.observe(step));
}else{missionSteps.forEach(step=>step.classList.add('is-visible'))}
document.documentElement.classList.add('guide-enhanced');
const gitStateDetails=[
 {heading:'The edit exists only on your computer.',copy:'Git can see the change, but it is not selected for the next commit.',output:'On branch add-featured-project\nChanges not staged for commit:\n  modified: src/data/profile.js\n\nno changes added to commit',command:'git add src/data/profile.js',note:'Staging a file does not upload it to GitHub.'},
 {heading:'You selected this file for the next commit.',copy:'The staged diff is the exact snapshot the commit will record. Read it before saving history.',output:'On branch add-featured-project\nChanges to be committed:\n  modified: src/data/profile.js',command:'git diff --staged',note:'If the diff is wrong, unstage the file before committing.'},
 {heading:'Git saved a snapshot in local history.',copy:'The commit exists locally. GitHub has not received it yet.',output:'On branch add-featured-project\nnothing to commit, working tree clean\n\nLatest commit: Add featured project',command:'git push -u origin add-featured-project',note:'A local commit is not a push and does not trigger the live deployment.'},
 {heading:'GitHub now has the branch.',copy:'The change is shared, but it is not merged into main. Open a pull request to review it.',output:'On branch add-featured-project\nYour branch is up to date with origin/add-featured-project.\nnothing to commit, working tree clean',command:'Open GitHub → Pull requests → New pull request',note:'After the PR is reviewed and merged to main, check Actions and test the live URL.'}
];
document.querySelectorAll('[data-git-state]').forEach(button=>button.addEventListener('click',()=>{
  const n=Number(button.dataset.gitState),item=gitStateDetails[n];
  document.querySelectorAll('[data-git-state]').forEach(b=>{const active=b===button;b.classList.toggle('is-current',active);b.setAttribute('aria-pressed',String(active))});
  document.querySelector('#git-state-number').textContent='STATE '+String(n+1).padStart(2,'0')+' / 04';
  document.querySelector('#git-state-heading').textContent=item.heading;
  document.querySelector('#git-state-copy').textContent=item.copy;
  document.querySelector('#git-state-output').textContent=item.output;
  document.querySelector('#git-state-command').textContent=item.command;
  document.querySelector('#git-state-note').textContent=item.note;
  document.querySelector('.git-state-detail').classList.remove('state-updated');
  requestAnimationFrame(()=>document.querySelector('.git-state-detail').classList.add('state-updated'));
}));
document.querySelector('#copy-tool-check').addEventListener('click',async()=>{const button=document.querySelector('#copy-tool-check');try{await navigator.clipboard.writeText(document.querySelector('#tool-check-commands').textContent);button.textContent='Copied ✓'}catch{const range=document.createRange();range.selectNodeContents(document.querySelector('#tool-check-commands'));const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Text selected'}setTimeout(()=>button.textContent='Copy commands',1400)});
document.querySelector('#copy-git-state').addEventListener('click',async()=>{
 const text=document.querySelector('#git-state-command').textContent,button=document.querySelector('#copy-git-state');
 try{await navigator.clipboard.writeText(text);button.textContent='Copied ✓'}
 catch{const range=document.createRange();range.selectNodeContents(document.querySelector('#git-state-command'));const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Text selected'}
 setTimeout(()=>button.textContent='Copy command',1400);
});

</script>
