---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Full-screen Workshop 1 presentation" description="Facilitator deck for Git, GitHub, VS Code, Copilot, and GitHub Pages.">
<div class="presentation-page container">
  <div class="presentation-intro no-print">
    <div>
      <div class="eyebrow">MIS Club · Workshop 1</div>
      <h1>Facilitator deck</h1>
      <p>Pace the room from here. Walkthrough and ZIP are under Resources (R). Your talking points are in Notes (N).</p>
    </div>
    <button class="btn primary launch-fullscreen" data-fullscreen>Enter full screen ↗</button>
  </div>

  <div class="presentation-root" id="presentation-root">
    <header class="deck-topbar no-print">
      <a class="deck-brand" href={base}><span class="deck-mark">W</span><span>WICHITA STATE <small>MIS CLUB · WORKSHOP 1</small></span></a>
      <div class="deck-tools">
        <button class="deck-tool" data-toggle="resources" aria-haspopup="dialog">Resources <kbd>R</kbd></button>
        <button class="deck-tool" data-toggle="notes">Notes <kbd>N</kbd></button>
        <button class="deck-tool" data-fullscreen>Full screen <kbd>F</kbd></button>
      </div>
    </header>

    <div class="deck-stage" id="deck-stage" aria-live="polite">

      <section class="deck-slide cover-slide is-active" data-title="Cover" data-notes="Leave this up while people sit down. Promise: by the end they have a URL they can open on their phone.">
        <div class="slide-num">01</div>
        <div class="cover-body">
          <p class="cover-kicker">Wichita State · MIS Club · 3 hours</p>
          <h2>Build your resume site and put it online.</h2>
          <p class="cover-line">Fill it with your real details, practice Git the way teams do, and leave with a live URL.</p>
        </div>
      </section>

      <section class="deck-slide about-slide about-photo-slide" data-title="About me" data-notes="Smile, wave, keep it human. One beat on Wichita / family / dogs, then move on. Credibility comes next.">
        <div class="slide-num">02</div>
        <div class="about-hero">
          <img class="about-photo" src={`${base}slides/tyler-beach.jpg`} alt="Tyler Beach" width="640" height="640" />
          <div class="about-hero-copy">
            <p class="about-kicker">Your facilitator</p>
            <h2 class="say">I’m Tyler Beach.</h2>
            <p class="talk">Wichita State Barton School of Business alum. Based in Wichita with my wife and two dogs. Security is the day job — not the whole story.</p>
            <ul class="about-chips" aria-label="Quick facts">
              <li>Wichita, KS</li>
              <li>~11 years in industry</li>
              <li>Two dogs at home</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="deck-slide about-slide" data-title="School + work" data-notes="WSU undergrad, Friends MS Cybersecurity, then Datavant. No teaching title. Connect industry work to why Git/PR/Pages matter on real teams.">
        <div class="slide-num">03</div>
        <p class="about-kicker">School + work</p>
        <h2 class="say">Local roots. Industry practice.</h2>
        <ul class="about-list">
          <li><strong>Wichita State</strong> — Barton School of Business alum</li>
          <li><strong>Friends University</strong> — Master’s in Cybersecurity</li>
          <li><strong>Datavant</strong> — Senior Application Security Architect (Product Security)</li>
          <li>Earlier: AppSec and IT risk at Cargill; software development before that</li>
        </ul>
        <p class="talk">I care about developer enablement — the same skills we’re practicing today.</p>
      </section>

      <section class="deck-slide about-slide" data-title="Why I’m here" data-notes="Bridge to the workshop goal. Then advance to “done looks like.”">
        <div class="slide-num">04</div>
        <h2 class="say">I’m here to get you a live resume URL.</h2>
        <p class="talk">Not a toy demo — <em>your</em> content, a real pull request with a partner review, and GitHub Pages publishing the way teams actually ship. Ask questions early. Stuck is normal; guessing burns time.</p>
      </section>

      <section class="deck-slide" data-title="What “done” looks like" data-notes="Primary goal: their resume content, not a tiny demo PR. Git/PR is how we ship a chunk of that work safely. Prefer a real-looking site over a perfect design.">
        <div class="slide-num">05</div>
        <h2 class="say">Today’s job: make this site yours, then publish it.</h2>
        <p class="talk">Name, education, coursework, projects, photo if you want — then a real GitHub Pages URL. We’ll use a branch and pull request so you practice how teams review work before it goes live.</p>
      </section>

      <section class="deck-slide" data-title="Get the starter" data-notes="Hands up when unzipped. Empty Public repo — no README. Folder must be my-resume-site with package.json visible.">
        <div class="slide-num">06</div>
        <h2 class="say">First: download and unzip.</h2>
        <p class="talk">You want a folder named <code>my-resume-site</code>. Also create an empty <strong>Public</strong> GitHub repo — leave README / .gitignore / license unchecked.</p>
        <p class="cta-link"><a href={base + 'downloads/portfolio-starter.zip'}>portfolio-starter.zip ↓</a></p>
        <p class="aside">Inside the folder there’s a <code>WORKSHOP.md</code> you can follow in VS Code if you prefer checkboxes over this screen.</p>
      </section>

      <section class="deck-slide" data-title="Run it locally" data-notes="File → Open Folder on my-resume-site. Trust authors. Terminal → New Terminal. Wait for localhost before moving on.">
        <div class="slide-num">07</div>
        <h2 class="say">Open the folder in VS Code and run it.</h2>
        <pre class="big-code"><code>npm install
npm run dev</code></pre>
        <p class="talk">Click the <code>localhost</code> link in the terminal. You should see a sample resume. Leave that terminal running.</p>
      </section>

      <section class="deck-slide" data-title="The content file" data-notes="Demo Explorer live. Photo goes in public/. Empty [] sections stay hidden. Do not open Source Control yet.">
        <div class="slide-num">08</div>
        <h2 class="say">Almost everything you edit is one file.</h2>
        <p class="path-line"><code>src</code> <span>→</span> <code>data</code> <span>→</span> <strong>profile.js</strong></p>
        <p class="talk">Name, about, coursework, projects, links. Optional photo: drop <code>photo.jpg</code> in <code>public/</code>. Leave lists you don’t need as <code>[]</code>.</p>
      </section>

      <section class="deck-slide statement" data-title="Save isn’t publish" data-notes="Cold-call: if you save in VS Code, does the live site update? Wait for no. Come back to this whenever someone is confused.">
        <div class="slide-num">09</div>
        <h2 class="say">Saving a file does not put it on the internet.</h2>
        <p class="pipeline">save <em>→</em> commit <em>→</em> push / PR <em>→</em> deploy</p>
        <p class="talk">We’ll hit each of those on purpose. Don’t skip ahead.</p>
      </section>

      <section class="deck-slide" data-title="First push" data-notes="Second terminal if npm run dev is running. Warn: Actions often red-X until Pages is enabled later — expected. Auth = browser or PAT, never GitHub password.">
        <div class="slide-num">10</div>
        <h2 class="say">Push the starter to your empty repo.</h2>
        <pre class="big-code"><code>git init
git add .
git commit -m "Create my portfolio"
git branch -M main
git remote add origin https://github.com/YOUR-USERNAME/YOUR-REPOSITORY.git
git push -u origin main</code></pre>
        <p class="aside">If <strong>Actions</strong> shows a red X after this: that’s normal for now. We turn Pages on later and re-run.</p>
      </section>

      <section class="deck-slide statement" data-title="When stuck" data-notes="Have everyone type git status once so they see it. Rule for the rest of the day.">
        <div class="slide-num">11</div>
        <h2 class="say">When something looks wrong, run <code>git status</code> first.</h2>
        <p class="talk">Then <code>git diff</code> if you need to see what you edited. Guessing burns time.</p>
      </section>

      <section class="deck-slide" data-title="Personalize" data-notes="Stress: do NOT commit on main. Source Control badge is fine — leave it. Replace example.com placeholders.">
        <div class="slide-num">12</div>
        <h2 class="say">Build out your resume in <code>profile.js</code>.</h2>
        <p class="talk">Replace the sample person with you. Fill what you have — coursework, activities, projects, experience if any. Replace every <code>example.com</code> link. Save and check localhost. Don’t Commit yet; next we ship a chunk of this work through a pull request.</p>
      </section>

      <section class="deck-slide" data-title="Issue first" data-notes="Partner check: could a stranger verify done? Keep criteria short.">
        <div class="slide-num">13</div>
        <h2 class="say">Pick one piece of that resume work for a pull request.</h2>
        <p class="talk">Example: featured project card. GitHub → Issues → New. Write how you’ll know it’s done — honest summary, working link, readable on a phone, no secrets. The rest of your personalization can ride in the same commit.</p>
      </section>

      <section class="deck-slide" data-title="Branch" data-notes="Status Bar bottom-left. Uncommitted edits ride along onto the new branch. Don’t continue until the name shows.">
        <div class="slide-num">14</div>
        <h2 class="say">Status Bar: click <code class="hl">main</code>, then create a branch.</h2>
        <p class="talk">Name it <code>add-featured-project</code>. The Status Bar should show that name before you commit anything.</p>
      </section>

      <section class="deck-slide" data-title="Commit and publish" data-notes="Demo Source Control: open diff, stage +, message, Commit, Publish Branch. Roast the message “updates” if it comes up.">
        <div class="slide-num">15</div>
        <h2 class="say">Now commit — on that branch.</h2>
        <p class="talk">Source Control → read the diff → Stage (+) → write a real message → Commit → <strong>Publish Branch</strong>.</p>
        <p class="aside">“updates” is not a message. “Add featured project card” is.</p>
      </section>

      <section class="deck-slide" data-title="Pull request" data-notes="Two attach methods: Closes #N in body (auto-closes) and PR sidebar Development → Link an issue. Verify both sides. Do not merge yet — next slide is partner +1.">
        <div class="slide-num">16</div>
        <h2 class="say">Open the PR. Attach it to your issue.</h2>
        <p class="talk">Issue = task. PR = fix. <strong>Two ways:</strong> (1) put <code>Closes #1</code> on its own line in the PR body — closes the issue on merge. (2) PR sidebar → <strong>Development → Link an issue</strong> → pick yours. Confirm the link on the issue page, then <strong>Files changed</strong>. <strong>Don’t merge yet.</strong></p>
      </section>

      <section class="deck-slide" data-title="Partner +1" data-notes="Require a neighbor Approve/Comment before merge. Facilitator can +1 for solos. Odd count → trios.">
        <div class="slide-num">17</div>
        <h2 class="say">Hand your PR to the person beside you for a +1.</h2>
        <p class="talk">They open <strong>Files changed</strong>, skim the diff, then <strong>Review changes → Approve</strong> (or Comment with <code>+1</code>). You do the same on theirs. Merge only after you have a partner review.</p>
      </section>

      <section class="deck-slide" data-title="Actions" data-notes="Open deploy.yml in Explorer. Do not write YAML. Feature branch does not publish — only main.">
        <div class="slide-num">18</div>
        <h2 class="say">Your ZIP already includes a GitHub Actions workflow.</h2>
        <p class="path-line"><code>.github</code> <span>→</span> <code>workflows</code> <span>→</span> <strong>deploy.yml</strong></p>
        <p class="talk">On a push to <code>main</code> it installs, builds, and deploys. You’re not writing YAML today — you’re watching it run. Feature branches don’t publish.</p>
      </section>

      <section class="deck-slide" data-title="Pages" data-notes="Source = GitHub Actions. Re-run all jobs on the failed run. Then open the real URL.">
        <div class="slide-num">19</div>
        <h2 class="say">Turn Pages on, then re-run the failed job.</h2>
        <p class="talk">Settings → Pages → Source: <strong>GitHub Actions</strong>. Actions tab → open the run → <strong>Re-run all jobs</strong> if it failed earlier. When it’s green, open the URL and poke it on your phone.</p>
      </section>

      <section class="deck-slide" data-title="Lab" data-notes="Leave this up. Goal is a real-looking resume + live URL. PR + partner +1 required. Circulate for profile content and Status Bar branch name.">
        <div class="slide-num">20</div>
        <h2 class="say">Lab: finish your resume content, then ship it.</h2>
        <p class="talk">Keep filling <code>profile.js</code>. Use the issue → branch → PR → partner +1 path for the featured project. Then Pages → live URL. Stuck? Show the error and your Status Bar branch name.</p>
      </section>

      <section class="deck-slide statement" data-title="Show your work" data-notes="Exit ticket: live URL + who gave their +1. Site should look like them, not Jordan Lee.">
        <div class="slide-num">21</div>
        <h2 class="say">Show a partner your live resume — and the PR that got it there.</h2>
        <p class="talk">If the site still looks like Jordan Lee, you’re not done yet.</p>
      </section>

    </div>

    <div class="deck-notes no-print" id="deck-notes" hidden>
      <div class="notes-label"><span>FACILITATOR NOTES</span><button class="deck-tool" data-toggle="notes">Hide notes ×</button></div>
      <p id="notes-content">Welcome students.</p>
    </div>

    <footer class="deck-controls no-print">
      <div class="deck-controls-left">
        <button id="prev-slide" class="control-btn" aria-label="Previous slide">←</button>
        <button id="next-slide" class="control-btn primary-control" aria-label="Next slide">→</button>
        <span id="slide-title" class="deck-current-title">Cover</span>
      </div>
      <div class="slide-progress">
        <span id="slide-index">01</span>
        <div class="progress-track"><i id="progress-fill"></i></div>
        <span id="slide-total">21</span>
      </div>
      <div class="deck-controls-right">
        <span class="key-hint"><kbd>←</kbd><kbd>→</kbd></span>
        <button class="deck-tool" data-toggle="resources">Resources <kbd>R</kbd></button>
        <button class="deck-tool" data-fullscreen>Full screen <kbd>F</kbd></button>
      </div>
    </footer>

    <dialog id="resource-dialog" class="resource-dialog">
      <div class="resource-dialog-head">
        <div><div class="eyebrow">WORKSHOP LINKS</div><h2>Resources</h2></div>
        <button class="control-btn" data-close-resources aria-label="Close">×</button>
      </div>
      <div class="resource-drawer-grid">
        <section>
          <h3>Students</h3>
          <a href={base + 'student-guide/'} target="_blank" rel="noreferrer"><b>Walkthrough</b><small>Click-by-click steps</small></a>
          <a href={base + 'downloads/portfolio-starter.zip'} target="_blank" rel="noreferrer"><b>Starter ZIP</b><small>Includes WORKSHOP.md</small></a>
          <a href={base + 'designs/'} target="_blank" rel="noreferrer"><b>Portfolio lab</b><small>Live preview</small></a>
        </section>
        <section>
          <h3>Facilitator</h3>
          <a href={base + 'presenter/'} target="_blank" rel="noreferrer"><b>Presenter desk</b><small>Agenda + notes</small></a>
          <a href={base + 'workshop/'} target="_blank" rel="noreferrer"><b>Agenda</b><small>Timing</small></a>
          <a href={base + 'downloads/workshop-1-presentation.pptx'} target="_blank" rel="noreferrer"><b>PowerPoint</b><small>Offline export</small></a>
        </section>
        <section>
          <h3>Examples</h3>
          <a href="https://skyeshanohan.github.io/workshop1-demo-portfolio/" target="_blank" rel="noreferrer"><b>Catch-up demo</b><small>Live site</small></a>
          <a href="https://tyler-beach.github.io/example-my-resume-site/" target="_blank" rel="noreferrer"><b>Example resume</b><small>Filled-out site</small></a>
        </section>
      </div>
      <div class="resource-dialog-foot">
        <span>Press <kbd>R</kbd> to close</span>
        <button class="btn primary" data-close-resources>Back to deck</button>
      </div>
    </dialog>
  </div>
</div>

<style>
.presentation-page{padding-top:18px;padding-bottom:28px}
.presentation-intro{display:flex;align-items:center;justify-content:space-between;gap:22px;padding:16px 0 18px}
.presentation-intro h1{font:700 clamp(30px,4vw,46px)/1.05 'Titillium Web',sans-serif;letter-spacing:-.035em;margin:8px 0}
.presentation-intro p{margin:0;color:var(--muted);font-size:14px;line-height:1.5;max-width:700px}
.presentation-root{--wsu-yellow:#FFDB00;position:relative;background:#050505;color:#fff;border:1px solid #292929;border-radius:8px;overflow:hidden;box-shadow:0 18px 54px #0002}
.deck-topbar{height:54px;background:#101010;border-bottom:1px solid #303030;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 18px}
.deck-brand{display:flex;align-items:center;gap:10px;text-decoration:none;font:700 11px 'Titillium Web',sans-serif;letter-spacing:.08em;flex-shrink:0}
.deck-mark{width:28px;height:28px;background:#FFDB00;color:#000;display:grid;place-items:center;font-size:16px;font-weight:700}
.deck-brand small{display:block;font:10px 'Roboto',sans-serif;letter-spacing:.11em;color:#bdbdbd;margin-top:3px}
.deck-tools,.deck-controls-left,.deck-controls-right{display:flex;align-items:center;gap:8px}
.deck-tool{display:inline-flex;align-items:center;gap:7px;background:transparent;border:1px solid #444;color:#ededed;border-radius:5px;padding:7px 9px;cursor:pointer;font:500 11px 'Roboto',sans-serif}
.deck-tool:hover{border-color:#FFDB00;color:#FFDB00}
.deck-tool kbd,.key-hint kbd,.resource-dialog-foot kbd{background:#2b2b2b;border:1px solid #575757;color:#fff;border-radius:3px;padding:2px 5px;font:10px 'Roboto',sans-serif}
.deck-stage{position:relative}
.deck-slide{aspect-ratio:16/9;min-height:520px;max-height:calc(100vh - 195px);overflow:hidden;background:#fff;color:#131313;position:relative;padding:clamp(36px,4.5vw,64px) clamp(40px,5.5vw,80px) 48px;display:flex;flex-direction:column;gap:clamp(16px,2vw,24px);font-family:'Roboto',Arial,sans-serif;justify-content:center}
.deck-slide[hidden],.deck-slide:not(.is-active){display:none!important}
.deck-slide code{font:.92em/inherit 'DM Mono',ui-monospace,monospace;background:#f0f0ec;border:0;border-radius:3px;padding:0 .28em;vertical-align:baseline}
.deck-slide .talk code,.deck-slide .aside code{box-decoration-break:clone;-webkit-box-decoration-break:clone}

.slide-num{position:absolute;top:clamp(24px,3vw,40px);right:clamp(40px,5.5vw,80px);font:700 13px 'Titillium Web',sans-serif;letter-spacing:.08em;color:#999}

.say{font:700 clamp(32px,4.4vw,54px)/1.22 'Titillium Web',sans-serif;letter-spacing:-.035em;margin:0;color:#080808;max-width:20ch}
/* Highlight without a bordered box that collides with the line above */
.say code,.say code.hl{font:inherit;font-weight:700;letter-spacing:inherit;color:inherit;background:transparent;border:0;border-radius:0;padding:0 .06em;box-shadow:inset 0 -.28em 0 #FFDB00;vertical-align:baseline}
.talk{margin:0;font:400 clamp(17px,1.7vw,22px)/1.5 'Roboto',sans-serif;color:#333;max-width:38rem}
.aside{margin:0;font:400 15px/1.45 'Roboto',sans-serif;color:#666;max-width:36rem;padding-top:4px;border-top:1px solid #e8e8e4}
.cta-link{margin:4px 0 0}
.cta-link a{font:700 20px 'Titillium Web',sans-serif;color:#111;text-underline-offset:4px}

.path-line{margin:4px 0;font:700 clamp(22px,2.6vw,34px)/1.35 'Titillium Web',sans-serif;color:#111}
.path-line span{color:#bbb;font-weight:400;margin:0 .15em}
.path-line code{font:inherit;font-weight:700;background:transparent;border:0;padding:0;color:#111}
.path-line strong{background:#FFDB00;padding:0 .18em;border-radius:2px;box-decoration-break:clone;-webkit-box-decoration-break:clone}

.about-kicker{margin:0;font:700 12px 'Titillium Web',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#666}
.about-list{margin:0;padding:0;list-style:none;display:grid;gap:12px;max-width:40rem}
.about-list li{font:400 clamp(17px,1.7vw,22px)/1.45 'Roboto',sans-serif;color:#333;padding-left:14px;border-left:3px solid #FFDB00}
.about-list strong{font-weight:700;color:#111}
.deck-slide.about-slide .say{max-width:22ch}
.about-photo-slide{justify-content:center}
.about-hero{container-type:inline-size;display:grid;grid-template-columns:auto minmax(0,1fr);gap:clamp(16px,3cqi,40px);align-items:center;width:100%;max-width:58rem}
.about-photo{display:block;width:min(280px,32cqi);height:auto;aspect-ratio:1/1;object-fit:cover;object-position:center top;align-self:center;border-radius:6px;border:3px solid #111;box-shadow:8px 8px 0 #FFDB00}
.about-hero-copy{display:grid;gap:clamp(8px,1.8cqi,16px);min-width:0}
.about-hero-copy .say{max-width:none;font-size:clamp(26px,6.2cqi,52px);line-height:1.15}
.about-hero-copy .talk{max-width:36rem;font-size:clamp(15px,2.6cqi,22px)}
.about-chips{margin:2px 0 0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:8px}
.about-chips li{font:600 11px/1.2 'Titillium Web',sans-serif;letter-spacing:.04em;text-transform:uppercase;color:#111;background:#FFDB00;padding:7px 10px;border-radius:2px}
@container (max-width:520px){
  .about-hero{grid-template-columns:120px minmax(0,1fr);gap:14px}
  .about-photo{box-shadow:5px 5px 0 #FFDB00;border-width:2px}
}

.pipeline{margin:8px 0 0;font:700 clamp(20px,2.4vw,32px)/1.3 'Titillium Web',sans-serif;color:#111;letter-spacing:-.02em}
.pipeline em{font-style:normal;color:#aaa;margin:0 .35em}

.big-code{margin:4px 0;background:#111;color:#f4f4f0;border-left:4px solid #FFDB00;padding:18px 22px;font:clamp(13px,1.25vw,17px)/1.7 'DM Mono',ui-monospace,monospace;max-width:52rem}
.big-code code{background:none;border:0;color:inherit;padding:0;font:inherit}

.deck-slide.statement{justify-content:center}
.deck-slide.statement .say{max-width:22ch}

.cover-slide{background:#090909;color:#fff;justify-content:center}
.cover-slide .slide-num{color:#555}
.cover-body{max-width:920px}
.cover-kicker{margin:0 0 18px;font:600 13px 'Roboto',sans-serif;letter-spacing:.04em;color:#aaa}
.cover-body h2{font:700 clamp(40px,5.5vw,68px)/1.02 'Titillium Web',sans-serif;letter-spacing:-.04em;margin:0 0 18px;color:#fff;max-width:14ch}
.cover-line{margin:0;font:400 20px/1.45 'Roboto',sans-serif;color:#cfcfcf;max-width:34rem}

.deck-controls{min-height:58px;background:#101010;border-top:1px solid #303030;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:0 14px}
.control-btn{appearance:none;border:1px solid #555;background:#1a1a1a;color:#fff;width:40px;height:36px;border-radius:4px;cursor:pointer;font-size:16px}
.control-btn:hover{border-color:#FFDB00;color:#FFDB00}
.control-btn:disabled{opacity:.35;cursor:default}
.primary-control{background:#FFDB00;border-color:#FFDB00;color:#000}
.deck-current-title{font:600 13px 'Roboto',sans-serif;color:#ddd;max-width:340px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.slide-progress{display:flex;align-items:center;gap:10px;font:700 11px 'Titillium Web',sans-serif;color:#aaa}
.progress-track{width:120px;height:4px;background:#333;border-radius:99px;overflow:hidden}
.progress-track i{display:block;height:100%;width:0;background:#FFDB00}
.deck-notes{border-top:1px solid #303030;background:#161616;padding:12px 18px 16px}
.notes-label{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font:700 10px 'Titillium Web',sans-serif;letter-spacing:.12em;color:#FFDB00}
#notes-content{margin:0;font:14px/1.5 'Roboto',sans-serif;color:#ddd}

.resource-dialog{border:0;padding:0;width:min(920px,92vw);background:#111;color:#fff;border-radius:8px}
.resource-dialog::backdrop{background:#000a}
.resource-dialog-head{display:flex;justify-content:space-between;gap:16px;padding:20px 22px 12px;border-bottom:1px solid #333}
.resource-dialog-head h2{margin:6px 0 0;font:700 28px 'Titillium Web',sans-serif}
.resource-drawer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding:18px 22px}
.resource-drawer-grid h3{font:700 12px 'Titillium Web',sans-serif;letter-spacing:.1em;color:#FFDB00;margin:0 0 10px}
.resource-drawer-grid a{display:block;text-decoration:none;color:#fff;padding:10px 0;border-top:1px solid #333}
.resource-drawer-grid b{display:block;font:700 15px 'Titillium Web',sans-serif}
.resource-drawer-grid small{color:#aaa;font-size:12px}
.resource-dialog-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 22px 18px;border-top:1px solid #333;color:#aaa;font-size:13px}

.presentation-root:fullscreen{width:100%;height:100%;border-radius:0;display:flex;flex-direction:column}
.presentation-root:fullscreen .deck-stage{flex:1;min-height:0}
.presentation-root:fullscreen .deck-slide{width:100%;height:100%;max-height:none;min-height:0;aspect-ratio:auto}

@media(max-width:900px){
  .resource-drawer-grid{grid-template-columns:1fr}
  .deck-current-title{display:none}
  .deck-slide{aspect-ratio:auto;min-height:560px;max-height:none;overflow:auto}
}
@media print{
  body *{visibility:hidden!important}
  .presentation-root,.presentation-root *{visibility:visible!important}
  .presentation-intro,.deck-topbar,.deck-controls,.deck-notes,.resource-dialog{display:none!important}
  .deck-slide{display:flex!important;aspect-ratio:16/9;break-after:page;page-break-after:always}
  .deck-slide[hidden],.deck-slide:not(.is-active){display:flex!important}
}
</style>

<script>
const root=document.querySelector('#presentation-root');
const slides=[...root.querySelectorAll('.deck-slide')];
let index=0;
const prev=document.querySelector('#prev-slide'), next=document.querySelector('#next-slide');
const notes=document.querySelector('#deck-notes'), notesContent=document.querySelector('#notes-content');
const title=document.querySelector('#slide-title'), idx=document.querySelector('#slide-index'), fill=document.querySelector('#progress-fill');
const total=document.querySelector('#slide-total');
total.textContent=String(slides.length).padStart(2,'0');
const resourceDialog=document.querySelector('#resource-dialog');
function render(){
  slides.forEach((s,i)=>{const active=i===index;s.hidden=!active;s.classList.toggle('is-active',active);if(active)s.setAttribute('aria-current','step');else s.removeAttribute('aria-current')});
  const s=slides[index];
  title.textContent=s.dataset.title||'Workshop 1';
  idx.textContent=String(index+1).padStart(2,'0');
  fill.style.width=((index+1)/slides.length*100)+'%';
  prev.disabled=index===0; next.disabled=index===slides.length-1;
  notesContent.textContent=s.dataset.notes||'';
  if(root.matches(':fullscreen')) document.title=(index+1)+' / '+slides.length+' · '+(s.dataset.title||'Workshop 1');
  else document.title='Full-screen Workshop 1 presentation · MIS Club';
}
function change(n){index=Math.max(0,Math.min(slides.length-1,n));render()}
function toggleFullscreen(){if(!document.fullscreenElement){root.requestFullscreen?.().catch(()=>{});}else{document.exitFullscreen?.();}}
function toggleResources(){if(resourceDialog.open)resourceDialog.close();else resourceDialog.showModal();}
function toggleNotes(){notes.hidden=!notes.hidden; if(!notes.hidden)notesContent.textContent=slides[index].dataset.notes||'';}
prev.addEventListener('click',()=>change(index-1));next.addEventListener('click',()=>change(index+1));
document.querySelectorAll('[data-fullscreen]').forEach(b=>b.addEventListener('click',toggleFullscreen));
document.querySelectorAll('[data-toggle="resources"]').forEach(b=>b.addEventListener('click',toggleResources));
document.querySelectorAll('[data-toggle="notes"]').forEach(b=>b.addEventListener('click',toggleNotes));
document.querySelectorAll('[data-close-resources]').forEach(b=>b.addEventListener('click',()=>resourceDialog.close()));
resourceDialog.addEventListener('click',e=>{if(e.target===resourceDialog)resourceDialog.close()});
document.addEventListener('fullscreenchange',()=>{const on=!!document.fullscreenElement;document.querySelectorAll('[data-fullscreen]').forEach(b=>{b.innerHTML=on?'Exit full screen <kbd>F</kbd>':'Full screen <kbd>F</kbd>'});render()});
document.addEventListener('keydown',e=>{
 if(resourceDialog.open){if(e.key==='Escape')resourceDialog.close();return}
 if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName))return;
 if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '){e.preventDefault();change(index+1)}
 else if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();change(index-1)}
 else if(e.key==='Home'){e.preventDefault();change(0)}
 else if(e.key==='End'){e.preventDefault();change(slides.length-1)}
 else if(e.key.toLowerCase()==='f'){e.preventDefault();toggleFullscreen()}
 else if(e.key.toLowerCase()==='r'){e.preventDefault();toggleResources()}
 else if(e.key.toLowerCase()==='n'){e.preventDefault();toggleNotes()}
});
render();
</script>
</BaseLayout>
