</style>
<script>
const root=document.querySelector('#presentation-root');
const slides=[...root.querySelectorAll('.deck-slide')];
let index=0;
const prev=document.querySelector('#prev-slide'), next=document.querySelector('#next-slide');
const notes=document.querySelector('#deck-notes'), notesContent=document.querySelector('#notes-content');
const title=document.querySelector('#slide-title'), idx=document.querySelector('#slide-index'), fill=document.querySelector('#progress-fill');
const resourceDialog=document.querySelector('#resource-dialog');
function render(){
  slides.forEach((s,i)=>{s.hidden=i!==index; if(i===index)s.setAttribute('aria-current','step'); else s.removeAttribute('aria-current')});
  const s=slides[index];
  title.textContent=s.dataset.title||'Workshop 1';
  idx.textContent=String(index+1).padStart(2,'0');
  fill.style.width=((index+1)/slides.length*100)+'%';
  prev.disabled=index===0; next.disabled=index===slides.length-1;
  notesContent.textContent=s.dataset.notes||'';
  if(root.matches(':fullscreen')) document.title=(index+1)+' / '+slides.length+' · '+(s.dataset.title||'Workshop 1');
  else document.title='Full-screen Workshop 1 presentation · MIS Club';
}
function change(n){index=Math.max(0,Math.min(slides.length-1,n));render()}
function toggleFullscreen(){if(!document.fullscreenElement){root.requestFullscreen?.().catch(()=>{});}else{document.exitFullscreen?.();}}
function toggleResources(){if(resourceDialog.open)resourceDialog.close();else resourceDialog.showModal();}
function toggleNotes(){notes.hidden=!notes.hidden; if(!notes.hidden)notesContent.textContent=slides[index].dataset.notes||'';}
prev.addEventListener('click',()=>change(index-1));next.addEventListener('click',()=>change(index+1));
document.querySelectorAll('[data-fullscreen]').forEach(b=>b.addEventListener('click',toggleFullscreen));
document.querySelectorAll('[data-toggle="resources"]').forEach(b=>b.addEventListener('click',toggleResources));
document.querySelectorAll('[data-toggle="notes"]').forEach(b=>b.addEventListener('click',toggleNotes));
document.querySelectorAll('[data-close-resources]').forEach(b=>b.addEventListener('click',()=>resourceDialog.close()));
resourceDialog.addEventListener('click',e=>{if(e.target===resourceDialog)resourceDialog.close()});
document.querySelector('#print').addEventListener('click',()=>window.print());
document.addEventListener('fullscreenchange',()=>{const on=!!document.fullscreenElement;document.querySelectorAll('[data-fullscreen]').forEach(b=>{b.innerHTML=on?'⛶ Exit full screen <kbd>F</kbd>':'⛶ Full screen <kbd>F</kbd>'});render()});
document.addEventListener('keydown',e=>{
 if(resourceDialog.open){if(e.key==='Escape')resourceDialog.close();return}
 if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName))return;
 if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '){e.preventDefault();change(index+1)}
 else if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();change(index-1)}
 else if(e.key==='Home'){e.preventDefault();change(0)}
 else if(e.key==='End'){e.preventDefault();change(slides.length-1)}
 else if(e.key.toLowerCase()==='f'){e.preventDefault();toggleFullscreen()}
 else if(e.key.toLowerCase()==='r'){e.preventDefault();toggleResources()}
 else if(e.key.toLowerCase()==='n'){e.preventDefault();toggleNotes()}
});
render();
</script>
</BaseLayout>