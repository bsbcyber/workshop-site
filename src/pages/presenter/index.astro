---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Presenter desk" description="Presenter tools, agenda, preparation checks, and troubleshooting for Workshop 1.">
<div class="container">
  <section class="page-hero"><div class="eyebrow">PRESENTER TOOLS / SESSION PLAN</div><h1>Presenter workspace</h1><p>Use this page to keep time, review the agenda, check setup, and find instructions for common issues.</p></section>
  <section class="grid two">
    <article class="card"><div class="eyebrow">Session timer</div><h2 id="timer">180:00</h2><p class="muted">A simple pacing aid. Start it when the workshop begins.</p><div class="actions"><button class="btn primary" id="timer-start">Start</button><button class="btn" id="timer-pause">Pause</button><button class="btn" id="timer-reset">Reset</button></div></article>
    <article class="card"><div class="eyebrow">Workshop goal</div><h2>The goal is a working portfolio, not a finished product.</h2><p>By the end, every student should own a repository, have made a reviewable change, and have a live URL or a documented recovery path.</p><a class="btn" href={import.meta.env.BASE_URL+'slides/'}>Open slides ↗</a></article>
  </section>
  <section class="section presenter-grid">
    <nav class="side-nav" aria-label="Presenter sections"><a href="#prep">Before the session</a><a href="#screens">Product screenshots</a><a href="#runofshow">Agenda and notes</a><a href="#prompts">Copilot prompts</a><a href="#recovery">Catch-up plan</a><a href="#troubleshoot">Troubleshooting</a><a href="#exit">Before students leave</a></nav>
    <div class="content-stack">
      <article class="card" id="prep"><div class="prep-heading"><h2>Before the session</h2><button class="btn small" id="reset-prep" type="button">Reset checks</button></div><p class="muted small">Checks stay in this browser, so you can reuse this page before another session.</p><div class="checklist">
        <label class="check-row"><input type="checkbox" data-prep-check="prep-url"/><span>Test the workshop URL and presenter slides on the classroom network.</span></label>
        <label class="check-row"><input type="checkbox" data-prep-check="prep-repo"/><span>Verify the starter repo is public or students have access.</span></label>
        <label class="check-row"><input type="checkbox" data-prep-check="prep-pages"/><span>Test GitHub Pages deployment from a fresh clone.</span></label>
        <label class="check-row"><input type="checkbox" data-prep-check="prep-copilot"/><span>Confirm students can access Copilot via their student licenses.</span></label>
        <label class="check-row"><input type="checkbox" data-prep-check="prep-checkpoints"/><span>Prepare repository-ready and site-ready checkpoint copies.</span></label>
        <label class="check-row"><input type="checkbox" data-prep-check="prep-fallback"/><span>Have a fallback path for missing installs or account access.</span></label>
      </div></article>
      <article class="card" id="screens"><div class="screens-heading"><div><div class="eyebrow">Official product screenshots</div><h2>Screens to show during class</h2><p>These are real interface screenshots from the product documentation. Use them to orient students, then show the current UI in your own repository or editor.</p></div></div>
        <div class="screen-gallery">
          <figure class="reference-screen"><div class="screen-ref-title"><b>VS CODE / SOURCE CONTROL</b><a href="https://code.visualstudio.com/docs/sourcecontrol/overview" target="_blank" rel="noreferrer">Source ↗</a></div><img src="https://code.visualstudio.com/assets/docs/sourcecontrol/overview/overview.png" alt="Official screenshot of VS Code Source Control and a side-by-side file diff." loading="lazy"/><figcaption>Changed files, staging, and line-by-line review.</figcaption></figure>
          <figure class="reference-screen"><div class="screen-ref-title"><b>GITHUB / ISSUE</b><a href="https://docs.github.com/en/issues/tracking-your-work-with-issues/using-issues/creating-an-issue" target="_blank" rel="noreferrer">Source ↗</a></div><img src="https://docs.github.com/assets/images/help/issues/issue-title-body.png" alt="Official screenshot of GitHub's issue title and body form." loading="lazy"/><figcaption>Write a goal and observable acceptance criteria.</figcaption></figure>
          <figure class="reference-screen"><div class="screen-ref-title"><b>GITHUB / PULL REQUEST</b><a href="https://docs.github.com/en/pull-requests/how-tos/review-pull-requests/reviewing-proposed-changes-in-a-pull-request" target="_blank" rel="noreferrer">Source ↗</a></div><img src="https://docs.github.com/assets/images/help/pull_requests/diff-settings-menu.png" alt="Official screenshot of the GitHub pull request Files changed diff menu." loading="lazy"/><figcaption>Open Files changed and inspect the actual diff.</figcaption></figure>
          <figure class="reference-screen"><div class="screen-ref-title"><b>GITHUB ACTIONS / LOG</b><a href="https://docs.github.com/en/actions/how-tos/monitor-workflows/use-workflow-run-logs" target="_blank" rel="noreferrer">Source ↗</a></div><img src="https://docs.github.com/assets/images/help/repository/actions-quickstart-log-detail.png" alt="Official screenshot of a GitHub Actions job log step expanded to show output." loading="lazy"/><figcaption>Expand the failed step and read the first useful error.</figcaption></figure>
          <figure class="reference-screen"><div class="screen-ref-title"><b>VS CODE / COPILOT CHAT</b><a href="https://code.visualstudio.com/docs/chat/copilot-chat-context" target="_blank" rel="noreferrer">Source ↗</a></div><img src="https://code.visualstudio.com/assets/docs/chat/copilot-chat/copilot-chat-view-chat-variables.png" alt="Official screenshot of VS Code Copilot Chat showing workspace context suggestions." loading="lazy"/><figcaption>Add file context, ask one focused question, and inspect proposed edits.</figcaption></figure>
          <figure class="reference-screen"><div class="screen-ref-title"><b>GITHUB PAGES / LIVE URL</b><a href="https://docs.github.com/en/pages/getting-started-with-github-pages/configuring-a-publishing-source-for-your-github-pages-site" target="_blank" rel="noreferrer">Source ↗</a></div><img src="https://docs.github.com/assets/images/help/pages/click-pages-url-to-preview.png" alt="Official screenshot of GitHub Pages settings showing the published site link." loading="lazy"/><figcaption>Open the actual published site only after the latest workflow succeeds.</figcaption></figure>
        </div>
      </article>
      <article class="card" id="runofshow"><h2>Agenda and teaching notes</h2>
        <h3>0:00–0:25 · orient and unblock</h3><p>Show a finished portfolio first. Keep environment setup time-boxed: if a student is blocked after the setup segment, pair them with a working machine or checkpoint so learning can continue.</p>
        <h3>0:25–1:05 · repository and VS Code</h3><p>Explain Git vs GitHub with a diagram. Let students choose one layout, create their own repository, and find the Source Control panel. Avoid deep Git internals.</p>
        <h3>1:05–1:35 · personalize and preview</h3><p>Demonstrate a short Copilot request, then inspect the diff. Ask students to add resume sections and preview the site locally. Remind them that public pages expose whatever they publish.</p>
        <h3>1:45–2:15 · requirement through pull request</h3><p>Have each student create one issue with acceptance criteria. Their implementation should be small enough to review. Require them to explain the diff before merging.</p>
        <h3>2:15–2:45 · deploy and validate</h3><p>Show where the Pages deployment workflow runs. Explain that a successful local preview doesn't prove the deployed path works. Check Actions logs and the actual published URL.</p>
        <h3>2:45–3:00 · recovery and close</h3><p>Protect the final 15 minutes. Students who are behind use checkpoints; those finished polish accessibility or content. Capture live URLs and one takeaway.</p>
      </article>
      <article class="card" id="prompts"><h2>Copilot prompt bank</h2>
        <div class="prompt"><h3>Explain before editing</h3><pre>Explain the files, how this Astro project renders the page, and where content and styling are defined. Don't edit files yet. Give me a short map of the project.</pre><button class="btn small copy-prompt">Copy prompt</button></div>
        <div class="prompt"><h3>Implement a focused requirement</h3><pre>Requirement: add a featured project card titled [PROJECT]. Acceptance criteria: title, short summary, relevant skills, and a working link; responsive on mobile; no new dependencies. Propose a plan before editing, then show me the changed files.</pre><button class="btn small copy-prompt">Copy prompt</button></div>
        <div class="prompt"><h3>Review generated changes</h3><pre>Review the diff against these acceptance criteria: [CRITERIA]. Look for broken links, accessibility issues, responsive layout regressions, hard-coded secrets, and unnecessary complexity. Report findings before changing anything.</pre><button class="btn small copy-prompt">Copy prompt</button></div>
      </article>
      <article class="card" id="recovery"><h2>If someone falls behind</h2>
        <ol><li>Ask what already works; do not restart the entire setup.</li><li>Give the student the current checkpoint repository or completed example.</li><li>Have them create their own repository and personalize at least one item.</li><li>Rejoin the shared exercise at the next milestone.</li><li>Record what they skipped and share the page for self-paced review.</li></ol>
        <div class="notice">For a student arriving halfway through, prioritize the repository, one reviewed change, and deployment. Use pre-built checkpoints to preserve the learning objectives without requiring every earlier step.</div>
      </article>
      <article class="card" id="troubleshoot"><h2>Troubleshooting quick guide</h2>
        <h3>GitHub sign-in fails</h3><p>Verify browser sign-in and VS Code authentication separately. Check that the student is using the intended GitHub account and has access to the repository.</p>
        <h3>Copilot isn't available</h3><p>Check the account shown in VS Code, license activation, and the Copilot extension status. Have the student follow the exercise instructions without AI while the access issue is resolved.</p>
        <h3>Local site runs but Pages is broken</h3><p>Inspect the latest Actions run, check the configured Pages source, and confirm the site's base path matches the repository name.</p>
        <h3>Student gets a merge conflict</h3><p>Have them pause and read the conflict markers. Explain the two competing versions before accepting either one; use the checkpoint branch if time is short.</p>
      </article>
      <article class="card" id="official-links"><h2>Official references · presenter use</h2><p>Use these for deeper explanation or troubleshooting. The student walkthrough itself stays self-contained and uses the course's custom examples.</p><div class="resource-list"><div class="resource"><div><h3>Git basics</h3><p>Pro Git — version control concepts and workflows.</p></div><a href="https://git-scm.com/book/en/v2/Getting-Started-About-Version-Control" target="_blank" rel="noreferrer">Open ↗</a></div><div class="resource"><div><h3>GitHub collaboration</h3><p>Repositories, branches, commits, and pull requests.</p></div><a href="https://docs.github.com/en/get-started/start-your-journey/hello-world" target="_blank" rel="noreferrer">Open ↗</a></div><div class="resource"><div><h3>VS Code Source Control</h3><p>Stage changes, commit, and inspect diffs.</p></div><a href="https://code.visualstudio.com/docs/sourcecontrol/overview" target="_blank" rel="noreferrer">Open ↗</a></div><div class="resource"><div><h3>Copilot in VS Code</h3><p>Chat and AI-assisted code changes.</p></div><a href="https://code.visualstudio.com/docs/copilot/overview" target="_blank" rel="noreferrer">Open ↗</a></div><div class="resource"><div><h3>Astro on GitHub Pages</h3><p>Official deployment guidance.</p></div><a href="https://docs.astro.build/en/guides/deploy/github/" target="_blank" rel="noreferrer">Open ↗</a></div><div class="resource"><div><h3>Wichita State color and font standards</h3><p>Official primary palette and web typography.</p></div><a href="https://www.wichita.edu/services/strategic_communications/brand_standards/colors_and_fonts.php" target="_blank" rel="noreferrer">Open ↗</a></div></div></article>
      <article class="card" id="exit"><h2>Before students leave</h2><ul><li>Repository URL works and contains the student's project.</li><li>At least one issue / branch / pull request flow was completed or demonstrated with a checkpoint.</li><li>Live site URL is recorded, or the exact deployment blocker is known.</li><li>Student can state one Git concept and one Copilot change they reviewed.</li></ul><p class="muted small">Keep public portfolio content professional. Students should not publish private contact details, credentials, or information about other people without permission.</p></article>
    </div>
  </section>
</div>
<script>
const prepChecks=[...document.querySelectorAll('[data-prep-check]')],prepKey='mis-workshop-prep-checks';
try{const saved=JSON.parse(localStorage.getItem(prepKey)||'{}');prepChecks.forEach(c=>c.checked=!!saved[c.dataset.prepCheck])}catch{}
function savePrep(){try{localStorage.setItem(prepKey,JSON.stringify(Object.fromEntries(prepChecks.map(c=>[c.dataset.prepCheck,c.checked]))))}catch{}}
prepChecks.forEach(c=>c.addEventListener('change',savePrep));
document.querySelector('#reset-prep').addEventListener('click',()=>{prepChecks.forEach(c=>c.checked=false);savePrep()});
let remaining=180*60, interval=null;const el=document.querySelector('#timer');function draw(){el.textContent=String(Math.floor(remaining/60)).padStart(2,'0')+':'+String(remaining%60).padStart(2,'0')}document.querySelector('#timer-start').addEventListener('click',()=>{if(interval)return;interval=setInterval(()=>{if(remaining>0){remaining--;draw()}else{clearInterval(interval);interval=null}},1000)});document.querySelector('#timer-pause').addEventListener('click',()=>{clearInterval(interval);interval=null});document.querySelector('#timer-reset').addEventListener('click',()=>{clearInterval(interval);interval=null;remaining=10800;draw()});draw();
document.querySelectorAll('.copy-prompt').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(b.parentElement.querySelector('pre').textContent);b.textContent='Copied ✓'}catch{b.textContent='Select and copy'}setTimeout(()=>b.textContent='Copy prompt',1400)}));
</script>
<style>
.prep-heading{display:flex;justify-content:space-between;align-items:center;gap:16px}
.prep-heading h2{margin:0}
.screens-heading{margin-bottom:14px}
.screens-heading h2{margin:5px 0 8px}
.screens-heading p{max-width:760px}
.screen-gallery{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.reference-screen{margin:0;padding:9px;border:1px solid #d7d7d1;background:#f7f7f4;min-width:0}
.screen-ref-title{display:flex;justify-content:space-between;gap:9px;align-items:center;padding:1px 0 8px;font:700 8px 'Titillium Web',sans-serif;letter-spacing:.07em;color:#555}
.screen-ref-title a{font:700 9px 'Roboto',sans-serif;text-underline-offset:3px}
.reference-screen img{display:block;width:100%;height:190px;object-fit:contain;object-position:top center;background:#202020;border:1px solid #ddd}
.reference-screen figcaption{font:11px/1.5 'Roboto',sans-serif;color:#555;margin-top:8px}
@media(max-width:680px){.screen-gallery{grid-template-columns:1fr}.prep-heading{align-items:flex-start;flex-direction:column}}
</style>
</BaseLayout>