---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const lab = 'https://github.com/bsbcyber/secure-dev-lab';
const agenda = [
['Partners + READ prompts','Discussion partner. Own repo. Must / Should / Stretch. Intro Python lab.','1'],
['Claim the template','Use this template → your public copy. No local scanner installs.','1'],
['Round 0 · First scan','Actions → Security Lab. Unit tests green; scanners red is expected.','2'],
['Gate G0 · Scout','Compare tallies; READ prompts 1–3 on one failed job.','2'],
['Round 1 · Semgrep Commit A','Guided: replace Python eval + exec; update tests.','3'],
['Gate G1','Must floor: eval and exec findings gone.','3'],
['Gate G2 · OSV','Update PyYAML and Flask from advisory links — Must complete.','4'],
['Should · Secrets','Clear all three synthetic fixtures.','5'],
['Should · Workflow','Pin actions, drop pull_request_target, least privilege.','6'],
['Stretch · PR + case study','PR checks; resume write-up; peer-review with READ prompts.','7'],
['Exit ticket','Explain two findings with READ prompts; show resume link.','8']
];
---
<BaseLayout title="Workshop 2 · Secure development" description="Agenda and checklist for MIS Club Workshop 2: GitHub Actions security scanners.">
<div class="container">
  <section class="page-hero">
    <div class="eyebrow">WORKSHOP 02 · 2 HOURS</div>
    <h1>Secure development with GitHub Actions.</h1>
    <p>First intro to scanners for intro Python students. Own lab + partner READ prompts. Clear Must / Should / Stretch, then capture a case study. Do not deploy this lab.</p>
    <div class="actions">
      <a class="btn primary" href={base+'student-guide-2/'}>Open the student walkthrough ↗</a>
      <a class="btn" href={lab} target="_blank" rel="noreferrer">Lab template ↗</a>
      <a class="btn" href={base+'slides-2/'}>Facilitator deck ↗</a>
    </div>
  </section>

  <section class="grid two">
    <article class="card">
      <div class="eyebrow">Workshop goal</div>
      <h2>Read findings, research one link, then fix</h2>
      <p>Discussion partner for READ prompts; your own repo for commits. Clear <strong>Must</strong>, aim for <strong>Should</strong>, use <strong>Stretch</strong> if ahead — don’t leave at minute 20.</p>
      <div class="tag-row"><span class="tag">Partners</span><span class="tag">Must</span><span class="tag">Should</span><span class="tag">Stretch</span></div>
    </article>
    <article class="card">
      <div class="eyebrow">Choose where to start</div>
      <h2>Which path?</h2>
      <div class="subnav">
        <button class="btn small path-btn primary" data-path="guided">Guided</button>
        <button class="btn small path-btn" data-path="catchup">Catch up</button>
        <button class="btn small path-btn" data-path="extend">Extension</button>
      </div>
      <p id="path-copy">Start with a partner, then work the Must checklist before Should / Stretch.</p>
    </article>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <div class="eyebrow">Your checklist</div>
        <h2>Must · Should · Stretch</h2>
        <p class="muted small">Mark each step as you finish. Progress stays in this browser.</p>
      </div>
      <button id="reset-progress" class="btn small">Reset</button>
    </div>
    <div class="card">
      <div class="callout-title"><strong id="progress-count">0 of 7 checklist items complete</strong><span class="muted small" id="progress-percent">0%</span></div>
      <div class="progress-wrap" style="margin:12px 0 18px"><div class="progress-bar" id="progress-bar"></div></div>
      <div class="checklist" id="checklist">
        <label class="check-row"><input type="checkbox" data-id="partner"><span><b>MUST · Partner</b> — I have a discussion partner; we each use our own template repo.</span></label>
        <label class="check-row"><input type="checkbox" data-id="clone"><span><b>MUST · Template</b> — My Actions run showed unit tests green and scanners red.</span></label>
        <label class="check-row"><input type="checkbox" data-id="g0"><span><b>MUST · Gate G0</b> — We ran READ prompts on one failed job (tool, file/line, match).</span></label>
        <label class="check-row"><input type="checkbox" data-id="g1"><span><b>MUST · Gate G1</b> — Commit A done: Python <code>eval</code> and <code>exec</code> findings gone.</span></label>
        <label class="check-row"><input type="checkbox" data-id="g2"><span><b>MUST · Gate G2</b> — OSV is green for PyYAML <em>and</em> Flask.</span></label>
        <label class="check-row"><input type="checkbox" data-id="should"><span><b>SHOULD</b> — All 4 SAST + 3 secrets + workflow fixture hardened.</span></label>
        <label class="check-row"><input type="checkbox" data-id="stretch"><span><b>STRETCH</b> — PR + resume case study (≥2 findings) + peer-reviewed my partner.</span></label>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Plan</div><h2>Agenda</h2></div></div>
    <div class="timeline">
      {agenda.map(([title, description, mission]) => (
        <article class="timeline-item">
          <h3>{title}</h3>
          <p>{description}</p>
          <a class="agenda-mission-link" href={base + 'student-guide-2/#step-' + mission}>Go to step {mission} ↗</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><div class="eyebrow">If you’re behind</div><h2>Checkpoints</h2></div></div>
    <div class="grid">
      <article class="card"><span class="pill">MUST FLOOR</span><h3>Gates G0 → G2</h3><p>READ prompts, Commit A (eval+exec), both requirements pins. That is the bar to leave. Ask your partner before asking the whole room.</p></article>
      <article class="card"><span class="pill">IF BEHIND</span><h3>Stop after Must</h3><p>Skip remaining SAST/secrets/zizmor in class — they become Should homework. Rejoin at OSV if needed.</p></article>
      <article class="card"><span class="pill">IF AHEAD</span><h3>Should → Stretch</h3><p>Finish all findings, then PR + resume case study, then peer-review with READ prompts. Do not leave at minute 20.</p></article>
    </div>
  </section>

  <div class="notice" style="margin-top:18px">
    <strong>Safety:</strong> This lab is intentionally vulnerable. Never deploy it. Never replace the synthetic token with a real secret. A clean scan does not prove software is secure.
  </div>
</div>
<style>
.agenda-mission-link{display:inline-block;margin-top:10px;font:700 12px 'Roboto',sans-serif;text-underline-offset:3px}
.timeline-item:hover h3{text-decoration:underline;text-decoration-color:#FFDB00;text-decoration-thickness:3px;text-underline-offset:4px}
.check-row{border-radius:3px}
.check-row input{accent-color:#111}
.check-row b{font:700 10px 'Titillium Web',sans-serif;letter-spacing:.05em;display:block;margin-bottom:3px}
#progress-bar{background:#111}
#path-copy{min-height:58px}
.path-btn{border-radius:3px}
@media(prefers-reduced-motion:reduce){.timeline-item:hover h3{text-decoration:none}}
</style>
<script>
const pathCopy={
  guided:'Pick a discussion partner, create your own template, use READ prompts, then clear Must (G0→G2) before Should / Stretch.',
  catchup:'Stay with your partner. Finish Must: READ prompts, Commit A (eval+exec), PyYAML + Flask. Park Should as homework if the room moves on.',
  extend:'Clear all Should findings, then Stretch: PR, resume case study naming ≥2 findings, and peer-review with READ prompts.'
};
document.querySelectorAll('.path-btn').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('.path-btn').forEach(x=>x.classList.remove('primary'));
  b.classList.add('primary');
  document.querySelector('#path-copy').textContent=pathCopy[b.dataset.path];
}));
const boxes=[...document.querySelectorAll('#checklist input')];
const key='mis-workshop2-progress';
try{const saved=JSON.parse(localStorage.getItem(key)||'{}');boxes.forEach(b=>b.checked=!!saved[b.dataset.id])}catch{}
function update(){
  const n=boxes.filter(b=>b.checked).length;
  document.querySelector('#progress-count').textContent=n+' of '+boxes.length+' checklist items complete';
  document.querySelector('#progress-percent').textContent=Math.round(n/boxes.length*100)+'%';
  document.querySelector('#progress-bar').style.width=(n/boxes.length*100)+'%';
  try{localStorage.setItem(key,JSON.stringify(Object.fromEntries(boxes.map(b=>[b.dataset.id,b.checked]))))}catch{}
}
boxes.forEach(b=>b.addEventListener('change',update));
document.querySelector('#reset-progress').addEventListener('click',()=>{boxes.forEach(b=>b.checked=false);update()});
update();
</script>
</BaseLayout>
