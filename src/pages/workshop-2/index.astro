---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const lab = 'https://github.com/bsbcyber/secure-dev-lab';
const agenda = [
['Outcome and safety','What you will leave with — and what you must never do with this lab.','1'],
['Claim the template','Use this template on bsbcyber/secure-dev-lab; create your own public copy.','1'],
['First Security Lab run','Open Actions → Security Lab. Unit tests green; scanners red is expected.','2'],
['Finding vs tool failure','Record rule/advisory, file, and next action. Setup errors are not findings.','2'],
['Actions anatomy','Trigger, job, runner, step, exit code — read security-lab.yml.','2'],
['SAST with Semgrep','Explain eval risk; replace previewExpression; update tests; re-run.','3'],
['Break','Catch up. Do not merge the fixed-baseline branch onto your main.','3'],
['SCA with OSV-Scanner','Read advisories; update lodash in package.json and the lockfile together.','4'],
['Secrets with Gitleaks','Clear the synthetic token; history caveat if it were real.','5'],
['Workflow security with zizmor','Fix the inert fixture only — pin SHA, narrow permissions.','6'],
['Pull request','Branch → small change → inspect checks on the PR.','7'],
['Resume case study','Add a project card on your Workshop 1 site linking this lab. Do not deploy the lab.','8'],
['Exit ticket','Explain one finding; show the resume link.','8']
];
---
<BaseLayout title="Workshop 2 · Secure development" description="Agenda and checklist for MIS Club Workshop 2: GitHub Actions security scanners.">
<div class="container">
  <section class="page-hero">
    <div class="eyebrow">WORKSHOP 02</div>
    <h1>Secure development with GitHub Actions.</h1>
    <p>Clone an intentionally vulnerable lab, read real scanner output, fix four controlled findings, and capture a case study on your resume site. Do not deploy this lab.</p>
    <div class="actions">
      <a class="btn primary" href={base+'student-guide-2/'}>Open the student walkthrough ↗</a>
      <a class="btn" href={lab} target="_blank" rel="noreferrer">Lab template ↗</a>
      <a class="btn" href={base+'slides-2/'}>Facilitator deck ↗</a>
    </div>
  </section>

  <section class="grid two">
    <article class="card">
      <div class="eyebrow">Workshop goal</div>
      <h2>Triage findings, then prove the fix</h2>
      <p>Use Semgrep, OSV-Scanner, Gitleaks, and zizmor in Actions. Leave with a remediated lab repo and a short case study on your Workshop 1 resume site.</p>
      <div class="tag-row"><span class="tag">Actions</span><span class="tag">SAST</span><span class="tag">SCA</span><span class="tag">Secrets</span></div>
    </article>
    <article class="card">
      <div class="eyebrow">Choose where to start</div>
      <h2>Which path?</h2>
      <div class="subnav">
        <button class="btn small path-btn primary" data-path="guided">Guided</button>
        <button class="btn small path-btn" data-path="catchup">Catch up</button>
        <button class="btn small path-btn" data-path="extend">Extension</button>
      </div>
      <p id="path-copy">Start at the top and work through the checklist in order.</p>
    </article>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <div class="eyebrow">Your checklist</div>
        <h2>Workshop checklist</h2>
        <p class="muted small">Mark each step as you finish. Progress stays in this browser.</p>
      </div>
      <button id="reset-progress" class="btn small">Reset</button>
    </div>
    <div class="card">
      <div class="callout-title"><strong id="progress-count">0 of 5 checklist items complete</strong><span class="muted small" id="progress-percent">0%</span></div>
      <div class="progress-wrap" style="margin:12px 0 18px"><div class="progress-bar" id="progress-bar"></div></div>
      <div class="checklist" id="checklist">
        <label class="check-row"><input type="checkbox" data-id="clone"><span><b>01 · Template</b> — I created my own repo from the lab template and Actions ran.</span></label>
        <label class="check-row"><input type="checkbox" data-id="read"><span><b>02 · Read</b> — I recorded at least one scanner finding (not a setup error).</span></label>
        <label class="check-row"><input type="checkbox" data-id="sast"><span><b>03 · SAST</b> — Semgrep is green after fixing <code>previewExpression</code>.</span></label>
        <label class="check-row"><input type="checkbox" data-id="sca"><span><b>04 · SCA</b> — OSV is green after updating lodash (manifest + lockfile).</span></label>
        <label class="check-row"><input type="checkbox" data-id="case"><span><b>05 · Case study</b> — My resume site links this lab with a short write-up.</span></label>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Plan</div><h2>Agenda</h2></div></div>
    <div class="timeline">
      {agenda.map(([title, description, mission]) => (
        <article class="timeline-item">
          <h3>{title}</h3>
          <p>{description}</p>
          <a class="agenda-mission-link" href={base + 'student-guide-2/#step-' + mission}>Go to step {mission} ↗</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><div class="eyebrow">If you’re behind</div><h2>Checkpoints</h2></div></div>
    <div class="grid">
      <article class="card"><span class="pill">CHECKPOINT 1</span><h3>First red run</h3><p>If cloning ate the first half hour, finish the template clone and open Actions. Confirm unit tests are green. Rejoin at Semgrep with the room.</p></article>
      <article class="card"><span class="pill">CHECKPOINT 2</span><h3>SAST done</h3><p>If you finish Semgrep late, prioritize OSV next. Treat Gitleaks and zizmor as stretch or homework.</p></article>
      <article class="card"><span class="pill">CHECKPOINT 3</span><h3>Need a finished example</h3><p>Facilitator can show branch <code>validation/fixed-baseline</code> on the template repo — labeled as already fixed. Do not replace your learning by copying it blindly.</p></article>
    </div>
  </section>

  <div class="notice" style="margin-top:18px">
    <strong>Safety:</strong> This lab is intentionally vulnerable. Never deploy it. Never replace the synthetic token with a real secret. A clean scan does not prove software is secure.
  </div>
</div>
<style>
.agenda-mission-link{display:inline-block;margin-top:10px;font:700 12px 'Roboto',sans-serif;text-underline-offset:3px}
.timeline-item:hover h3{text-decoration:underline;text-decoration-color:#FFDB00;text-decoration-thickness:3px;text-underline-offset:4px}
.check-row{border-radius:3px}
.check-row input{accent-color:#111}
.check-row b{font:700 10px 'Titillium Web',sans-serif;letter-spacing:.05em;display:block;margin-bottom:3px}
#progress-bar{background:#111}
#path-copy{min-height:58px}
.path-btn{border-radius:3px}
@media(prefers-reduced-motion:reduce){.timeline-item:hover h3{text-decoration:none}}
</style>
<script>
const pathCopy={
  guided:'Follow the agenda from the beginning and complete each checklist item in order.',
  catchup:'Skip to the current agenda item. Use Checkpoint 1 (first red run) or ask the facilitator to show the labeled fixed-baseline demo, then rejoin.',
  extend:'Finish Semgrep + OSV first. Then complete Gitleaks, zizmor, a full PR, and a richer resume case study.'
};
document.querySelectorAll('.path-btn').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('.path-btn').forEach(x=>x.classList.remove('primary'));
  b.classList.add('primary');
  document.querySelector('#path-copy').textContent=pathCopy[b.dataset.path];
}));
const boxes=[...document.querySelectorAll('#checklist input')];
const key='mis-workshop2-progress';
try{const saved=JSON.parse(localStorage.getItem(key)||'{}');boxes.forEach(b=>b.checked=!!saved[b.dataset.id])}catch{}
function update(){
  const n=boxes.filter(b=>b.checked).length;
  document.querySelector('#progress-count').textContent=n+' of '+boxes.length+' checklist items complete';
  document.querySelector('#progress-percent').textContent=Math.round(n/boxes.length*100)+'%';
  document.querySelector('#progress-bar').style.width=(n/boxes.length*100)+'%';
  try{localStorage.setItem(key,JSON.stringify(Object.fromEntries(boxes.map(b=>[b.dataset.id,b.checked]))))}catch{}
}
boxes.forEach(b=>b.addEventListener('change',update));
document.querySelector('#reset-progress').addEventListener('click',()=>{boxes.forEach(b=>b.checked=false);update()});
update();
</script>
</BaseLayout>
