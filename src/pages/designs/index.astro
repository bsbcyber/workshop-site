---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base=import.meta.env.BASE_URL;
const designs=[
{slug:'editorial',name:'Editorial',label:'01 · STORY-LED',desc:'Warm paper tones, considered typography, generous whitespace, and a narrative resume timeline.',tags:['Serif typography','Experience timeline','Warm palette'],className:'preview-editorial'},
{slug:'developer',name:'Developer',label:'02 · PROJECT-LED',desc:'Dark surfaces, crisp type, bright accent colors, technical skills, and featured project cards.',tags:['Dark mode feel','Project cards','Technical profile'],className:'preview-developer'},
{slug:'professional',name:'Professional',label:'03 · RECRUITER-READY',desc:'A structured profile panel, direct contact details, concise history, education, and skills.',tags:['Structured profile','Clear hierarchy','Print-friendly'],className:'preview-professional'}
];
---
<BaseLayout title="Portfolio design chooser" description="Compare the Editorial, Developer, and Professional portfolio layouts.">
<div class="container"><section class="page-hero"><div class="eyebrow">Portfolio starter · select a direction</div><h1>Three ways to tell your story.</h1><p>Choose the presentation style that fits your goals. The workshop uses the same information model and development workflow for each layout, so you're free to personalize the design without starting from zero.</p></section>
<div class="content-stack">{designs.map(d=><article class="card design-layout"><div class:list={['layout-preview',d.className]}><div class="mock-side"></div><div class="mock-main"><div class="mock-line short"></div><div class="mock-line wide" style="height:17px"></div><div class="mock-line mid"></div><div class="mock-card"></div><div class="mock-card"></div></div></div><div><div class="eyebrow">{d.label}</div><h2>{d.name}</h2><p>{d.desc}</p><div class="tag-row">{d.tags.map(t=><span class="tag">{t}</span>)}</div><div class="actions"><a class="btn primary" href={base+'previews/'+d.slug+'/'}>Explore this design ↗</a></div></div></article>)}</div>
<section class="section"><div class="notice"><strong>Workshop tip:</strong> Pick the design you like first, then edit your content. Use Copilot for targeted improvements, and inspect the diff before committing. Don't ask it to rebuild the whole site just to change one section.</div></section>
</div></BaseLayout>