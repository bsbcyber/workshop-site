---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const designs = [
  {
    slug: 'student',
    name: 'Student',
    label: '01 / STUDENT',
    desc: 'Built for classes, clubs, and class projects. Education, coursework, and activities lead — no empty job timeline.',
    tags: ['Coursework first', 'Activities', 'Class projects'],
    outcome: 'Feels full even before an internship.',
    audience: 'Students with coursework, campus involvement, and personal or class projects — no internship yet.',
    download: 'downloads/portfolio-student.zip',
  },
  {
    slug: 'emerging',
    name: 'Emerging',
    label: '02 / EMERGING',
    desc: 'Compact resume layout for an internship or early role plus a few projects you can explain.',
    tags: ['Internship + projects', 'Compact CV', 'Two-column projects'],
    outcome: 'Balances early work experience with a project grid.',
    audience: 'Students with an internship or campus role and 2–4 projects.',
    download: 'downloads/portfolio-emerging.zip',
  },
  {
    slug: 'professional',
    name: 'Professional',
    label: '03 / PROFESSIONAL',
    desc: 'Two-column resume: sidebar for photo, contact, skills, and education; main column for profile, experience, and projects.',
    tags: ['Two-column resume', 'Photo support', 'Denser experience'],
    outcome: 'Good for a fuller experience list and recruiter scanning.',
    audience: 'Students or early professionals with multiple roles and a denser story.',
    download: 'downloads/portfolio-professional.zip',
  },
];
---
<BaseLayout title="Portfolio design lab" description="Explore three live portfolio themes matched to where you are in your journey.">
<div class="container designs-page">
  <section class="page-hero">
    <div class="eyebrow">PORTFOLIO LAB / LIVE THEMES</div>
    <h1>Pick the layout that matches<br/>what you have today.</h1>
    <p>These previews are the same themes you download. Each ZIP includes sample content shaped for that stage so the page does not feel empty. Replace the examples with your own information.</p>
    <p>Want a filled-out personal example of the same three stages? Open the <a href="https://tyler-beach.github.io/example-my-resume-site/" target="_blank" rel="noreferrer">example resume site ↗</a>.</p>
    <div class="design-meta-strip"><span><b>03</b> JOURNEY THEMES</span><span><b>01</b> SHARED PROFILE FILE</span><span>DOWNLOAD A PRE-SET ZIP</span></div>
  </section>

  <section class="design-lab" aria-labelledby="design-lab-heading">
    <div class="lab-intro">
      <div><div class="eyebrow">01 / CHOOSE A LAYOUT</div><h2 id="design-lab-heading">Which stage fits your work?</h2></div>
      <p>All three layouts edit the same <code>profile.js</code> file. Choose the one that matches your current experience, then personalize.</p>
    </div>
    <div class="theme-tabs" role="tablist" aria-label="Portfolio design themes">
      {designs.map((d,i)=><button class:list={['theme-tab',i===0?'is-active':'']} type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls="portfolio-preview-panel" id={'theme-tab-'+d.slug} data-theme-choice={d.slug} data-preview-url={base+'previews/'+d.slug+'/embed/'} data-full-url={base+'previews/'+d.slug+'/'} data-download-url={base+d.download} data-name={d.name} data-label={d.label} data-description={d.desc} data-outcome={d.outcome} data-audience={d.audience} data-tags={d.tags.join('|')} tabindex={i===0?'0':'-1'}>
        <span class="theme-number">0{i+1}</span><span class={'theme-swatch swatch-'+d.slug} aria-hidden="true"><i></i><i></i><i></i></span><span class="theme-tab-copy"><b>{d.name}</b><small>{d.label.split('/ ')[1]}</small></span><span class="theme-selected" aria-hidden="true">✓</span>
      </button>)}
    </div>

    <div class="preview-toolbar">
      <div class="preview-ident"><span class="live-state"><i></i> LIVE PREVIEW</span><b id="active-preview-name">Student</b><span id="active-preview-purpose">Student layout</span></div>
      <div class="viewport-tools" role="group" aria-label="Preview viewport size">
        <span>VIEW</span>
        <button type="button" data-preview-view="desktop" class="is-active" aria-pressed="true"><span aria-hidden="true">▰</span> Desktop</button>
        <button type="button" data-preview-view="tablet" aria-pressed="false"><span aria-hidden="true">▭</span> Tablet</button>
        <button type="button" data-preview-view="mobile" aria-pressed="false"><span aria-hidden="true">▯</span> Mobile</button>
      </div>
    </div>
    <div class="preview-panel" id="portfolio-preview-panel" role="tabpanel" aria-labelledby="theme-tab-student">
      <div class="browser-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="url" id="preview-url-chip">previews/student/</span>
      </div>
      <div class="preview-frame-wrap is-desktop" id="preview-frame-wrap">
        <iframe id="portfolio-preview-frame" title="Student portfolio theme preview" src={base+'previews/student/embed/'} loading="eager"></iframe>
      </div>
    </div>

    <div class="preview-details">
      <div>
        <div class="eyebrow">WHY THIS LAYOUT</div>
        <p id="active-preview-description">{designs[0].desc}</p>
        <p id="active-preview-outcome"><strong>Outcome:</strong> {designs[0].outcome}</p>
        <p id="active-preview-audience"><strong>Best for:</strong> {designs[0].audience}</p>
        <div class="tag-row" id="active-preview-tags">{designs[0].tags.map((t)=><span>{t}</span>)}</div>
      </div>
      <div class="preview-actions">
        <a class="btn primary" id="active-download" href={base+designs[0].download}>Download Student ZIP ↓</a>
        <a class="btn" id="active-full-preview" href={base+'previews/student/'}>Open full preview ↗</a>
        <a class="btn" href={base+'student-guide/#step-2'}>Start the walkthrough →</a>
      </div>
    </div>
  </section>
</div>

<style>
.designs-page{padding-bottom:70px}
.design-meta-strip{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
.design-meta-strip span{background:#111;color:#fff;padding:8px 12px;border-radius:2px;font:700 11px 'Titillium Web',sans-serif;letter-spacing:.04em}
.design-meta-strip b{color:#FFDB00}
.lab-intro{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:18px;flex-wrap:wrap}
.lab-intro h2{margin:6px 0 0;font:700 28px 'Titillium Web',sans-serif}
.lab-intro p{max-width:420px;margin:0;font:14px/1.55 'Roboto',sans-serif;color:#555}
.lab-intro code{font:12px 'DM Mono',monospace;background:#f0f0ec;padding:1px 5px;border-radius:3px}
.theme-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px}
.theme-tab{appearance:none;border:1px solid #d7d7d2;background:#fff;padding:12px;display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;cursor:pointer;text-align:left;border-radius:4px}
.theme-tab.is-active{border-color:#111;box-shadow:inset 0 0 0 1px #111}
.theme-number{font:700 12px 'Titillium Web',sans-serif;color:#777}
.theme-tab-copy{display:grid;gap:2px}
.theme-tab-copy b{font:700 16px 'Titillium Web',sans-serif}
.theme-tab-copy small{font:11px 'Roboto',sans-serif;color:#666;letter-spacing:.06em}
.theme-selected{opacity:0;font-weight:700}
.theme-tab.is-active .theme-selected{opacity:1}
.theme-swatch{width:42px;height:42px;border-radius:4px;display:grid;align-content:center;gap:3px;padding:6px;box-sizing:border-box}
.theme-swatch i{display:block;height:3px;background:rgba(0,0,0,.2);width:90%}
.theme-swatch i:last-child{width:55%}
.swatch-student{background:#e8eef7}
.swatch-emerging{background:#ecfdf5}
.swatch-professional{background:#F2F2F2}
.preview-toolbar{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:8px}
.preview-ident{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.live-state{display:inline-flex;align-items:center;gap:6px;font:700 10px 'Titillium Web',sans-serif;letter-spacing:.1em;color:#0f766e}
.live-state i{width:7px;height:7px;border-radius:50%;background:#0f766e}
.preview-ident b{font:700 18px 'Titillium Web',sans-serif}
.viewport-tools{display:flex;gap:6px;align-items:center}
.viewport-tools span{font:700 10px 'Titillium Web',sans-serif;color:#777;margin-right:4px}
.viewport-tools button{appearance:none;border:1px solid #d7d7d2;background:#fff;padding:7px 10px;border-radius:3px;font:12px 'Roboto',sans-serif;cursor:pointer}
.viewport-tools button.is-active{background:#111;color:#fff;border-color:#111}
.preview-panel{border:1px solid #d7d7d2;border-radius:8px;overflow:hidden;background:#fff}
.browser-bar{display:flex;align-items:center;gap:10px;padding:10px 12px;background:#f4f4f0;border-bottom:1px solid #d7d7d2}
.browser-bar .dots{display:flex;gap:5px}
.browser-bar .dots i{width:8px;height:8px;border-radius:50%;background:#cfcfc8}
.browser-bar .url{font:12px 'DM Mono',monospace;color:#666}
.preview-frame-wrap{background:#eef1f4}
.preview-frame-wrap iframe{display:block;width:100%;height:min(78vh,860px);border:0;background:#fff;margin:0 auto}
.preview-frame-wrap.is-tablet iframe{width:min(100%,820px);height:min(78vh,860px)}
.preview-frame-wrap.is-mobile iframe{width:min(100%,390px);height:min(78vh,780px)}
.preview-details{display:grid;grid-template-columns:1.4fr .8fr;gap:22px;margin-top:18px;align-items:start}
.preview-details p{font:14px/1.6 'Roboto',sans-serif;color:#444;margin:0 0 10px}
.tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.tag-row span{padding:5px 9px;border:1px solid #d7d7d2;border-radius:3px;font:12px 'Roboto',sans-serif;background:#fff}
.preview-actions{display:grid;gap:8px}
@media(max-width:850px){
  .theme-tabs,.preview-details{grid-template-columns:1fr}
}
</style>

<script is:inline>
(function () {
  var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-theme-choice]'));
  var frame = document.getElementById('portfolio-preview-frame');
  var wrap = document.getElementById('preview-frame-wrap');
  var nameEl = document.getElementById('active-preview-name');
  var purposeEl = document.getElementById('active-preview-purpose');
  var descEl = document.getElementById('active-preview-description');
  var outcomeEl = document.getElementById('active-preview-outcome');
  var audienceEl = document.getElementById('active-preview-audience');
  var tagsEl = document.getElementById('active-preview-tags');
  var downloadEl = document.getElementById('active-download');
  var fullEl = document.getElementById('active-full-preview');
  var urlChip = document.getElementById('preview-url-chip');
  var panel = document.getElementById('portfolio-preview-panel');

  function activate(tab) {
    tabs.forEach(function (t) {
      var on = t === tab;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
    });
    frame.src = tab.getAttribute('data-preview-url');
    nameEl.textContent = tab.getAttribute('data-name');
    purposeEl.textContent = tab.getAttribute('data-label');
    descEl.textContent = tab.getAttribute('data-description');
    outcomeEl.innerHTML = '<strong>Outcome:</strong> ' + tab.getAttribute('data-outcome');
    audienceEl.innerHTML = '<strong>Best for:</strong> ' + tab.getAttribute('data-audience');
    tagsEl.innerHTML = tab.getAttribute('data-tags').split('|').map(function (tag) {
      return '<span>' + tag + '</span>';
    }).join('');
    downloadEl.href = tab.getAttribute('data-download-url');
    downloadEl.textContent = 'Download ' + tab.getAttribute('data-name') + ' ZIP ↓';
    fullEl.href = tab.getAttribute('data-full-url');
    urlChip.textContent = 'previews/' + tab.getAttribute('data-theme-choice') + '/';
    panel.setAttribute('aria-labelledby', tab.id);
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () { activate(tab); });
  });

  document.querySelectorAll('[data-preview-view]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('[data-preview-view]').forEach(function (b) {
        b.classList.toggle('is-active', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      wrap.className = 'preview-frame-wrap is-' + btn.getAttribute('data-preview-view');
    });
  });
})();
</script>
</BaseLayout>
