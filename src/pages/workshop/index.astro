---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const agenda = [
['00:00','10 min','Kickoff: what are we shipping?','See the target result and the full route.','1'],
['00:10','15 min','Access + readiness','Verify GitHub, VS Code, Git, and Copilot.','1'],
['00:25','10 min','Git vs. GitHub','Understand local history, remote hosting, and when a push actually changes GitHub.','5'],
['00:35','15 min','Claim the repository','Choose a portfolio direction and create your repository.','2'],
['00:50','15 min','Open the project','Find the source files, Source Control, and local terminal.','3'],
['01:05','20 min','Personalize one section','Use Copilot for one focused change and inspect the result.','4'],
['01:25','10 min','Preview + inspect','Check links, content, and the mobile layout before committing.','4'],
['01:35','10 min','Break / unblock','Resolve one setup issue or rejoin at a known checkpoint.','1'],
['01:45','10 min','Write the issue','Define acceptance criteria before asking for code.','5'],
['01:55','20 min','Branch, commit, push, and PR','Inspect the diff and review the task against its criteria.','5'],
['02:15','15 min','Publish with Pages','Check the actual Actions run and Pages deployment.','6'],
['02:30','15 min','Verify the public site','Open the live URL and test links and mobile layout.','6'],
['02:45','10 min','Catch up or extend','Rejoin at the next milestone or polish accessibility and content.','6'],
['02:55','5 min','Exit check','Explain one Git concept and one Copilot change you reviewed.','6']
];
---
<BaseLayout title="Student workshop guide" description="The complete interactive 3-hour Workshop 1 guide.">
<div class="container">
  <section class="page-hero"><div class="eyebrow">Student workspace · 180 minutes</div><h1>Build it. Version it. Ship it.</h1><p>Move through a real development workflow while creating a portfolio you can use after class. Checkpoints let you catch up if you arrive late or get stuck.</p><div class="actions"><a class="btn primary" href={base+'designs/'}>Choose a portfolio design ↗</a><a class="btn" href={base+'resources/'}>Open quick references ↗</a></div></section>
  <section class="grid two">
    <article class="card"><div class="eyebrow">Today's outcome</div><h2>Leave with a live site</h2><p>You'll own a repository, make a reviewed change, and publish the result with GitHub Pages. Your site can keep growing through the next three workshops.</p><div class="tag-row"><span class="tag">VS Code</span><span class="tag">GitHub</span><span class="tag">Copilot</span><span class="tag">Astro</span></div></article>
    <article class="card"><div class="eyebrow">Keep moving</div><h2>Choose your learning path</h2><div class="subnav"><button class="btn small path-btn" data-path="guided">Guided</button><button class="btn small path-btn" data-path="catchup">Catch up</button><button class="btn small path-btn" data-path="extend">Extension</button></div><p id="path-copy">Follow the agenda from the beginning and complete each checkpoint in order.</p></article>
  </section>
  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Personal progress</div><h2>Four proof points</h2><p class="muted small">A short session log. Your progress stays in this browser.</p></div><button id="reset-progress" class="btn small">Reset</button></div>
    <div class="card"><div class="callout-title"><strong id="progress-count">0 of 4 proof points complete</strong><span class="muted small" id="progress-percent">0%</span></div><div class="progress-wrap" style="margin:12px 0 18px"><div class="progress-bar" id="progress-bar"></div></div><div class="checklist" id="checklist">
      <label class="check-row"><input type="checkbox" data-id="repo"><span><b>01 · Local</b> — I can open the starter and the local site runs.</span></label>
      <label class="check-row"><input type="checkbox" data-id="change"><span><b>02 · Change</b> — I made one focused improvement and reviewed the diff.</span></label>
      <label class="check-row"><input type="checkbox" data-id="review"><span><b>03 · Review</b> — I pushed a branch and inspected the pull request.</span></label>
      <label class="check-row"><input type="checkbox" data-id="live"><span><b>04 · Release</b> — Actions succeeded and I checked the live URL.</span></label>
    </div>
  </section>
  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Run of show</div><h2>Three-hour agenda</h2></div></div>
    <div class="timeline">
    {agenda.map(([time,duration,title,description,mission])=><article class="timeline-item"><div class="time">{time}<br/><span class="muted">{duration}</span></div><div><h3>{title}</h3><p>{description}</p><a class="agenda-mission-link" href={base+'student-guide/#step-'+mission}>Open mission {mission} ↗</a></div></article>)}
    </div>
  </section>
  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Use AI intentionally</div><h2>Copilot prompt starters</h2></div></div>
    <div class="grid two">
      <article class="card prompt"><h3>First, understand the project</h3><p>Ask for an explanation before asking for code.</p><pre>Explain this project structure and how the page, styles, and resume data fit together. Don't change any files yet. List the safest files for me to edit first.</pre><button class="btn small copy-prompt">Copy prompt</button></article>
      <article class="card prompt"><h3>Make one focused change</h3><p>Describe the outcome and constraints.</p><pre>On the current portfolio, improve the visual hierarchy of the project cards. Keep the existing framework and layout. Make the change responsive, explain which files you changed, and don't add dependencies.</pre><button class="btn small copy-prompt">Copy prompt</button></article>
      <article class="card prompt"><h3>Ask for a review</h3><p>Use the assistant to help inspect its own work.</p><pre>Review the changes you just made. Identify possible layout regressions, accessibility issues, broken links, or assumptions. Do not modify files until you explain the findings.</pre><button class="btn small copy-prompt">Copy prompt</button></article>
      <article class="card prompt"><h3>Debug, don't guess</h3><p>Provide error output and ask for a diagnosis.</p><pre>Here is the exact error message: [paste error]. Explain the most likely cause, how I can verify it, and the smallest safe fix. Do not rewrite unrelated files.</pre><button class="btn small copy-prompt">Copy prompt</button></article>
    </div>
    <div class="notice" style="margin-top:18px"><strong>AI safety:</strong> Don't paste passwords, API tokens, private keys, or personal information you don't want to publish. Read every proposed change and verify it before committing.</div>
  </section>
  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Rejoin at any time</div><h2>Catch-up checkpoints</h2></div></div>
    <div class="grid">
      <article class="card"><span class="pill">CHECKPOINT 1</span><h3>Repository ready</h3><p>Start here if setup or repository creation took too long. Open the prepared starter, verify it builds, and continue to personalization.</p></article>
      <article class="card"><span class="pill">CHECKPOINT 2</span><h3>Site personalized</h3><p>Use a prepared personalized example if you missed the first hour. Practice issue → branch → commit → pull request.</p></article>
      <article class="card"><span class="pill">CHECKPOINT 3</span><h3>Ready to deploy</h3><p>If your branch work is behind, use the finished example and focus on Pages settings, Actions logs, and verifying the live URL.</p></article>
    </div>
  </section>
</div>
<style>
.agenda-mission-link{display:inline-block;margin-top:7px;font:700 10px 'Roboto',sans-serif;text-underline-offset:3px}
.timeline-item{padding:18px 0}
.timeline-item:hover h3{ text-decoration:underline;text-decoration-color:#FFDB00;text-decoration-thickness:3px;text-underline-offset:4px}
.check-row{border-radius:3px}
.check-row input{accent-color:#111}
.check-row b{font:700 10px 'Titillium Web',sans-serif;letter-spacing:.05em;display:block;margin-bottom:3px}
#progress-bar{background:#111}
#path-copy{min-height:58px}
.path-btn{border-radius:3px}
@media(prefers-reduced-motion:reduce){.timeline-item:hover h3{text-decoration:none}}
</style>
<script>
const pathCopy={guided:'Follow the agenda from the beginning and complete each checkpoint in order.',catchup:'Skip to the current agenda item. Ask the instructor for the nearest checkpoint repository, then rejoin at the next visible milestone.',extend:'Finish the required path first. Then improve responsive spacing, contrast, accessibility, content quality, or project case studies.'};
document.querySelectorAll('.path-btn').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.path-btn').forEach(x=>x.classList.remove('primary'));b.classList.add('primary');document.querySelector('#path-copy').textContent=pathCopy[b.dataset.path]}));
const boxes=[...document.querySelectorAll('#checklist input')];const key='mis-workshop1-progress';
try{const saved=JSON.parse(localStorage.getItem(key)||'{}');boxes.forEach(b=>b.checked=!!saved[b.dataset.id])}catch{}
function update(){const n=boxes.filter(b=>b.checked).length;document.querySelector('#progress-count').textContent=n+' of '+boxes.length+' proof points complete';document.querySelector('#progress-percent').textContent=Math.round(n/boxes.length*100)+'%';document.querySelector('#progress-bar').style.width=(n/boxes.length*100)+'%';try{localStorage.setItem(key,JSON.stringify(Object.fromEntries(boxes.map(b=>[b.dataset.id,b.checked]))))}catch{}}
boxes.forEach(b=>b.addEventListener('change',update));document.querySelector('#reset-progress').addEventListener('click',()=>{boxes.forEach(b=>b.checked=false);update()});update();
document.querySelectorAll('.copy-prompt').forEach(b=>b.addEventListener('click',async()=>{const t=b.parentElement.querySelector('pre').textContent;try{await navigator.clipboard.writeText(t);b.textContent='Copied ✓'}catch{b.textContent='Select and copy prompt'}setTimeout(()=>b.textContent='Copy prompt',1600)}));
</script>
</BaseLayout>