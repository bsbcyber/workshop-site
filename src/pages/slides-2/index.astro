---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const lab = 'https://github.com/bsbcyber/secure-dev-lab';
---
<BaseLayout title="Workshop 2 facilitator deck" description="Facilitator deck for secure development with GitHub Actions scanners.">
<div class="presentation-page container">
  <div class="presentation-intro no-print">
    <div>
      <div class="eyebrow">MIS Club · Workshop 2</div>
      <h1>Facilitator deck</h1>
      <p>Pace the room from here. Walkthrough is under Resources (R). Talking points in Notes (N).</p>
    </div>
    <button class="btn primary launch-fullscreen" data-fullscreen>Enter full screen ↗</button>
  </div>

  <div class="presentation-root" id="presentation-root">
    <header class="deck-topbar no-print">
      <a class="deck-brand" href={base}><span class="deck-mark">W</span><span>WICHITA STATE <small>MIS CLUB · WORKSHOP 2</small></span></a>
      <div class="deck-tools">
        <button class="deck-tool" data-toggle="resources" aria-haspopup="dialog">Resources <kbd>R</kbd></button>
        <button class="deck-tool" data-toggle="notes">Notes <kbd>N</kbd></button>
        <button class="deck-tool" data-fullscreen>Full screen <kbd>F</kbd></button>
      </div>
    </header>

    <div class="deck-stage" id="deck-stage" aria-live="polite">

      <section class="deck-slide cover-slide is-active" data-title="Cover" data-notes="Leave up while people sit. Promise: they can read a red security check and fix it on purpose.">
        <div class="slide-num">01</div>
        <div class="cover-body">
          <p class="cover-kicker">Wichita State · MIS Club · 3 hours</p>
          <h2>Secure development with GitHub Actions.</h2>
          <p class="cover-line">Clone a training lab, read real scanner output, fix four findings, and capture a case study on your resume site.</p>
        </div>
      </section>

      <section class="deck-slide" data-title="Outcome" data-notes="Exit ticket: one explained finding + resume link to their lab.">
        <div class="slide-num">02</div>
        <h2 class="say">Today’s job: triage findings, then prove the fix.</h2>
        <ul class="about-list">
          <li>Own copy of the lab template</li>
          <li>Four remediations: SAST, SCA, secret, workflow</li>
          <li>PR that re-runs checks</li>
          <li>Case study on your Workshop 1 resume site</li>
        </ul>
      </section>

      <section class="deck-slide statement" data-title="Safety" data-notes="Cold-call: what would you refuse to paste into a repo?">
        <div class="slide-num">03</div>
        <h2 class="say">Do not deploy this lab. Ever.</h2>
        <p class="talk">Intentionally vulnerable. Synthetic token only. A clean scan is evidence for triage — not proof the software is secure.</p>
      </section>

      <section class="deck-slide" data-title="Clone" data-notes="Hands up when Actions shows five jobs. Unit tests green; scanners red expected.">
        <div class="slide-num">04</div>
        <h2 class="say">Use this template → your public repo.</h2>
        <p class="talk">Open <code>bsbcyber/secure-dev-lab</code>. Create under your account. Do not enable Pages.</p>
        <p class="cta-link"><a href={lab} target="_blank" rel="noreferrer">github.com/bsbcyber/secure-dev-lab ↗</a></p>
      </section>

      <section class="deck-slide" data-title="First run" data-notes="Ask: is a red Semgrep job a broken lab?">
        <div class="slide-num">05</div>
        <h2 class="say">Actions → Security Lab. Red scanners are expected.</h2>
        <p class="talk">Unit tests should pass. Semgrep, OSV, Gitleaks, and zizmor should fail with findings — not empty logs or pull errors.</p>
      </section>

      <section class="deck-slide statement" data-title="Finding vs failure" data-notes="Write this distinction on the board if needed.">
        <div class="slide-num">06</div>
        <h2 class="say">A finding finished the scan. A failure never started one.</h2>
        <p class="talk">Record tool, rule/advisory, file, and next action. Setup errors get a re-run — not a code guess.</p>
      </section>

      <section class="deck-slide" data-title="Actions anatomy" data-notes="Open security-lab.yml on the projector. Point at on:, jobs, runs-on, steps.">
        <div class="slide-num">07</div>
        <h2 class="say">Trigger → job → runner → step → exit code.</h2>
        <p class="path-line"><code>.github</code> <span>→</span> <code>workflows</code> <span>→</span> <strong>security-lab.yml</strong></p>
        <p class="talk">Docs-only pushes are ignored. Scanners are digest-pinned containers. Nonzero exit can mean findings or a broken tool.</p>
      </section>

      <section class="deck-slide" data-title="Tool map" data-notes="Leave this up while people fill their finding table.">
        <div class="slide-num">08</div>
        <h2 class="say">Four scanners, four questions.</h2>
        <ul class="about-list">
          <li><strong>Semgrep</strong> — does this code pattern look dangerous?</li>
          <li><strong>OSV-Scanner</strong> — is a dependency known-vulnerable?</li>
          <li><strong>Gitleaks</strong> — does this look like a secret?</li>
          <li><strong>zizmor</strong> — is this workflow configured unsafely?</li>
        </ul>
      </section>

      <section class="deck-slide" data-title="SAST" data-notes="Demo previewExpression. Ask why allowlists beat writing a mini language.">
        <div class="slide-num">09</div>
        <h2 class="say">SAST: Semgrep finds <code class="hl">eval</code> in <code>profile.js</code>.</h2>
        <p class="talk">Replace <code>previewExpression</code> with a narrow allowlist or safe parser. Update tests for accept and reject. Re-run Semgrep + unit tests.</p>
      </section>

      <section class="deck-slide" data-title="SAST checkpoint" data-notes="Circulate. Do not advance until most hands are up.">
        <div class="slide-num">10</div>
        <h2 class="say">Checkpoint: Semgrep green, tests green.</h2>
        <p class="talk">If you’re stuck, show the Semgrep job log — not just “it failed.”</p>
      </section>

      <section class="deck-slide statement" data-title="Break" data-notes="Catch-up. Optional labeled demo of validation/fixed-baseline.">
        <div class="slide-num">11</div>
        <h2 class="say">Break. Catch up. Don’t copy the fixed branch onto main.</h2>
      </section>

      <section class="deck-slide" data-title="SCA" data-notes="Show advisory IDs from a live run. Emphasize 4.17.23 lesson.">
        <div class="slide-num">12</div>
        <h2 class="say">SCA: OSV reads the lockfile — not your hopes.</h2>
        <p class="talk">Update <code>package.json</code> and <code>package-lock.json</code> together. Verify today’s fixed version. A “newer” version can still be vulnerable.</p>
      </section>

      <section class="deck-slide" data-title="SCA checkpoint" data-notes="If lockfiles explode, give the tested version from morning notes.">
        <div class="slide-num">13</div>
        <h2 class="say">Checkpoint: OSV green after a verified bump.</h2>
        <p class="talk">Prefer <code>npm install lodash@&lt;fixed&gt;</code> over hand-editing a huge lockfile.</p>
      </section>

      <section class="deck-slide" data-title="Secrets" data-notes="Ask: if this were real, what else must you do after deleting the line?">
        <div class="slide-num">14</div>
        <h2 class="say">Secrets: clear the synthetic token. Logs stay redacted.</h2>
        <p class="talk">Edit <code>fixtures/synthetic-secret.txt</code>. Removing a line from HEAD is not revoke-and-rotate — teach the history caveat.</p>
      </section>

      <section class="deck-slide" data-title="Workflow" data-notes="Stress: fixture stays outside .github/workflows.">
        <div class="slide-num">15</div>
        <h2 class="say">Workflow security: fix the inert fixture only.</h2>
        <p class="talk"><code>lab-fixtures/insecure-workflow.yml</code> — pin checkout SHA, <code>persist-credentials: false</code>, narrow permissions. Never execute it.</p>
      </section>

      <section class="deck-slide" data-title="PR" data-notes="Reuse Workshop 1 PR muscle memory.">
        <div class="slide-num">16</div>
        <h2 class="say">Open a PR and watch the checks again.</h2>
        <p class="talk">Branch → small change → pull request. A failed check is something to read, not something to ignore.</p>
      </section>

      <section class="deck-slide" data-title="Resume" data-notes="Show an example bullet. Lab stays separate from Pages resume site.">
        <div class="slide-num">17</div>
        <h2 class="say">Put a case study on your Workshop 1 resume site.</h2>
        <p class="talk">Name the tools, one finding, the fix, and a link to <em>your</em> lab repo. Do not deploy the lab or merge it into the resume app.</p>
      </section>

      <section class="deck-slide" data-title="Lab" data-notes="Leave this up for the last stretch.">
        <div class="slide-num">18</div>
        <h2 class="say">Lab: finish remediations, then the resume link.</h2>
        <p class="talk">Priority if behind: Semgrep + OSV. Stretch: Gitleaks, zizmor, fuller case study. Stuck? Show the job log and your finding table.</p>
      </section>

      <section class="deck-slide statement" data-title="Exit" data-notes="Collect: one explained finding + resume URL or PR.">
        <div class="slide-num">19</div>
        <h2 class="say">Exit: explain one finding. Show the resume link.</h2>
        <p class="talk">A clean scan helps you triage. It does not mean “secure forever.”</p>
      </section>

    </div>

    <div class="deck-notes no-print" id="deck-notes" hidden>
      <div class="notes-label"><span>FACILITATOR NOTES</span><button class="deck-tool" data-toggle="notes">Hide notes ×</button></div>
      <p id="notes-content"></p>
    </div>

    <footer class="deck-controls no-print">
      <div class="deck-controls-left">
        <button class="control-btn" id="prev-slide" aria-label="Previous slide">←</button>
        <button class="control-btn primary-control" id="next-slide" aria-label="Next slide">→</button>
        <span id="slide-title" class="deck-current-title">Cover</span>
      </div>
      <div class="slide-progress">
        <span id="slide-index">01</span>
        <span class="progress-track"><i id="progress-fill"></i></span>
        <span id="slide-total">19</span>
      </div>
      <div class="deck-controls-right">
        <button class="deck-tool" data-toggle="resources">Resources <kbd>R</kbd></button>
        <button class="deck-tool" data-fullscreen>Full screen <kbd>F</kbd></button>
      </div>
    </footer>

    <dialog class="resource-dialog" id="resource-dialog">
      <div class="resource-drawer-grid">
        <section>
          <h3>Students</h3>
          <a href={base + 'student-guide-2/'} target="_blank" rel="noreferrer"><b>Walkthrough</b><small>Step-by-step lab</small></a>
          <a href={base + 'workshop-2/'} target="_blank" rel="noreferrer"><b>Agenda</b><small>Checklist + timing</small></a>
          <a href={lab} target="_blank" rel="noreferrer"><b>Lab template</b><small>Use this template</small></a>
        </section>
        <section>
          <h3>Facilitator</h3>
          <a href={base + 'downloads/workshop-2-presentation.pptx'} target="_blank" rel="noreferrer"><b>PowerPoint</b><small>Offline export</small></a>
          <a href="https://github.com/bsbcyber/workshop-site/blob/main/FACILITATOR-GUIDE-W2.md" target="_blank" rel="noreferrer"><b>Facilitator guide</b><small>Full playbook</small></a>
          <a href={lab + '/tree/validation/fixed-baseline'} target="_blank" rel="noreferrer"><b>Fixed baseline</b><small>Labeled catch-up demo</small></a>
        </section>
      </div>
      <div class="resource-dialog-foot">
        <span>Press <kbd>R</kbd> to close</span>
        <button class="btn primary" data-close-resources>Back to deck</button>
      </div>
    </dialog>
  </div>
</div>

<style>
.presentation-page{padding-top:18px;padding-bottom:28px}
.presentation-intro{display:flex;align-items:center;justify-content:space-between;gap:22px;padding:16px 0 18px}
.presentation-intro h1{font:700 clamp(30px,4vw,46px)/1.05 'Titillium Web',sans-serif;letter-spacing:-.035em;margin:8px 0}
.presentation-intro p{margin:0;color:var(--muted);font-size:14px;line-height:1.5;max-width:700px}
.presentation-root{position:relative;background:#050505;color:#fff;border:1px solid #292929;border-radius:8px;overflow:hidden;box-shadow:0 18px 54px #0002}
.deck-topbar{height:54px;background:#101010;border-bottom:1px solid #303030;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 18px}
.deck-brand{display:flex;align-items:center;gap:10px;text-decoration:none;font:700 11px 'Titillium Web',sans-serif;letter-spacing:.08em;flex-shrink:0}
.deck-mark{width:28px;height:28px;background:#FFDB00;color:#000;display:grid;place-items:center;font-size:16px;font-weight:700}
.deck-brand small{display:block;font:10px 'Roboto',sans-serif;letter-spacing:.11em;color:#bdbdbd;margin-top:3px}
.deck-tools,.deck-controls-left,.deck-controls-right{display:flex;align-items:center;gap:8px}
.deck-tool{display:inline-flex;align-items:center;gap:7px;background:transparent;border:1px solid #444;color:#ededed;border-radius:5px;padding:7px 9px;cursor:pointer;font:500 11px 'Roboto',sans-serif}
.deck-tool:hover{border-color:#FFDB00;color:#FFDB00}
.deck-tool kbd,.resource-dialog-foot kbd{background:#2b2b2b;border:1px solid #575757;color:#fff;border-radius:3px;padding:2px 5px;font:10px 'Roboto',sans-serif}
.deck-stage{position:relative}
.deck-slide{aspect-ratio:16/9;min-height:520px;max-height:calc(100vh - 195px);overflow:hidden;background:#fff;color:#131313;position:relative;padding:clamp(36px,4.5vw,64px) clamp(40px,5.5vw,80px) 48px;display:flex;flex-direction:column;gap:clamp(16px,2vw,24px);font-family:'Roboto',Arial,sans-serif;justify-content:center}
.deck-slide[hidden],.deck-slide:not(.is-active){display:none!important}
.deck-slide code{font:.92em/inherit 'DM Mono',ui-monospace,monospace;background:#f0f0ec;border:0;border-radius:3px;padding:0 .28em;vertical-align:baseline}
.slide-num{position:absolute;top:clamp(24px,3vw,40px);right:clamp(40px,5.5vw,80px);font:700 13px 'Titillium Web',sans-serif;letter-spacing:.08em;color:#999}
.say{font:700 clamp(32px,4.4vw,54px)/1.22 'Titillium Web',sans-serif;letter-spacing:-.035em;margin:0;color:#080808;max-width:20ch}
.say code,.say code.hl{font:inherit;font-weight:700;letter-spacing:inherit;color:inherit;background:transparent;border:0;border-radius:0;padding:0 .06em;box-shadow:inset 0 -.28em 0 #FFDB00;vertical-align:baseline}
.talk{margin:0;font:400 clamp(17px,1.7vw,22px)/1.5 'Roboto',sans-serif;color:#333;max-width:38rem}
.cta-link{margin:4px 0 0}
.cta-link a{font:700 20px 'Titillium Web',sans-serif;color:#111;text-underline-offset:4px}
.path-line{margin:4px 0;font:700 clamp(22px,2.6vw,34px)/1.35 'Titillium Web',sans-serif;color:#111}
.path-line span{color:#bbb;font-weight:400;margin:0 .15em}
.path-line code{font:inherit;font-weight:700;background:transparent;border:0;padding:0;color:#111}
.path-line strong{background:#FFDB00;padding:0 .18em;border-radius:2px}
.about-list{margin:0;padding:0;list-style:none;display:grid;gap:12px;max-width:40rem}
.about-list li{font:400 clamp(17px,1.7vw,22px)/1.45 'Roboto',sans-serif;color:#333;padding-left:14px;border-left:3px solid #FFDB00}
.about-list strong{font-weight:700;color:#111}
.deck-slide.statement{justify-content:center}
.deck-slide.statement .say{max-width:22ch}
.cover-slide{background:#090909;color:#fff;justify-content:center}
.cover-slide .slide-num{color:#555}
.cover-body{max-width:920px}
.cover-kicker{margin:0 0 18px;font:600 13px 'Roboto',sans-serif;letter-spacing:.04em;color:#aaa}
.cover-body h2{font:700 clamp(40px,5.5vw,68px)/1.02 'Titillium Web',sans-serif;letter-spacing:-.04em;margin:0 0 18px;color:#fff;max-width:16ch}
.cover-line{margin:0;font:400 20px/1.45 'Roboto',sans-serif;color:#cfcfcf;max-width:34rem}
.deck-controls{min-height:58px;background:#101010;border-top:1px solid #303030;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:0 14px}
.control-btn{appearance:none;border:1px solid #555;background:#1a1a1a;color:#fff;width:40px;height:36px;border-radius:4px;cursor:pointer;font-size:16px}
.control-btn:hover{border-color:#FFDB00;color:#FFDB00}
.control-btn:disabled{opacity:.35;cursor:default}
.primary-control{background:#FFDB00;border-color:#FFDB00;color:#000}
.deck-current-title{font:600 13px 'Roboto',sans-serif;color:#ddd;max-width:340px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.slide-progress{display:flex;align-items:center;gap:10px;font:700 11px 'Titillium Web',sans-serif;color:#aaa}
.progress-track{width:120px;height:4px;background:#333;border-radius:99px;overflow:hidden}
.progress-track i{display:block;height:100%;width:0;background:#FFDB00}
.deck-notes{border-top:1px solid #303030;background:#161616;padding:12px 18px 16px}
.notes-label{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font:700 10px 'Titillium Web',sans-serif;letter-spacing:.12em;color:#FFDB00}
#notes-content{margin:0;font:14px/1.5 'Roboto',sans-serif;color:#ddd}
.resource-dialog{border:0;padding:0;width:min(920px,92vw);background:#111;color:#fff;border-radius:8px}
.resource-dialog::backdrop{background:#000a}
.resource-drawer-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;padding:22px}
.resource-drawer-grid h3{font:700 12px 'Titillium Web',sans-serif;letter-spacing:.1em;color:#FFDB00;margin:0 0 10px}
.resource-drawer-grid a{display:block;text-decoration:none;color:#fff;padding:10px 0;border-bottom:1px solid #333}
.resource-drawer-grid a b{display:block;font:700 15px 'Titillium Web',sans-serif}
.resource-drawer-grid a small{color:#aaa}
.resource-dialog-foot{display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-top:1px solid #333}
.presentation-root:fullscreen{border-radius:0;width:100%;height:100%}
.presentation-root:fullscreen .deck-stage{flex:1;min-height:0}
.presentation-root:fullscreen .deck-slide{width:100%;height:100%;max-height:none;min-height:0;aspect-ratio:auto}
@media print{
  .presentation-intro,.deck-topbar,.deck-controls,.deck-notes,.resource-dialog{display:none!important}
  .deck-slide{display:flex!important;aspect-ratio:16/9;break-after:page}
  .deck-slide[hidden],.deck-slide:not(.is-active){display:flex!important}
}
</style>

<script>
const root=document.querySelector('#presentation-root');
const slides=[...root.querySelectorAll('.deck-slide')];
let index=0;
const prev=document.querySelector('#prev-slide'), next=document.querySelector('#next-slide');
const notes=document.querySelector('#deck-notes'), notesContent=document.querySelector('#notes-content');
const title=document.querySelector('#slide-title'), idx=document.querySelector('#slide-index'), fill=document.querySelector('#progress-fill');
const total=document.querySelector('#slide-total');
total.textContent=String(slides.length).padStart(2,'0');
const resourceDialog=document.querySelector('#resource-dialog');
function render(){
  slides.forEach((s,i)=>{const active=i===index;s.hidden=!active;s.classList.toggle('is-active',active);if(active)s.setAttribute('aria-current','step');else s.removeAttribute('aria-current')});
  const s=slides[index];
  title.textContent=s.dataset.title||'Workshop 2';
  idx.textContent=String(index+1).padStart(2,'0');
  fill.style.width=((index+1)/slides.length*100)+'%';
  prev.disabled=index===0; next.disabled=index===slides.length-1;
  notesContent.textContent=s.dataset.notes||'';
  if(root.matches(':fullscreen')) document.title=(index+1)+' / '+slides.length+' · '+(s.dataset.title||'Workshop 2');
  else document.title='Workshop 2 facilitator deck · MIS Club';
}
function change(n){index=Math.max(0,Math.min(slides.length-1,n));render()}
function toggleFullscreen(){if(!document.fullscreenElement){root.requestFullscreen?.().catch(()=>{});}else{document.exitFullscreen?.();}}
function toggleResources(){if(resourceDialog.open)resourceDialog.close();else resourceDialog.showModal();}
function toggleNotes(){notes.hidden=!notes.hidden; if(!notes.hidden)notesContent.textContent=slides[index].dataset.notes||'';}
prev.addEventListener('click',()=>change(index-1));next.addEventListener('click',()=>change(index+1));
document.querySelectorAll('[data-fullscreen]').forEach(b=>b.addEventListener('click',toggleFullscreen));
document.querySelectorAll('[data-toggle="resources"]').forEach(b=>b.addEventListener('click',toggleResources));
document.querySelectorAll('[data-toggle="notes"]').forEach(b=>b.addEventListener('click',toggleNotes));
document.querySelectorAll('[data-close-resources]').forEach(b=>b.addEventListener('click',()=>resourceDialog.close()));
resourceDialog.addEventListener('click',e=>{if(e.target===resourceDialog)resourceDialog.close()});
document.addEventListener('fullscreenchange',()=>{const on=!!document.fullscreenElement;document.querySelectorAll('[data-fullscreen]').forEach(b=>{b.innerHTML=on?'Exit full screen <kbd>F</kbd>':'Full screen <kbd>F</kbd>'});render()});
document.addEventListener('keydown',e=>{
 if(resourceDialog.open){if(e.key==='Escape')resourceDialog.close();return}
 if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName))return;
 if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '){e.preventDefault();change(index+1)}
 else if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();change(index-1)}
 else if(e.key==='Home'){e.preventDefault();change(0)}
 else if(e.key==='End'){e.preventDefault();change(slides.length-1)}
 else if(e.key.toLowerCase()==='f'){e.preventDefault();toggleFullscreen()}
 else if(e.key.toLowerCase()==='r'){e.preventDefault();toggleResources()}
 else if(e.key.toLowerCase()==='n'){e.preventDefault();toggleNotes()}
});
render();
</script>
</BaseLayout>
