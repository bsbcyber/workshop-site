---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const terms = [
 {term:'Repository',group:'Git',definition:'The project files together with their change history.',remember:'The home for the project: files plus history.'},
 {term:'Working tree',group:'Git',definition:'The version of files on your computer right now.',remember:'Run git status to see what differs from the last commit.'},
 {term:'Stage',group:'Git',definition:'Choose which edits will be included in the next commit.',remember:'Staging is a selection step, not an upload.'},
 {term:'Commit',group:'Git',definition:'A named snapshot in local repository history.',remember:'A commit does not automatically reach GitHub.'},
 {term:'Branch',group:'Git',definition:'A named line of work for a task or feature.',remember:'Make a feature branch so the change can be reviewed separately.'},
 {term:'Remote',group:'Git',definition:'Another copy of a repository, usually hosted on GitHub.',remember:'git push sends commits to the configured remote.'},
 {term:'Issue',group:'GitHub',definition:'A place to describe a task, problem, or outcome before coding.',remember:'Write acceptance criteria that someone else can verify.'},
 {term:'Pull request',group:'GitHub',definition:'A review page comparing your branch with its target branch.',remember:'Read Files changed and check the issue before merging.'},
 {term:'Diff',group:'Git / review',definition:'A line-by-line view of what was added, changed, or removed.',remember:'git diff shows unstaged edits; git diff --staged shows staged edits.'},
 {term:'Build',group:'Delivery',definition:'The step that turns source files into output ready to publish.',remember:'The build can fail even when the local editor looks fine.'},
 {term:'Workflow',group:'Delivery',definition:'A sequence of automated jobs and steps, often run by GitHub Actions.',remember:'Open the run and find the failed step; do not guess.'},
 {term:'Deploy',group:'Delivery',definition:'Publish the built output so other people can open it.',remember:'Wait for the deployment to finish, then open the published URL in a browser.'}
];
---
<BaseLayout title="Workshop field guide" description="An interactive plain-language field guide to Git, GitHub, code review, and deployment.">
<div class="container resource-guide">
  <section class="page-hero resource-hero">
    <div class="eyebrow">Workshop 01 · Field reference</div>
    <h1>Git and GitHub.<br/>Quick reference.</h1>
    <p>Use this page when you need a definition or aren’t sure what to do next. Search a term, review the workflow steps, or choose an error to find a suggested check.</p>
    <div class="actions"><a class="btn primary" href={base+'student-guide/'}>Back to the student walkthrough ↗</a><a class="btn" href={base+'slides/'}>Open the slides ↗</a></div>
  </section>

  <section class="workflow-lab" aria-labelledby="workflow-lab-title">
    <div class="lab-top"><div><div class="eyebrow">Interactive workflow</div><h2 id="workflow-lab-title">Follow a change from an issue to a published site.</h2></div><p>Select a stage to see the related command, explanation, and product screenshot.</p></div>
    <div class="phase-selector" role="group" aria-label="Choose a workflow stage">
      {['Describe','Change','Review','Publish'].map((name,i)=><button type="button" class:list={['phase-button',i===0?'is-active':'']} data-phase={i} aria-pressed={i===0?'true':'false'}><span>{['01 / TASK','02 / LOCAL','03 / GITHUB','04 / LIVE'][i]}</span><b>{name}</b></button>)}
    </div>
    <div class="phase-detail">
      <div class="phase-copy"><div class="eyebrow" id="phase-stage">01 / TASK</div><h3 id="phase-title">Define the change before you code.</h3><p id="phase-body">Create an issue with a goal and observable acceptance criteria. Avoid vague tasks such as “make it better.”</p><div class="phase-example"><div><span>EXAMPLE</span><button id="copy-phase-example" type="button">Copy</button></div><pre id="phase-example">Issue: Add a featured project
Done means: title, honest summary, working link, mobile layout.</pre></div><a id="phase-source" href="https://docs.github.com/en/issues/tracking-your-work-with-issues/using-issues/creating-an-issue" target="_blank" rel="noreferrer">GitHub issue guide ↗</a></div>
      <figure class="phase-screen"><div class="screen-heading"><span>OFFICIAL PRODUCT SCREENSHOT</span><span id="phase-image-caption">Real GitHub issue form</span></div><img id="phase-image" src="https://docs.github.com/assets/images/help/issues/issue-title-body.png" alt="Official GitHub screenshot of the issue form with title and body fields." loading="lazy"/><figcaption>Product interfaces change over time. Follow the linked source for the current step-by-step instructions.</figcaption></figure>
    </div>
  </section>

  <section class="vocabulary-section">
    <div class="section-head"><div><div class="eyebrow">Plain-English vocabulary</div><h2>Common terms, explained.</h2><p>Search for a term or filter by tool. The note under each definition explains what to remember while you work.</p></div><span class="term-total" id="term-count" aria-live="polite">12 TERMS</span></div>
    <div class="term-tools">
      <label class="term-search"><span>SEARCH TERMS</span><input id="term-search" type="search" placeholder="Try “stage”, “remote”, or “build”" autocomplete="off"/></label>
      <div class="term-filters" role="group" aria-label="Filter vocabulary">
        <button type="button" class="term-filter is-active" data-term-filter="all" aria-pressed="true">All terms</button><button type="button" class="term-filter" data-term-filter="Git" aria-pressed="false">Git</button><button type="button" class="term-filter" data-term-filter="GitHub" aria-pressed="false">GitHub</button><button type="button" class="term-filter" data-term-filter="Delivery" aria-pressed="false">Delivery</button>
      </div>
    </div>
    <p id="term-empty" class="term-empty" hidden>No terms match. Try another word or clear the search.</p>
    <div class="terms-grid" id="terms-grid">
      {terms.map((item,i)=><article class="term-card" data-term={item.term.toLowerCase()} data-group={item.group}><div class="term-index">{String(i+1).padStart(2,'0')}</div><div class="term-main"><div class="term-line"><h3>{item.term}</h3><span>{item.group}</span></div><p>{item.definition}</p><div class="remember"><b>REMEMBER</b><span>{item.remember}</span></div></div></article>)}
    </div>
  </section>

  <section class="recovery-section">
    <div class="section-head"><div><div class="eyebrow">When something breaks</div><h2>When something goes wrong, start here.</h2><p>Choose the problem that matches what you see. Run the suggested check before changing files or settings.</p></div></div>
    <div class="recovery-picker" role="group" aria-label="Choose the problem"><button type="button" class="recovery-choice is-active" data-recovery="git" aria-pressed="true">Git / push problem</button><button type="button" class="recovery-choice" data-recovery="build" aria-pressed="false">Build failed</button><button type="button" class="recovery-choice" data-recovery="404" aria-pressed="false">Live site is 404</button><button type="button" class="recovery-choice" data-recovery="assets" aria-pressed="false">Styles / images missing</button></div>
    <div class="recovery-result" aria-live="polite"><div class="recovery-code"><div class="recovery-code-head"><span>START WITH THIS</span><button type="button" id="copy-recovery-command">Copy command</button></div><pre id="recovery-command">git status
git remote -v</pre></div><div><div class="eyebrow" id="recovery-label">GIT / PUSH PROBLEM</div><h3 id="recovery-title">Confirm your branch and remote.</h3><p id="recovery-copy">Check the branch and remote before retrying. Don’t force-push or add another remote unless you know why it’s needed.</p><a id="recovery-link" href={base+'student-guide/#step-5'}>Open the related step ↗</a></div></div>
    <div class="recovery-foot"><b>Rule of thumb</b><span>One symptom → one hypothesis → one small fix → rerun the check.</span></div>
  </section>

  <section class="field-guide-footer"><div><div class="eyebrow">Use this reference as you work.</div><h2>The same steps work on your next project.</h2><p>Check the current state, make one change, inspect the result, and test before publishing.</p></div><a class="btn primary" href={base+'student-guide/'}>Back to the student walkthrough →</a></section>
</div>
<style>
.resource-guide{padding-bottom:65px}.resource-hero{padding:49px 0 32px;border-bottom:1px solid #d5d5d0}.resource-hero h1{font:700 clamp(42px,6vw,65px)/.99 'Titillium Web',sans-serif;letter-spacing:-.04em}.resource-hero p{max-width:760px}
.workflow-lab{margin:36px 0 56px;background:#111;color:#f6f6f0;padding:clamp(20px,3.6vw,36px);border-top:5px solid #FFDB00}
.lab-top{display:flex;justify-content:space-between;align-items:flex-end;gap:24px}.lab-top .eyebrow{color:#FFDB00}.lab-top h2{font:700 clamp(26px,3.5vw,38px)/1.04 'Titillium Web',sans-serif;letter-spacing:-.025em;margin:8px 0 0;max-width:600px}.lab-top>p{max-width:380px;color:#c9c9c3;font:12px/1.6 'Roboto',sans-serif;margin:0}
.phase-selector{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:25px 0 16px}.phase-button{display:grid;gap:5px;justify-items:start;text-align:left;padding:11px 13px;background:#20201d;color:#e7e7e1;border:1px solid #4a4a44;cursor:pointer;transition:background .2s,border-color .2s}.phase-button>span{font:700 8px 'DM Mono',monospace;letter-spacing:.08em;color:#aaa}.phase-button>b{font:700 14px 'Titillium Web',sans-serif}.phase-button:hover,.phase-button.is-active{background:#FFDB00;border-color:#FFDB00;color:#111}.phase-button.is-active>span{color:#3f3f39}
.phase-detail{display:grid;grid-template-columns:.84fr 1.16fr;gap:22px;border-top:1px solid #474741;padding-top:19px}.phase-copy .eyebrow{color:#FFDB00}.phase-copy h3{font:700 22px/1.12 'Titillium Web',sans-serif;margin:8px 0}.phase-copy>p{font:12px/1.65 'Roboto',sans-serif;color:#ccc;margin:0 0 17px}.phase-example{border:1px solid #55554e;background:#20201d}.phase-example>div{display:flex;justify-content:space-between;align-items:center;padding:7px 9px;border-bottom:1px solid #45453f}.phase-example>div>span{font:700 8px 'Titillium Web',sans-serif;letter-spacing:.1em;color:#aaa}.phase-example button{background:transparent;border:1px solid #77776e;color:#fff;padding:4px 7px;cursor:pointer;font:9px 'Roboto',sans-serif}.phase-example pre{white-space:pre-wrap;overflow-wrap:anywhere;font:10px/1.65 'DM Mono',monospace;color:#f2f2ec;padding:12px;margin:0}#phase-source{display:inline-block;margin-top:12px;color:#FFDB00;font:700 10px 'Roboto',sans-serif;text-underline-offset:3px}
.phase-screen{border:1px solid #41413b;margin:0;padding:9px;background:#20201e;min-width:0}.screen-heading{display:flex;justify-content:space-between;gap:9px;align-items:center;flex-wrap:wrap;font:700 8px 'Titillium Web',sans-serif;letter-spacing:.07em;color:#c9c9c1;padding:1px 0 8px}.screen-heading span:first-child{color:#FFDB00}.phase-screen img{width:100%;height:auto;max-height:390px;object-fit:contain;object-position:top center;display:block;background:#fafaf9}.phase-screen figcaption{font:10px/1.5 'Roboto',sans-serif;color:#bdbdb6;padding:8px 0 1px}
.vocabulary-section,.recovery-section{padding-top:20px;margin-top:34px}.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:25px;margin-bottom:17px}.section-head .eyebrow{color:#55554e}.section-head h2{font:700 clamp(29px,4vw,41px)/1.04 'Titillium Web',sans-serif;letter-spacing:-.03em;margin:7px 0}.section-head p{font:12px/1.6 'Roboto',sans-serif;color:#5c5c56;max-width:720px;margin:0}.term-total{font:700 9px 'DM Mono',monospace;color:#555;background:#e9e9e4;padding:8px 10px;white-space:nowrap}
.term-tools{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:20px 0 14px}.term-search{display:grid;gap:6px;flex:1;max-width:460px}.term-search span{font:700 9px 'Titillium Web',sans-serif;letter-spacing:.1em;color:#555}.term-search input{height:40px;width:100%;border:1px solid #c8c8c1;border-radius:3px;background:#fff;padding:0 12px;font:12px 'Roboto',sans-serif;color:#111}.term-filters{display:flex;gap:5px;flex-wrap:wrap}.term-filter{border:1px solid #c9c9c2;background:#fff;color:#333;padding:9px 11px;border-radius:3px;font:600 10px 'Roboto',sans-serif;cursor:pointer}.term-filter:hover,.term-filter.is-active{background:#111;color:#fff;border-color:#111}
.terms-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 28px;border-top:2px solid #111}.term-card{display:grid;grid-template-columns:30px 1fr;gap:10px;padding:17px 0;border-bottom:1px solid #d5d5cf;min-width:0}.term-card[hidden]{display:none}.term-index{font:700 10px 'DM Mono',monospace;color:#888;padding-top:3px}.term-line{display:flex;justify-content:space-between;align-items:baseline;gap:10px}.term-line h3{font:700 17px 'Titillium Web',sans-serif;margin:0}.term-line span{font:700 8px 'Titillium Web',sans-serif;letter-spacing:.07em;color:#666;text-align:right}.term-main>p{font:12px/1.55 'Roboto',sans-serif;color:#555;margin:5px 0 10px}.remember{display:grid;grid-template-columns:88px 1fr;gap:9px;border-top:1px solid #e5e5e0;padding-top:8px}.remember b{font:700 8px 'Titillium Web',sans-serif;letter-spacing:.1em;color:#666}.remember span{font:11px/1.5 'Roboto',sans-serif;color:#30302b}.term-empty{border:1px dashed #aaa;padding:18px;color:#555;font:12px 'Roboto',sans-serif}
.recovery-picker{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:20px 0 14px}.recovery-choice{background:#fff;color:#111;border:1px solid #cfcfc8;text-align:left;padding:13px 12px;font:700 11px 'Titillium Web',sans-serif;cursor:pointer}.recovery-choice:hover,.recovery-choice.is-active{background:#FFDB00;border-color:#111}.recovery-result{display:grid;grid-template-columns:.7fr 1.3fr;gap:24px;background:#fff;border:1px solid #d5d5d0;padding:20px}.recovery-code{background:#171717;color:#fff;padding:13px;min-width:0}.recovery-code-head{display:flex;justify-content:space-between;align-items:center;gap:8px}.recovery-code-head>span{font:700 8px 'Titillium Web',sans-serif;letter-spacing:.1em;color:#FFDB00}.recovery-code-head button{background:transparent;border:1px solid #77776e;color:#fff;padding:5px 7px;font:9px 'Roboto',sans-serif;cursor:pointer}.recovery-code pre{font:11px/1.7 'DM Mono',monospace;white-space:pre-wrap;overflow-wrap:anywhere}.recovery-result .eyebrow{color:#666}.recovery-result h3{font:700 22px 'Titillium Web',sans-serif;margin:6px 0}.recovery-result p{font:12px/1.65 'Roboto',sans-serif;color:#555}.recovery-result a{font:700 10px 'Roboto',sans-serif;text-underline-offset:3px}.recovery-foot{display:flex;gap:15px;align-items:center;padding:13px 0;border-top:1px solid #d5d5d0;margin-top:13px;font:11px 'Roboto',sans-serif;color:#555}.recovery-foot b{font:700 10px 'Titillium Web',sans-serif;color:#111}
.field-guide-footer{display:flex;justify-content:space-between;align-items:center;gap:25px;margin:62px 0 0;border-top:4px solid #111;padding:24px 0 0}.field-guide-footer .eyebrow{color:#555}.field-guide-footer h2{font:700 clamp(28px,4vw,40px)/1.05 'Titillium Web',sans-serif;margin:7px 0}.field-guide-footer p{font:12px/1.6 'Roboto',sans-serif;color:#555;margin:0}.field-guide-footer .btn{flex-shrink:0}
@media(max-width:850px){.lab-top{align-items:flex-start;flex-direction:column}.phase-detail{grid-template-columns:1fr}.phase-screen img{max-height:480px}.term-tools{align-items:stretch;flex-direction:column}.term-search{max-width:none}.section-head{align-items:flex-start;flex-direction:column}.recovery-picker{grid-template-columns:1fr 1fr}.recovery-result{grid-template-columns:1fr}.field-guide-footer{align-items:flex-start;flex-direction:column}}
@media(max-width:600px){.resource-hero{padding-top:35px}.phase-selector{grid-template-columns:1fr 1fr}.terms-grid{grid-template-columns:1fr}.term-line{align-items:flex-start;flex-direction:column;gap:3px}.remember{grid-template-columns:80px 1fr}.recovery-picker{grid-template-columns:1fr}.recovery-result{padding:13px}.phase-detail{gap:15px}.workflow-lab{margin-top:22px}}
@media(prefers-reduced-motion:reduce){.phase-button{transition:none}}
</style>
<script>
const phaseContent=[{"name":"Describe","stage":"01 / TASK","title":"Give the change a clear target.","body":"Create an issue with a goal and observable acceptance criteria. Avoid vague tasks such as “make it better.”","example":"Issue: Add a featured project\nDone means: title, honest summary, working link, mobile layout.","image":"https://docs.github.com/assets/images/help/issues/issue-title-body.png","alt":"Official GitHub screenshot of the issue form with title and body fields.","caption":"Real GitHub issue form","href":"https://docs.github.com/en/issues/tracking-your-work-with-issues/using-issues/creating-an-issue","link":"GitHub issue guide"},{"name":"Change","stage":"02 / LOCAL","title":"Edit one task, inspect the diff.","body":"Make the smallest useful change on a feature branch. Use Git or the VS Code Source Control view to see exactly what changed.","example":"git status\ngit diff\ngit add src/data/profile.js\ngit diff --staged","image":"https://code.visualstudio.com/assets/docs/sourcecontrol/overview/overview.png","alt":"Official VS Code screenshot showing Source Control staged changes and the side-by-side diff editor.","caption":"Real VS Code Source Control + diff","href":"https://code.visualstudio.com/docs/sourcecontrol/overview","link":"VS Code Source Control guide"},{"name":"Review","stage":"03 / GITHUB","title":"Compare the branch before merging.","body":"Push your branch, open a pull request, explain how you tested the change, and read the Files changed tab. Merge only when the criteria are met.","example":"PR summary:\nWhat changed?\nHow did I verify it?\nWhich acceptance criteria pass?","image":"https://docs.github.com/assets/images/help/pull_requests/diff-settings-menu.png","alt":"Official GitHub screenshot of the Files changed tab and diff controls for a pull request.","caption":"Real GitHub pull request diff","href":"https://docs.github.com/en/pull-requests/how-tos/review-pull-requests/reviewing-proposed-changes-in-a-pull-request","link":"Pull request review guide"},{"name":"Publish","stage":"04 / LIVE","title":"Read the workflow, then check the URL.","body":"A merge to main triggers the prepared workflow. Open the latest Actions run, expand the failed step if needed, and test the deployed website.","example":"npm run build\n# inspect the Actions run\n# open and test the published URL","image":"https://docs.github.com/assets/images/help/repository/actions-quickstart-log-detail.png","alt":"Official GitHub Actions screenshot showing expanded job output from a workflow step.","caption":"Real GitHub Actions step log","href":"https://docs.github.com/en/actions/how-tos/monitor-workflows/use-workflow-run-logs","link":"Actions log guide"}];
const phaseButtons=[...document.querySelectorAll('[data-phase]')];
const phaseStage=document.querySelector('#phase-stage'),phaseTitle=document.querySelector('#phase-title'),phaseBody=document.querySelector('#phase-body'),phaseExample=document.querySelector('#phase-example'),phaseImage=document.querySelector('#phase-image'),phaseImageCaption=document.querySelector('#phase-image-caption'),phaseSource=document.querySelector('#phase-source');
phaseButtons.forEach(button=>button.addEventListener('click',()=>{
 const item=phaseContent[Number(button.dataset.phase)];
 phaseButtons.forEach(b=>{const active=b===button;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active))});
 phaseStage.textContent=item.stage;phaseTitle.textContent=item.title;phaseBody.textContent=item.body;phaseExample.textContent=item.example;phaseImage.src=item.image;phaseImage.alt=item.alt;phaseImageCaption.textContent=item.caption;phaseSource.href=item.href;phaseSource.textContent=item.link+' ↗';
}));
document.querySelector('#copy-phase-example').addEventListener('click',async()=>{const button=document.querySelector('#copy-phase-example');try{await navigator.clipboard.writeText(phaseExample.textContent);button.textContent='Copied ✓'}catch{const range=document.createRange();range.selectNodeContents(phaseExample);const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Text selected'}setTimeout(()=>button.textContent='Copy',1300)});
document.querySelector('#copy-recovery-command').addEventListener('click',async()=>{const button=document.querySelector('#copy-recovery-command'),target=document.querySelector('#recovery-command');try{await navigator.clipboard.writeText(target.textContent.trim());button.textContent='Copied ✓'}catch{const range=document.createRange();range.selectNodeContents(target);const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);button.textContent='Text selected'}setTimeout(()=>button.textContent='Copy command',1400)});
const termInput=document.querySelector('#term-search'),termCards=[...document.querySelectorAll('.term-card')],termButtons=[...document.querySelectorAll('[data-term-filter]')],termCount=document.querySelector('#term-count'),termEmpty=document.querySelector('#term-empty');let activeTermGroup='all';
function filterTerms(){const query=termInput.value.trim().toLowerCase();let visible=0;termCards.forEach(card=>{const matchesQuery=(card.dataset.term+' '+card.textContent).toLowerCase().includes(query);const group=card.dataset.group;const matchesGroup=activeTermGroup==='all'||group===activeTermGroup||(activeTermGroup==='Git'&&group.startsWith('Git'));const show=matchesQuery&&matchesGroup;card.hidden=!show;if(show)visible++});termCount.textContent=visible+' / '+termCards.length+' TERMS';termEmpty.hidden=visible>0;}
termInput.addEventListener('input',filterTerms);termButtons.forEach(button=>button.addEventListener('click',()=>{activeTermGroup=button.dataset.termFilter;termButtons.forEach(b=>{const active=b===button;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active))});filterTerms()}));
const recoveryItems={
 git:{label:'GIT / PUSH PROBLEM',title:'Confirm your branch and remote.',copy:'Check the current state before retrying. Do not force-push or add a second remote just to make an error disappear.',command:`git status
git remote -v`,href:base+'student-guide/#step-5'},
 build:{label:'BUILD FAILED',title:'Find the first actionable error.',copy:'Open the latest Actions run, expand the failed job, and read the step log. Reproduce locally with npm run build when possible.',command:`npm run build
# inspect the first error line`,href:base+'student-guide/#step-6'},
 '404':{label:'LIVE URL IS 404',title:'Confirm the deploy and exact URL.',copy:'Check Settings → Pages, then confirm the newest deployment succeeded. Project sites normally include the repository name in the URL path.',command:`# open repo Settings → Pages
# open Actions → latest run`,href:base+'student-guide/#step-6'},
 assets:{label:'STYLES / IMAGES MISSING',title:'Check the URL path, not just the HTML.',copy:'If the page loads but its assets do not, inspect the failed asset URL. A leading slash can point to the domain root instead of the project subpath.',command:`npm run build
# inspect the asset URL in browser dev tools`,href:base+'student-guide/#step-6'}
};
document.querySelectorAll('[data-recovery]').forEach(button=>button.addEventListener('click',()=>{const item=recoveryItems[button.dataset.recovery];document.querySelectorAll('[data-recovery]').forEach(b=>{const active=b===button;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active))});document.querySelector('#recovery-label').textContent=item.label;document.querySelector('#recovery-title').textContent=item.title;document.querySelector('#recovery-copy').textContent=item.copy;document.querySelector('#recovery-command').textContent=item.command;document.querySelector('#recovery-link').href=item.href}));
</script>
</BaseLayout>