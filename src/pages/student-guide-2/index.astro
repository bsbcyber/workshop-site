---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const lab = 'https://github.com/bsbcyber/secure-dev-lab';
const labNew = 'https://github.com/bsbcyber/secure-dev-lab/generate';
---
<BaseLayout title="Workshop 2 student walkthrough" description="Step-by-step secure development lab: Actions scanners, remediations, and resume case study.">
<div class="container student-guide">
  <section class="page-hero">
    <div class="eyebrow">WORKSHOP 02 · FIELD GUIDE</div>
    <h1>Secure development walkthrough.</h1>
    <p>Own lab + discussion partner. Hunt a multi-finding Actions baseline, clear <strong>Must / Should / Stretch</strong>, open a PR, and add a case study to your Workshop 1 resume site. <strong>Do not deploy this lab.</strong></p>
    <div class="guide-actions">
      <a class="btn primary" href={labNew} target="_blank" rel="noreferrer">Use the lab template ↗</a>
      <a class="btn" href={base+'workshop-2/'}>Agenda & checklist ↗</a>
      <a class="btn" href={base+'downloads/workshop-2-presentation.pptx'}>PowerPoint ↓</a>
    </div>
  </section>

  <section class="card guide-status">
    <div>
      <div class="eyebrow">Progress</div>
      <h2>Where are you?</h2>
      <p>Jump to a step, or use recovery if something is stuck.</p>
    </div>
    <div class="guide-progress">
      <div class="progress-wrap"><div class="progress-bar" id="guide-progress-bar"></div></div>
      <span id="guide-progress-label">0 / 8</span>
    </div>
  </section>

  <div class="recovery-picker" role="group" aria-label="Recovery">
    <button type="button" class="btn small recovery-choice is-active" data-recovery="actions">Actions blocked</button>
    <button type="button" class="btn small recovery-choice" data-recovery="setup">Tool failed to start</button>
    <button type="button" class="btn small recovery-choice" data-recovery="lock">Lockfile mess</button>
    <button type="button" class="btn small recovery-choice" data-recovery="behind">Behind schedule</button>
  </div>
  <div class="card" id="recovery-panel" style="margin-bottom:28px">
    <div class="eyebrow" id="recovery-label">ACTIONS BLOCKED</div>
    <h3 id="recovery-title">Allow workflows, then re-run.</h3>
    <p id="recovery-copy">New repos sometimes pause Actions. Open the Actions tab, click the enable / I understand button if shown, then open Security Lab → Re-run all jobs.</p>
  </div>

  <!-- Step 1 -->
  <section class="guide-step" id="step-1">
    <div class="step-number">1</div>
    <div class="step-content">
      <div class="step-kicker">PARTNER + CLAIM THE LAB</div>
      <h2>Pick a discussion partner, then create <em>your</em> copy.</h2>
      <div class="step-task">
        <ol>
          <li>Sit with a <strong>discussion partner for the whole workshop</strong>. You will compare tallies and talk before each fix — you will <strong>not</strong> share one repo.</li>
          <li>Open <a href={lab} target="_blank" rel="noreferrer">bsbcyber/secure-dev-lab ↗</a>.</li>
          <li>Click <strong>Use this template</strong> → <strong>Create a new repository</strong>.</li>
          <li>Owner = you. Name example: <code>secure-dev-lab</code>. Visibility = <strong>Public</strong>.</li>
          <li>Do <strong>not</strong> enable GitHub Pages or deploy this project anywhere.</li>
        </ol>
        <div class="plain-note">
          <b>Must / Should / Stretch</b>
          <p><strong>Must</strong> (everyone): scout + ≥2 Semgrep fixes + both SCA packages. <strong>Should</strong>: all 4 SAST + 3 secrets + workflow. <strong>Stretch</strong>: PR + resume case study + peer-review your partner. Finish early? Do Should → Stretch — don’t leave.</p>
        </div>
        <p class="help-text">In-repo quest: <a href={lab+'/blob/main/docs/STUDENT-LAB.md'} target="_blank" rel="noreferrer">docs/STUDENT-LAB.md ↗</a></p>
      </div>
      <div class="notice"><strong>Safety:</strong> Intentionally vulnerable. Synthetic secrets only. Never paste a real secret.</div>
    </div>
  </section>

  <!-- Step 2 -->
  <section class="guide-step" id="step-2">
    <div class="step-number">2</div>
    <div class="step-content">
      <div class="step-kicker">FIRST SCAN</div>
      <h2>Open Actions → Security Lab and read the run.</h2>
      <div class="step-task">
        <ol>
          <li>In your new repo, open the <strong>Actions</strong> tab. Allow workflows if GitHub asks.</li>
          <li>Open the <strong>Security Lab</strong> workflow run (or use <strong>Run workflow</strong>).</li>
          <li>Confirm <strong>Unit tests</strong> is green.</li>
          <li>Open Semgrep, OSV-Scanner, Gitleaks, and zizmor. They should be red with <em>multiple</em> findings — that is expected on the first run.</li>
          <li><strong>Gate G0:</strong> compare your tally with your partner and explain finding vs tool failure. Wait for the facilitator before fixing.</li>
        </ol>
        <div class="plain-note">
          <b>Finding vs tool failure</b>
          <p>A <em>finding</em> completed the scan and reported a rule/advisory. A <em>tool failure</em> is an image pull, missing binary, or empty report. Only findings count for this lab.</p>
        </div>
        <h3>Scout tally (aim for these counts)</h3>
        <div class="card" style="padding:14px 16px;margin-top:10px">
          <table class="findings-table">
            <thead><tr><th>Tool</th><th>Target count</th><th>What you saw</th><th>Next action</th></tr></thead>
            <tbody>
              <tr><td>Semgrep</td><td>~4 rules</td><td></td><td></td></tr>
              <tr><td>OSV</td><td>2 packages (lodash + minimist)</td><td></td><td></td></tr>
              <tr><td>Gitleaks</td><td>3 fixtures</td><td></td><td></td></tr>
              <tr><td>zizmor</td><td>unpinned / artipacked / dangerous-triggers</td><td></td><td></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 3 -->
  <section class="guide-step" id="step-3">
    <div class="step-number">3</div>
    <div class="step-content">
      <div class="step-kicker">SAST · SEMGREP · ROUND 1 · GATE G1</div>
      <h2>Hunt and fix Semgrep findings (Must floor: ≥2).</h2>
      <div class="step-task">
        <ol>
          <li>With your partner, list all four LEARN hits: <code>eval</code>, <code>new Function</code>, shell concat in <code>pingHost</code>, hard-coded password in <code>src/settings.js</code>.</li>
          <li>Talk: which would you fix first in a real app, and why?</li>
          <li><strong>Commit A (each on your own repo):</strong> neutralize eval + Function; update <code>test/profile.test.js</code> for allow + reject.</li>
          <li><strong>Gate G1 (Must):</strong> Semgrep count has dropped — at least 2 of 4 fixed.</li>
          <li><strong>Should:</strong> Commit B — rewrite <code>pingHost</code> and remove the hard-coded password (4 → 0). Unit tests stay green.</li>
        </ol>
        <p class="help-text">Rule ids live in <code>.semgrep.yml</code>. Prefer the GitHub web editor — no local Semgrep install.</p>
      </div>
    </div>
  </section>

  <!-- Step 4 -->
  <section class="guide-step" id="step-4">
    <div class="step-number">4</div>
    <div class="step-content">
      <div class="step-kicker">SCA · OSV-SCANNER · ROUND 2 · GATE G2</div>
      <h2>Update lodash <em>and</em> minimist (completes Must).</h2>
      <div class="step-task">
        <ol>
          <li>With your partner, open the OSV log and list every advisory by package.</li>
          <li>Confirm both <code>lodash@4.17.20</code> and <code>minimist@1.2.5</code> appear — even if minimist is unused in <code>src/</code>.</li>
          <li>On <em>your</em> repo, update both versions in <code>package.json</code> <strong>and</strong> regenerate <code>package-lock.json</code>. Follow the facilitator’s tested versions if lock edits get messy.</li>
          <li><strong>Gate G2 (Must):</strong> OSV green for both packages; unit tests still pass. You have completed Must.</li>
        </ol>
        <div class="plain-note">
          <b>Teaching point</b>
          <p>Live validation showed lodash <code>4.17.23</code> still left advisories — often need ≥ <code>4.18.0</code>. Minimist’s prototype-pollution advisory typically clears at ≥ <code>1.2.6</code>. Always verify <em>today’s</em> advisory set.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 5 -->
  <section class="guide-step" id="step-5">
    <div class="step-number">5</div>
    <div class="step-content">
      <div class="step-kicker">SECRETS · GITLEAKS · SHOULD</div>
      <h2>Clear all three synthetic secret fixtures.</h2>
      <div class="step-task">
        <ol>
          <li>Map LEARN blocks to files: <code>fixtures/synthetic-secret.txt</code>, <code>fixtures/ci-notes.env</code>, <code>fixtures/bot-config.json</code>.</li>
          <li>Clear <code>WORKSHOP_FAKE_TOKEN_…</code>, <code>AKIAWORKSHOP…</code>, and <code>ghp_workshop…</code>. Leave short “cleared for lab” comments.</li>
          <li>Commit once. Gitleaks stays red until <strong>all three</strong> are gone. Logs should stay redacted.</li>
        </ol>
        <div class="notice"><strong>History caveat:</strong> This scan checks the current checkout. In a real incident, revoke/rotate first — deleting a line does not erase earlier commits or revoke a live key.</div>
      </div>
    </div>
  </section>

  <!-- Step 6 -->
  <section class="guide-step" id="step-6">
    <div class="step-number">6</div>
    <div class="step-content">
      <div class="step-kicker">WORKFLOW · ZIZMOR · SHOULD</div>
      <h2>Harden the inert workflow fixture.</h2>
      <div class="step-task">
        <ol>
          <li>Open <code>lab-fixtures/insecure-workflow.yml</code> only. Keep it <strong>outside</strong> <code>.github/workflows/</code>.</li>
          <li>Replace <code>permissions: write-all</code> with least privilege (e.g. <code>contents: read</code>).</li>
          <li>Replace <code>pull_request_target</code> with <code>workflow_dispatch</code> (dangerous trigger).</li>
          <li>Pin <strong>both</strong> <code>actions/checkout</code> and <code>actions/setup-node</code> to full SHAs from <code>.github/workflows/security-lab.yml</code>.</li>
          <li>Add <code>with: persist-credentials: false</code> on checkout.</li>
          <li>Remove or rewrite the <code>curl … | bash</code> training smell (do not run it).</li>
          <li>Commit and confirm zizmor is green.</li>
        </ol>
        <p class="help-text">Never move this fixture under <code>.github/workflows/</code> — it must not execute.</p>
      </div>
    </div>
  </section>

  <!-- Step 7 -->
  <section class="guide-step" id="step-7">
    <div class="step-number">7</div>
    <div class="step-content">
      <div class="step-kicker">PULL REQUEST · STRETCH</div>
      <h2>Practice checks on a branch.</h2>
      <div class="step-task">
        <ol>
          <li>Create a branch (web UI is fine).</li>
          <li>Make one small docs or comment change if remediations already landed on main.</li>
          <li>Open a pull request and inspect the Security Lab checks.</li>
          <li>Peer-review: walk your partner through one LEARN block or their PR checks.</li>
          <li>A failed check is evidence to read — branch protection is not required for this workshop.</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Step 8 -->
  <section class="guide-step" id="step-8">
    <div class="step-number">8</div>
    <div class="step-content">
      <div class="step-kicker">RESUME HANDOFF · STRETCH</div>
      <h2>Add a case study on your Workshop 1 site.</h2>
      <div class="step-task">
        <ol>
          <li>Open your published resume / portfolio repo from Workshop 1.</li>
          <li>Add a project (or short experience bullet) that names the tools, <strong>at least two</strong> findings, the fixes, and a link to <em>your</em> lab repo (not your partner’s).</li>
          <li>Ship that change the way you learned in Workshop 1 (branch → PR → Pages).</li>
          <li><strong>Do not</strong> merge the vulnerable lab into the resume app or deploy the lab.</li>
        </ol>
        <div class="plain-note">
          <b>Example project summary</b>
          <p>Ran Semgrep, OSV-Scanner, Gitleaks, and zizmor in GitHub Actions; triaged a multi-finding baseline (code injection patterns, two vulnerable lockfile packages, three synthetic secrets, unpinned workflow actions) and verified remediations on subsequent runs.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="finish-card">
    <div class="eyebrow">END OF WORKSHOP 02</div>
    <h2>You can read a red check and fix it on purpose.</h2>
    <p>Keep this guide and the lab’s <code>docs/STUDENT-LAB.md</code> nearby. A clean scan is evidence for triage — not a guarantee of security.</p>
    <div class="finish-links">
      <a class="btn primary" href={base+'workshop-2/'}>Agenda ↗</a>
      <a class="btn" href={base+'slides-2/'}>Slides ↗</a>
      <a class="btn" href={lab} target="_blank" rel="noreferrer">Lab template ↗</a>
    </div>
  </section>
</div>

<style>
.student-guide{padding-bottom:70px}
.guide-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
.guide-status{display:flex;justify-content:space-between;align-items:center;gap:25px;margin:0 0 18px}
.guide-progress{width:min(250px,35%);display:grid;grid-template-columns:1fr auto;align-items:center;gap:10px}
.guide-progress .progress-wrap{grid-column:1/-1;width:100%}
.guide-progress>span{grid-column:2;font:700 12px 'Roboto',sans-serif}
.guide-step{display:grid;grid-template-columns:65px minmax(0,1fr);gap:25px;padding:37px 0;border-top:1px solid var(--line);scroll-margin-top:25px}
.step-number{font:700 26px 'Titillium Web',sans-serif;width:55px;height:55px;display:grid;place-items:center;background:#FFDB00;color:#000;border-radius:4px}
.step-content{min-width:0;max-width:920px}
.step-kicker{font:700 10px 'Titillium Web',sans-serif;letter-spacing:.14em;color:#666;margin-bottom:6px}
.step-task{margin-top:14px}
.step-task ol{margin:0;padding-left:1.2em;display:grid;gap:8px}
.plain-note{margin:16px 0 0;padding:14px 16px;border-left:3px solid #FFDB00;background:#fff}
.plain-note b{display:block;margin-bottom:6px;font:700 12px 'Titillium Web',sans-serif;letter-spacing:.06em}
.help-text{margin-top:12px;font-size:14px;color:#555}
.findings-table{width:100%;border-collapse:collapse;font-size:13px}
.findings-table th,.findings-table td{border:1px solid #ddd;padding:8px;text-align:left}
.findings-table th{background:#f4f4f0}
.recovery-picker{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
.recovery-choice.is-active,.recovery-choice.primary{background:#111;color:#fff;border-color:#111}
.finish-card{background:#000;color:#fff;padding:clamp(25px,5vw,50px);border-radius:16px;margin:40px 0 0}
.finish-card .eyebrow{color:#FFDB00}
.finish-card p{font:15px/1.7 'Roboto',sans-serif;color:#ddd;max-width:760px}
.finish-links{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.finish-links .btn:not(.primary){color:#fff;border-color:#555}
@media(max-width:650px){.guide-status{flex-direction:column;align-items:flex-start}.guide-progress{width:100%}.guide-step{grid-template-columns:42px 1fr;gap:12px}}
</style>
<script>
const recovery={
  actions:{label:'ACTIONS BLOCKED',title:'Allow workflows, then re-run.',copy:'New repos sometimes pause Actions. Open the Actions tab, enable workflows if prompted, then Security Lab → Re-run all jobs.'},
  setup:{label:'TOOL FAILED TO START',title:'That is not a finding.',copy:'Image pulls, missing binaries, or empty reports are setup failures. Re-run once. If it persists, ask the facilitator — do not invent a code fix.'},
  lock:{label:'LOCKFILE MESS',title:'Keep package.json and the lockfile in sync.',copy:'Prefer npm install lodash@&lt;fixed&gt; locally, or use the facilitator’s tested version. Do not hand-edit a huge lockfile blindly.'},
  behind:{label:'BEHIND SCHEDULE',title:'Finish Must with your partner.',copy:'Clear Gate G0–G2: scout tally, ≥2 Semgrep fixes, both SCA packages. Park Should (remaining SAST, secrets, zizmor) as homework. Stretch only if Must is done.'}
};
document.querySelectorAll('.recovery-choice').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('.recovery-choice').forEach(x=>x.classList.remove('is-active','primary'));
  b.classList.add('is-active','primary');
  const r=recovery[b.dataset.recovery];
  document.querySelector('#recovery-label').textContent=r.label;
  document.querySelector('#recovery-title').textContent=r.title;
  document.querySelector('#recovery-copy').textContent=r.copy.replace(/&lt;/g,'<').replace(/&gt;/g,'>');
}));
const steps=[...document.querySelectorAll('.guide-step')];
const bar=document.querySelector('#guide-progress-bar');
const label=document.querySelector('#guide-progress-label');
function syncProgress(){
  const y=window.scrollY+120;
  let idx=0;
  steps.forEach((s,i)=>{if(s.offsetTop<=y)idx=i});
  label.textContent=(idx+1)+' / '+steps.length;
  bar.style.width=(((idx+1)/steps.length)*100)+'%';
}
window.addEventListener('scroll',syncProgress,{passive:true});
syncProgress();
</script>
</BaseLayout>
