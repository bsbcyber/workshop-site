---
/**
 * Dedicated project page — same WSU resume shell language as the home resume.
 */
import Avatar from '../components/Avatar.astro';
import { withSlug } from '../lib/projects.js';

const { profile, project: rawProject, assetBase = '/', pageBase = assetBase } = Astro.props;
const project = withSlug(rawProject);
const homeHref = pageBase.endsWith('/') ? pageBase : `${pageBase}/`;
const screenshots = project.screenshots ?? [];
const overview = project.overview || project.description || '';
const approachSteps = Array.isArray(project.approach)
  ? project.approach
  : project.approach
    ? [project.approach]
    : Array.isArray(project.highlights)
      ? project.highlights
      : [];
const imagePaths = screenshots.length
  ? screenshots
  : (project.images ?? []).map((src, i) => ({
      src,
      alt: `${project.title} screenshot ${i + 1}`,
      caption: '',
    }));

function assetUrl(path = '') {
  if (!path) return '';
  if (path.startsWith('http')) return path;
  return `${assetBase}${path.replace(/^\//, '')}`;
}
---
<div class="resume-shell project-page">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Saira+Extra+Condensed:wght@500;700&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />

  <nav class="resume-nav no-print" aria-label="Project navigation">
    <div class="resume-nav-inner">
      <Avatar profile={profile} assetBase={assetBase} size="lg" class="resume-photo" />
      <ul>
        <li><a href={homeHref}>Resume</a></li>
        <li><a href={`${homeHref}#projects`}>All projects</a></li>
        {project.link && (
          <li><a href={project.link} target="_blank" rel="noreferrer">Repository</a></li>
        )}
        {project.demo && (
          <li><a href={project.demo} target="_blank" rel="noreferrer">Live demo</a></li>
        )}
      </ul>
    </div>
  </nav>

  <div class="resume-main">
    <p class="project-back"><a href={`${homeHref}#projects`}>← Back to projects</a></p>

    <header class="project-hero">
      <h1>{project.title}</h1>
      <p class="resume-lead">{project.summary}</p>
      {project.skills?.length > 0 && (
        <ul class="resume-skills">
          {project.skills.map((skill) => <li>{skill}</li>)}
        </ul>
      )}
      <div class="project-actions no-print">
        {project.link && (
          <a class="project-btn" href={project.link} target="_blank" rel="noreferrer">View repository</a>
        )}
        {project.demo && (
          <a class="project-btn project-btn-secondary" href={project.demo} target="_blank" rel="noreferrer">Live demo</a>
        )}
      </div>
    </header>

    {overview && (
      <section>
        <h2>Overview</h2>
        <p>{overview}</p>
      </section>
    )}

    {project.problem && (
      <section>
        <h2>Problem</h2>
        <p>{project.problem}</p>
      </section>
    )}

    {approachSteps.length > 0 && (
      <section>
        <h2>What I did</h2>
        <ul class="resume-list">
          {approachSteps.map((step) => <li>{step}</li>)}
        </ul>
      </section>
    )}

    {project.outcome && (
      <section>
        <h2>Outcome</h2>
        <p>{project.outcome}</p>
      </section>
    )}

    {imagePaths.length > 0 && (
      <section>
        <h2>Screenshots</h2>
        <div class="project-shots">
          {imagePaths.map((shot) => (
            <figure class="project-shot">
              <img src={assetUrl(shot.src)} alt={shot.alt || project.title} loading="lazy" />
              {shot.caption && <figcaption>{shot.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
  </div>
</div>

<style>
.resume-shell {
  --accent: #ffdb00;
  --accent-ink: #000000;
  --ink: #1a1a1a;
  --muted: #5c5c5c;
  --line: #e5e5e5;
  --side: #000000;
  display: flex;
  min-height: 100vh;
  width: 100%;
  background: #fff;
  color: var(--ink);
  font: 400 16px/1.6 "Open Sans", "Segoe UI", sans-serif;
}
.resume-shell * { box-sizing: border-box; }

.resume-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 17rem;
  height: 100vh;
  background: var(--side);
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem 1rem;
}
.resume-nav-inner {
  width: 100%;
  text-align: center;
}
:global(.resume-photo) {
  width: 8rem;
  height: 8rem;
  border-radius: 50%;
  object-fit: cover;
  border: 0.5rem solid rgba(255, 255, 255, 0.2);
  margin: 0 auto 2rem;
  background: rgba(0, 0, 0, 0.15);
  display: block;
}
:global(.avatar-initials.resume-photo) {
  display: grid;
  place-items: center;
  font: 700 2rem "Saira Extra Condensed", sans-serif;
  color: #fff;
  letter-spacing: 0.08em;
}
.resume-nav ul {
  list-style: none;
  margin: 0;
  padding: 0;
}
.resume-nav a {
  display: block;
  padding: 0.55rem 0;
  color: rgba(255, 255, 255, 0.78);
  text-decoration: none;
  font: 700 0.95rem/1 "Saira Extra Condensed", sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.resume-nav a:hover,
.resume-nav a:focus {
  color: var(--accent);
}

.resume-main {
  margin-left: 17rem;
  width: calc(100% - 17rem);
  padding: 3.5rem 3.5rem 5rem;
  max-width: 72rem;
}

.project-back {
  margin: 0 0 1.25rem;
}
.project-back a {
  color: var(--muted);
  font-weight: 600;
  text-decoration: none;
}
.project-back a:hover {
  color: var(--ink);
  text-decoration: underline;
  text-decoration-color: var(--accent);
}

.project-hero h1 {
  margin: 0 0 0.75rem;
  font: 700 clamp(2.4rem, 6vw, 4.2rem)/1 "Saira Extra Condensed", sans-serif;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--ink);
}
.resume-lead {
  margin: 0 0 1rem;
  font-size: 1.15rem;
  color: var(--ink);
}
.resume-skills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  list-style: none;
  margin: 0 0 1.25rem;
  padding: 0;
}
.resume-skills li {
  padding: 0.4rem 0.7rem;
  background: var(--accent);
  color: var(--accent-ink);
  border-radius: 0.3rem;
  font: 700 0.85rem/1 "Open Sans", sans-serif;
}
.project-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
}
.project-btn {
  display: inline-block;
  padding: 0.65rem 1rem;
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 700;
  text-decoration: none;
  border-radius: 0.3rem;
}
.project-btn-secondary {
  background: #fff;
  border: 2px solid #000;
}
.project-btn:hover { filter: brightness(0.96); }

.resume-main section {
  padding: 2.5rem 0;
  border-bottom: 1px solid var(--line);
}
.resume-main section:last-child { border-bottom: 0; }
.resume-main h2 {
  margin: 0 0 1.25rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--line);
  font: 700 2rem/1.1 "Saira Extra Condensed", sans-serif;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink);
}
.resume-main p { margin: 0; }
.resume-list {
  margin: 0;
  padding-left: 1.2rem;
}
.resume-list li { margin-bottom: 0.55rem; }

.project-shots {
  display: grid;
  gap: 1.75rem;
}
.project-shot {
  margin: 0;
}
.project-shot img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--line);
  background: #f7f7f7;
}
.project-shot figcaption {
  margin-top: 0.65rem;
  color: var(--muted);
  font-size: 0.95rem;
}

@media (max-width: 900px) {
  .resume-shell { display: block; }
  .resume-nav {
    position: static;
    width: 100%;
    height: auto;
    padding: 1.5rem 1rem 1rem;
  }
  .resume-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.85rem;
    margin-top: 1rem;
  }
  :global(.resume-photo) { margin-bottom: 0.75rem; }
  .resume-main {
    margin-left: 0;
    width: 100%;
    padding: 2rem 1.25rem 4rem;
  }
}
</style>
