---
import Avatar from '../../components/Avatar.astro';
import PrintControls from '../../components/PrintControls.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education) ? profile.education : profile.education ? [profile.education] : [];
const coursework = profile.coursework ?? [];
const activities = profile.activities ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const resumeHref = profile.resume
  ? profile.resume.startsWith('http') ? profile.resume : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
---
<div class="theme-student">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" />

  <PrintControls />

  <header class="st-hero">
    <div class="st-hero-inner">
      <div class="st-hero-copy">
        <p class="st-kicker">{profile.location}</p>
        <h1>{profile.name}</h1>
        <p class="st-role">{profile.role}</p>
        {profile.badge && <p class="st-badge">{profile.badge}</p>}
        <p class="st-tagline">{profile.tagline}</p>
        <nav class="st-contact" aria-label="Contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
          {resumeHref && <a class="no-print" href={resumeHref} target="_blank" rel="noreferrer">Resume file</a>}
        </nav>
      </div>
      <Avatar profile={profile} assetBase={assetBase} size="lg" class="st-photo no-print" />
    </div>
  </header>

  <div class="st-body">
    <section class="st-summary-block">
      <h2>Summary</h2>
      <div class="st-summary-row">
        <p class="st-summary">{profile.about}</p>
        <p class="st-skills"><span>Skills</span> {profile.skills.join(' · ')}</p>
      </div>
    </section>

    <div class="st-grid">
      <section>
        <h2>Education</h2>
        {education.map((item) => (
          <article class="st-entry">
            <div class="st-entry-top">
              <h3>{item.degree}</h3>
              <time>{item.detail}</time>
            </div>
            <p class="st-org">{item.school}</p>
          </article>
        ))}
        {honors.length > 0 && (
          <p class="st-note"><span>Honors</span> {honors.map((h) => h.title + (h.detail ? ` (${h.detail})` : '')).join(' · ')}</p>
        )}
      </section>

      {coursework.length > 0 && (
        <section>
          <h2>Relevant coursework</h2>
          <ul class="st-plain">
            {coursework.map((item) => (
              <li><strong>{item.title}.</strong> {item.detail}</li>
            ))}
          </ul>
        </section>
      )}

      {activities.length > 0 && (
        <section>
          <h2>Activities</h2>
          {activities.map((item) => (
            <article class="st-entry">
              <h3>{item.title}</h3>
              <p class="st-org">{item.organization}</p>
              <p>{item.detail}</p>
            </article>
          ))}
        </section>
      )}

      <section>
        <h2>Projects</h2>
        {profile.projects.map((project) => (
          <article class="st-entry">
            <h3>
              {project.link ? (
                <a href={project.link} target="_blank" rel="noreferrer">{project.title}</a>
              ) : project.title}
            </h3>
            <p>{project.summary}</p>
            {project.skills?.length > 0 && (
              <p class="st-note"><span>Tools</span> {project.skills.join(' · ')}</p>
            )}
          </article>
        ))}
      </section>

      {(interests.length > 0 || learning.length > 0) && (
        <section>
          <h2>Additional</h2>
          {interests.length > 0 && <p class="st-note"><span>Interests</span> {interests.join(' · ')}</p>}
          {learning.length > 0 && <p class="st-note"><span>Learning</span> {learning.join(' · ')}</p>}
        </section>
      )}
    </div>
  </div>
</div>

<style>
.theme-student {
  --ink: #14212b;
  --text: #3a4650;
  --muted: #6b7782;
  --line: #d5dde3;
  --paper: #f7f5f1;
  --hero: #1a3344;
  --accent: #24556c;
  --pad: clamp(24px, 5vw, 96px);
  min-height: 100vh;
  width: 100%;
  background: var(--paper);
  color: var(--text);
  font: 400 16px/1.6 "DM Sans", "Segoe UI", sans-serif;
}
.theme-student * { box-sizing: border-box; }
.st-hero {
  width: 100%;
  background:
    linear-gradient(115deg, rgba(255,255,255,0.06), transparent 42%),
    var(--hero);
  color: #e8eef2;
  padding: clamp(48px, 8vw, 96px) var(--pad);
}
.st-hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: clamp(28px, 5vw, 72px);
  align-items: end;
  width: 100%;
  max-width: none;
}
.st-kicker {
  margin: 0 0 14px;
  color: #9db3c0;
  font: 600 12px/1.3 "DM Sans", sans-serif;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.st-hero h1 {
  margin: 0 0 10px;
  color: #fff;
  font: 700 clamp(48px, 8vw, 84px)/0.98 "Fraunces", Georgia, serif;
  letter-spacing: -0.035em;
  max-width: 14ch;
}
.st-role {
  margin: 0 0 6px;
  color: #fff;
  font: 600 20px/1.35 "DM Sans", sans-serif;
}
.st-badge {
  margin: 0 0 16px;
  color: #9ed0e6;
  font: 600 15px/1.35 "DM Sans", sans-serif;
}
.st-tagline {
  margin: 0 0 22px;
  max-width: 40rem;
  color: #c5d4de;
  font-size: 18px;
}
.st-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 22px;
}
.st-contact a {
  color: #fff;
  text-decoration: none;
  font: 600 14px/1.3 "DM Sans", sans-serif;
  border-bottom: 1px solid rgba(255,255,255,0.35);
}
.st-contact a:hover { border-bottom-color: #fff; }
:global(.st-photo) {
  width: clamp(148px, 18vw, 200px);
  height: clamp(148px, 18vw, 200px);
  border-radius: 2px;
  object-fit: cover;
  background: #2a4a5c;
  flex-shrink: 0;
  box-shadow: 0 18px 40px rgba(0,0,0,0.28);
}
:global(.avatar-initials.st-photo) {
  display: grid;
  place-items: center;
  font: 700 48px "Fraunces", Georgia, serif;
  color: #fff;
}
.st-body {
  width: 100%;
  padding: clamp(40px, 6vw, 72px) var(--pad) 112px;
}
.st-summary-block {
  padding-bottom: 36px;
  margin-bottom: 36px;
  border-bottom: 1px solid var(--line);
}
.st-summary-row {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(240px, 0.8fr);
  gap: clamp(24px, 4vw, 56px);
  align-items: start;
}
.theme-student h2 {
  margin: 0 0 16px;
  color: var(--ink);
  font: 700 12px/1.3 "DM Sans", sans-serif;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.st-summary {
  margin: 0;
  font-size: 18px;
  color: var(--text);
  max-width: 62ch;
}
.st-skills {
  margin: 0;
  color: var(--text);
  font-size: 15px;
  padding: 18px 20px;
  background: #efece6;
  border-left: 3px solid var(--accent);
}
.st-skills span,
.st-note span {
  display: block;
  margin-bottom: 8px;
  color: var(--ink);
  font: 700 12px/1.3 "DM Sans", sans-serif;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.st-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(36px, 5vw, 64px) clamp(40px, 5vw, 80px);
}
.st-grid > section { min-width: 0; }
.st-entry { margin: 0 0 20px; }
.st-entry:last-child { margin-bottom: 0; }
.st-entry-top {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: baseline;
}
.st-entry h3 {
  margin: 0;
  color: var(--ink);
  font: 700 18px/1.35 "DM Sans", sans-serif;
}
.st-entry h3 a { color: inherit; text-decoration: none; }
.st-entry h3 a:hover { color: var(--accent); text-decoration: underline; }
.st-entry time {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 13px;
}
.st-org {
  margin: 3px 0 6px;
  color: var(--accent);
  font-weight: 600;
  font-size: 14px;
}
.st-entry p { margin: 0; }
.st-note { margin: 12px 0 0; font-size: 14px; }
.st-plain {
  margin: 0;
  padding-left: 18px;
}
.st-plain li { margin-bottom: 10px; }
.st-plain strong { color: var(--ink); }
@media (max-width: 900px) {
  .st-hero-inner,
  .st-summary-row,
  .st-grid { grid-template-columns: 1fr; }
  :global(.st-photo) { order: -1; }
}
@media print {
  .st-hero {
    background: #fff !important;
    color: #000 !important;
    padding: 0 0 12pt !important;
  }
  .st-hero h1,
  .st-role,
  .st-badge,
  .st-tagline,
  .st-kicker,
  .st-contact a { color: #000 !important; }
  .st-skills {
    background: transparent !important;
    border: 0 !important;
    padding: 0 !important;
  }
}
</style>
