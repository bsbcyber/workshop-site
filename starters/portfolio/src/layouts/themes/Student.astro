---
import Avatar from '../../components/Avatar.astro';
import PrintControls from '../../components/PrintControls.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education) ? profile.education : profile.education ? [profile.education] : [];
const coursework = profile.coursework ?? [];
const activities = profile.activities ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const resumeHref = profile.resume
  ? profile.resume.startsWith('http') ? profile.resume : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
---
<div class="theme-student">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" />

  <PrintControls />

  <div class="st-shell">
    <header class="st-hero">
      <div class="st-hero-copy">
        <p class="st-kicker">{profile.location}</p>
        <h1>{profile.name}</h1>
        <p class="st-role">{profile.role}</p>
        {profile.badge && <p class="st-badge">{profile.badge}</p>}
        <p class="st-tagline">{profile.tagline}</p>
        <nav class="st-contact" aria-label="Contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
          {resumeHref && <a class="no-print" href={resumeHref} target="_blank" rel="noreferrer">Resume file</a>}
        </nav>
      </div>
      <Avatar profile={profile} assetBase={assetBase} size="lg" class="st-photo no-print" />
    </header>

    <div class="st-body">
      <section class="st-summary-block">
        <h2>Summary</h2>
        <p class="st-summary">{profile.about}</p>
        <p class="st-skills"><span>Skills</span> {profile.skills.join(' · ')}</p>
      </section>

      <div class="st-grid">
        <section>
          <h2>Education</h2>
          {education.map((item) => (
            <article class="st-entry">
              <div class="st-entry-top">
                <h3>{item.degree}</h3>
                <time>{item.detail}</time>
              </div>
              <p class="st-org">{item.school}</p>
            </article>
          ))}
          {honors.length > 0 && (
            <p class="st-note"><span>Honors</span> {honors.map((h) => h.title + (h.detail ? ` (${h.detail})` : '')).join(' · ')}</p>
          )}
        </section>

        {coursework.length > 0 && (
          <section>
            <h2>Relevant coursework</h2>
            <ul class="st-plain">
              {coursework.map((item) => (
                <li><strong>{item.title}.</strong> {item.detail}</li>
              ))}
            </ul>
          </section>
        )}

        {activities.length > 0 && (
          <section>
            <h2>Activities</h2>
            {activities.map((item) => (
              <article class="st-entry">
                <h3>{item.title}</h3>
                <p class="st-org">{item.organization}</p>
                <p>{item.detail}</p>
              </article>
            ))}
          </section>
        )}

        <section>
          <h2>Projects</h2>
          {profile.projects.map((project) => (
            <article class="st-entry">
              <h3>
                {project.link ? (
                  <a href={project.link} target="_blank" rel="noreferrer">{project.title}</a>
                ) : project.title}
              </h3>
              <p>{project.summary}</p>
              {project.skills?.length > 0 && (
                <p class="st-note"><span>Tools</span> {project.skills.join(' · ')}</p>
              )}
            </article>
          ))}
        </section>

        {(interests.length > 0 || learning.length > 0) && (
          <section>
            <h2>Additional</h2>
            {interests.length > 0 && <p class="st-note"><span>Interests</span> {interests.join(' · ')}</p>}
            {learning.length > 0 && <p class="st-note"><span>Learning</span> {learning.join(' · ')}</p>}
          </section>
        )}
      </div>
    </div>
  </div>
</div>

<style>
.theme-student {
  --ink: #14212b;
  --text: #3a4650;
  --muted: #6b7782;
  --line: #d7dee4;
  --paper: #f3f1ec;
  --surface: #fffcf7;
  --accent: #1f4d63;
  min-height: 100vh;
  width: 100%;
  background:
    radial-gradient(1200px 480px at 8% -10%, rgba(31, 77, 99, 0.08), transparent 60%),
    linear-gradient(180deg, #ebe7df 0%, var(--paper) 38%, #e8e4dc 100%);
  color: var(--text);
  font: 400 16px/1.6 "DM Sans", "Segoe UI", sans-serif;
}
.theme-student * { box-sizing: border-box; }
.st-shell {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
  padding: 40px 0 96px;
}
.st-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: clamp(28px, 4vw, 56px);
  align-items: end;
  padding: clamp(28px, 4vw, 44px);
  margin-bottom: 28px;
  background: var(--surface);
  border: 1px solid rgba(20, 33, 43, 0.08);
  box-shadow: 0 18px 50px rgba(20, 33, 43, 0.06);
}
.st-kicker {
  margin: 0 0 10px;
  color: var(--muted);
  font: 600 12px/1.3 "DM Sans", sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.st-hero h1 {
  margin: 0 0 8px;
  color: var(--ink);
  font: 700 clamp(42px, 7vw, 72px)/1.02 "Fraunces", Georgia, serif;
  letter-spacing: -0.03em;
}
.st-role {
  margin: 0 0 6px;
  color: var(--ink);
  font: 600 18px/1.35 "DM Sans", sans-serif;
}
.st-badge {
  margin: 0 0 14px;
  color: var(--accent);
  font: 600 14px/1.35 "DM Sans", sans-serif;
}
.st-tagline {
  margin: 0 0 18px;
  max-width: 42rem;
  color: var(--text);
  font-size: 17px;
}
.st-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 18px;
}
.st-contact a {
  color: var(--accent);
  text-decoration: none;
  font: 600 14px/1.3 "DM Sans", sans-serif;
  border-bottom: 1px solid transparent;
}
.st-contact a:hover { border-bottom-color: currentColor; }
:global(.st-photo) {
  width: clamp(128px, 16vw, 168px);
  height: clamp(128px, 16vw, 168px);
  border-radius: 4px;
  object-fit: cover;
  background: #d8d2c8;
  flex-shrink: 0;
}
:global(.avatar-initials.st-photo) {
  display: grid;
  place-items: center;
  font: 700 40px "Fraunces", Georgia, serif;
  color: var(--ink);
}
.st-body {
  padding: clamp(28px, 4vw, 44px);
  background: var(--surface);
  border: 1px solid rgba(20, 33, 43, 0.08);
  box-shadow: 0 18px 50px rgba(20, 33, 43, 0.05);
}
.st-summary-block {
  padding-bottom: 28px;
  margin-bottom: 8px;
  border-bottom: 1px solid var(--line);
}
.theme-student h2 {
  margin: 0 0 14px;
  color: var(--ink);
  font: 700 12px/1.3 "DM Sans", sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.st-summary {
  margin: 0;
  max-width: 68ch;
  font-size: 17px;
  color: var(--text);
}
.st-skills {
  margin: 16px 0 0;
  color: var(--text);
  font-size: 15px;
}
.st-skills span,
.st-note span {
  margin-right: 8px;
  color: var(--ink);
  font-weight: 700;
}
.st-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 36px 48px;
  padding-top: 28px;
}
.st-grid > section { min-width: 0; }
.st-entry { margin: 0 0 18px; }
.st-entry:last-child { margin-bottom: 0; }
.st-entry-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: baseline;
}
.st-entry h3 {
  margin: 0;
  color: var(--ink);
  font: 700 17px/1.35 "DM Sans", sans-serif;
}
.st-entry h3 a { color: inherit; text-decoration: none; }
.st-entry h3 a:hover { color: var(--accent); text-decoration: underline; }
.st-entry time {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 13px;
}
.st-org {
  margin: 2px 0 6px;
  color: var(--accent);
  font-weight: 600;
  font-size: 14px;
}
.st-entry p { margin: 0; }
.st-note { margin: 10px 0 0; font-size: 14px; }
.st-plain {
  margin: 0;
  padding-left: 18px;
}
.st-plain li { margin-bottom: 8px; }
.st-plain strong { color: var(--ink); }
@media (max-width: 900px) {
  .st-shell { width: min(100% - 28px, 1180px); padding-top: 24px; }
  .st-hero { grid-template-columns: 1fr; }
  .st-grid { grid-template-columns: 1fr; gap: 28px; }
  :global(.st-photo) { order: -1; }
}
</style>
