---
import Avatar from '../../components/Avatar.astro';
import PrintControls from '../../components/PrintControls.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education) ? profile.education : profile.education ? [profile.education] : [];
const coursework = profile.coursework ?? [];
const activities = profile.activities ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const resumeHref = profile.resume
  ? profile.resume.startsWith('http') ? profile.resume : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
---
<div class="theme-student">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />

  <PrintControls />

  <header class="st-header">
    <div class="st-identity">
      <h1>{profile.name}</h1>
      <p class="st-role">{profile.role}</p>
      {profile.badge && <p class="st-badge">{profile.badge}</p>}
      <p class="st-contact">
        <span>{profile.location}</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
        {resumeHref && <a class="no-print" href={resumeHref} target="_blank" rel="noreferrer">Resume file</a>}
      </p>
    </div>
    <Avatar profile={profile} assetBase={assetBase} size="lg" class="st-photo no-print" />
  </header>

  <section>
    <h2>Summary</h2>
    <p class="st-summary">{profile.tagline} {profile.about}</p>
    <p class="st-skills"><span class="st-k">Skills</span> {profile.skills.join(' · ')}</p>
  </section>

  <section>
    <h2>Education</h2>
    {education.map((item) => (
      <article class="st-entry">
        <div class="st-entry-top">
          <h3>{item.degree}</h3>
          <time>{item.detail}</time>
        </div>
        <p class="st-org">{item.school}</p>
      </article>
    ))}
    {honors.length > 0 && (
      <p class="st-note"><span class="st-k">Honors</span> {honors.map((h) => h.title + (h.detail ? ` (${h.detail})` : '')).join(' · ')}</p>
    )}
  </section>

  {coursework.length > 0 && (
    <section>
      <h2>Relevant coursework</h2>
      <ul class="st-plain">
        {coursework.map((item) => (
          <li><strong>{item.title}.</strong> {item.detail}</li>
        ))}
      </ul>
    </section>
  )}

  {activities.length > 0 && (
    <section>
      <h2>Activities</h2>
      {activities.map((item) => (
        <article class="st-entry">
          <div class="st-entry-top">
            <h3>{item.title}</h3>
          </div>
          <p class="st-org">{item.organization}</p>
          <p>{item.detail}</p>
        </article>
      ))}
    </section>
  )}

  <section>
    <h2>Projects</h2>
    {profile.projects.map((project) => (
      <article class="st-entry">
        <div class="st-entry-top">
          <h3>
            {project.link ? (
              <a href={project.link} target="_blank" rel="noreferrer">{project.title}</a>
            ) : project.title}
          </h3>
        </div>
        <p>{project.summary}</p>
        {project.skills?.length > 0 && (
          <p class="st-note"><span class="st-k">Tools</span> {project.skills.join(' · ')}</p>
        )}
      </article>
    ))}
  </section>

  {(interests.length > 0 || learning.length > 0) && (
    <section>
      <h2>Additional</h2>
      {interests.length > 0 && <p class="st-note"><span class="st-k">Interests</span> {interests.join(' · ')}</p>}
      {learning.length > 0 && <p class="st-note"><span class="st-k">Learning</span> {learning.join(' · ')}</p>}
    </section>
  )}
</div>

<style>
.theme-student {
  --ink: #171717;
  --text: #3f3f46;
  --muted: #71717a;
  --line: #e4e4e7;
  --paper: #fafaf9;
  --accent: #1e3a5f;
  max-width: 760px;
  margin: 0 auto;
  padding: 36px 22px 80px;
  background: var(--paper);
  color: var(--text);
  font: 400 15px/1.55 "Source Sans 3", "Segoe UI", sans-serif;
  min-height: 100vh;
}
.theme-student * { box-sizing: border-box; }
.st-header {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: flex-start;
  padding-bottom: 22px;
  margin-bottom: 8px;
  border-bottom: 2px solid var(--ink);
}
.st-header h1 {
  margin: 0 0 4px;
  color: var(--ink);
  font: 700 clamp(30px, 5vw, 40px)/1.1 "Source Serif 4", Georgia, serif;
  letter-spacing: -0.02em;
}
.st-role {
  margin: 0 0 8px;
  color: var(--ink);
  font: 600 15px/1.4 "Source Sans 3", sans-serif;
}
.st-badge {
  margin: 0 0 10px;
  color: var(--accent);
  font: 600 13px/1.3 "Source Sans 3", sans-serif;
}
.st-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 14px;
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}
.st-contact a { color: var(--accent); text-decoration: none; }
.st-contact a:hover { text-decoration: underline; }
:global(.st-photo) {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  object-fit: cover;
  background: #d6d3d1;
  flex-shrink: 0;
}
:global(.avatar-initials.st-photo) {
  display: grid;
  place-items: center;
  font: 700 24px "Source Serif 4", Georgia, serif;
  color: var(--ink);
}
.theme-student section { padding: 18px 0; border-bottom: 1px solid var(--line); }
.theme-student section:last-child { border-bottom: 0; }
.theme-student h2 {
  margin: 0 0 12px;
  color: var(--ink);
  font: 700 12px/1.3 "Source Sans 3", sans-serif;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.st-summary { margin: 0 0 10px; max-width: 62ch; }
.st-skills, .st-note { margin: 8px 0 0; color: var(--text); font-size: 14px; }
.st-k {
  display: inline-block;
  margin-right: 6px;
  color: var(--ink);
  font-weight: 700;
}
.st-entry { margin: 0 0 14px; }
.st-entry:last-child { margin-bottom: 0; }
.st-entry-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: baseline;
}
.st-entry h3 {
  margin: 0;
  color: var(--ink);
  font: 700 16px/1.35 "Source Sans 3", sans-serif;
}
.st-entry h3 a { color: inherit; text-decoration: none; }
.st-entry h3 a:hover { color: var(--accent); text-decoration: underline; }
.st-entry time {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 13px;
}
.st-org {
  margin: 2px 0 4px;
  color: var(--accent);
  font-weight: 600;
  font-size: 14px;
}
.st-entry p { margin: 0; }
.st-plain {
  margin: 0;
  padding-left: 18px;
  color: var(--text);
}
.st-plain li { margin-bottom: 6px; }
.st-plain strong { color: var(--ink); }
@media (max-width: 640px) {
  .st-header { flex-direction: column-reverse; }
}
</style>
