---
import Avatar from '../../components/Avatar.astro';
import ExperienceDetails from '../../components/ExperienceDetails.astro';
import PrintControls from '../../components/PrintControls.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education) ? profile.education : profile.education ? [profile.education] : [];
const certifications = profile.certifications ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const careerHighlights = profile.careerHighlights ?? [];
const resumeHref = profile.resume
  ? profile.resume.startsWith('http') ? profile.resume : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
const showCredentials = certifications.length > 0 || honors.length > 0;
const showInterests = interests.length > 0 || learning.length > 0;
---
<div class="theme-professional">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Libre+Baskerville:wght@700&display=swap" rel="stylesheet" />

  <PrintControls />

  <aside class="pro-side">
    <Avatar profile={profile} assetBase={assetBase} size="lg" class="pro-photo no-print" />
    <h1>{profile.name}</h1>
    <p class="role">{profile.role}</p>
    {profile.badge && <p class="badge">{profile.badge}</p>}

    <p class="label">Contact</p>
    <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    <p><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></p>
    <p><a href={profile.github} target="_blank" rel="noreferrer">GitHub</a></p>
    {resumeHref && <p class="no-print"><a href={resumeHref} target="_blank" rel="noreferrer">Resume file</a></p>}
    <p>{profile.location}</p>

    <p class="label">Skills</p>
    <p class="pro-skills-text">{profile.skills.join(' · ')}</p>

    <p class="label">Education</p>
    {education.map((item) => (
      <div class="pro-edu">
        <strong>{item.degree}</strong>
        <p>{item.school}</p>
        <p class="muted">{item.detail}</p>
      </div>
    ))}
  </aside>

  <main class="pro-main">
    <section id="about">
      <h2>Profile</h2>
      <p class="pro-lead">{profile.tagline}</p>
      <p>{profile.about}</p>
    </section>

    <section id="experience">
      <h2>Experience</h2>
      {profile.experience.map((item) => (
        <article class="pro-role">
          <div class="pro-role-top">
            <div>
              <h3>{item.title}</h3>
              <p class="muted">{item.organization}</p>
            </div>
            <time>{item.date}</time>
          </div>
          <ExperienceDetails item={item} />
        </article>
      ))}
    </section>

    {careerHighlights.length > 0 && (
      <section id="highlights">
        <h2>Highlights</h2>
        <ul class="pro-bullets">
          {careerHighlights.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <section id="projects">
      <h2>Projects</h2>
      <div class="pro-projects">
        {profile.projects.map((project) => (
          <article class="pro-role">
            <div class="pro-role-top">
              <h3>
                {project.link ? (
                  <a href={project.link} target="_blank" rel="noreferrer">{project.title}</a>
                ) : project.title}
              </h3>
            </div>
            <p>{project.summary}</p>
            {project.skills?.length > 0 && (
              <p class="muted">{project.skills.join(' · ')}</p>
            )}
          </article>
        ))}
      </div>
    </section>

    {showInterests && (
      <section id="interests">
        <h2>Interests & learning</h2>
        {interests.length > 0 && <p>{interests.join(' · ')}</p>}
        {learning.length > 0 && <p class="muted">Learning: {learning.join(' · ')}</p>}
      </section>
    )}

    {showCredentials && (
      <section id="credentials">
        <h2>Credentials</h2>
        <ul class="pro-bullets">
          {certifications.map((item) => (
            <li>{item.name}{item.issuer ? ` · ${item.issuer}` : ''}</li>
          ))}
          {honors.map((item) => (
            <li>{item.title}{item.detail ? ` · ${item.detail}` : ''}</li>
          ))}
        </ul>
      </section>
    )}
  </main>
</div>

<style>
.theme-professional {
  --ink: #161412;
  --text: #3f3a36;
  --muted: #7a726b;
  --line: #e4dfda;
  --side: #161412;
  --side-text: #e8e2db;
  --accent: #cfc7be;
  display: grid;
  grid-template-columns: minmax(300px, 380px) minmax(0, 1fr);
  min-height: 100vh;
  width: 100%;
  background: #faf8f5;
  color: var(--text);
  font: 400 15px/1.6 "Libre Franklin", "Segoe UI", sans-serif;
}
.theme-professional * { box-sizing: border-box; }
.pro-side {
  position: sticky;
  top: 0;
  align-self: start;
  min-height: 100vh;
  padding: clamp(36px, 4vw, 52px) clamp(28px, 3vw, 40px);
  background:
    linear-gradient(180deg, rgba(255,255,255,0.04), transparent 30%),
    var(--side);
  color: var(--side-text);
}
.pro-side h1 {
  margin: 0 0 8px;
  color: #fff;
  font: 700 clamp(28px, 3vw, 38px)/1.12 "Libre Baskerville", Georgia, serif;
}
.role {
  margin: 0 0 12px;
  color: var(--accent);
  font: 500 15px/1.45 "Libre Franklin", sans-serif;
}
.badge {
  display: inline-block;
  margin: 0 0 22px;
  padding: 0 0 6px;
  color: #f5f1eb;
  font: 600 13px/1.3 "Libre Franklin", sans-serif;
  border-bottom: 1px solid #57534e;
}
.label {
  margin: 28px 0 10px;
  color: #a8a29e;
  font: 700 11px/1.3 "Libre Franklin", sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.pro-side p {
  margin: 0 0 6px;
  font-size: 14px;
  color: var(--side-text);
}
.pro-side a { color: #fff; text-decoration: none; }
.pro-side a:hover { text-decoration: underline; }
.pro-skills-text {
  margin: 0 !important;
  color: #d6d3d1 !important;
  font-size: 14px !important;
  line-height: 1.6 !important;
}
.pro-edu { margin-bottom: 14px; }
.pro-edu strong {
  display: block;
  margin-bottom: 3px;
  color: #fff;
  font-size: 14px;
}
.pro-edu .muted { color: #a8a29e !important; }
:global(.pro-photo) {
  width: 132px;
  height: 132px;
  border-radius: 2px;
  object-fit: cover;
  margin-bottom: 22px;
  background: #44403c;
}
:global(.avatar-initials.pro-photo) {
  display: grid;
  place-items: center;
  font: 700 34px "Libre Baskerville", Georgia, serif;
  color: #fff;
}
.pro-main {
  padding: clamp(44px, 6vw, 88px) clamp(36px, 7vw, 112px) 112px;
  width: 100%;
  background: #faf8f5;
}
.pro-main h2 {
  margin: 36px 0 16px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--ink);
  color: var(--ink);
  font: 700 12px/1.3 "Libre Franklin", sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.pro-main section:first-of-type h2 { margin-top: 0; }
.pro-lead {
  margin: 0 0 10px;
  color: var(--ink);
  font: 600 18px/1.45 "Libre Franklin", sans-serif;
}
.pro-main p { margin: 0 0 10px; }
.pro-main a { color: var(--ink); }
.muted { color: var(--muted) !important; }
.pro-projects {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px 28px;
}
.pro-role {
  padding: 0 0 18px;
  margin: 0 0 18px;
  border-bottom: 1px solid var(--line);
}
.pro-role:last-child {
  border-bottom: 0;
  margin-bottom: 0;
  padding-bottom: 0;
}
.pro-role-top {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: baseline;
  margin-bottom: 6px;
}
.pro-role h3 {
  margin: 0;
  color: var(--ink);
  font: 700 17px/1.35 "Libre Franklin", sans-serif;
}
.pro-role h3 a { color: inherit; text-decoration: none; }
.pro-role h3 a:hover { text-decoration: underline; }
.pro-role time {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 13px;
  white-space: nowrap;
}
:global(.theme-professional .exp-summary) {
  margin: 6px 0 0;
  color: var(--text);
  font: 15px/1.55 "Libre Franklin", sans-serif;
}
:global(.theme-professional .exp-highlights) {
  margin: 8px 0 0;
  padding-left: 18px;
  color: var(--muted);
  font: 14px/1.5 "Libre Franklin", sans-serif;
}
.pro-bullets {
  margin: 0;
  padding-left: 18px;
  color: var(--text);
}
.pro-bullets li { margin-bottom: 6px; }
@media (max-width: 900px) {
  .theme-professional { grid-template-columns: 1fr; }
  .pro-side {
    position: static;
    min-height: 0;
  }
  .pro-projects { grid-template-columns: 1fr; }
}
</style>
