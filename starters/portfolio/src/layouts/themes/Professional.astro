---
import Avatar from '../../components/Avatar.astro';
import ExperienceDetails from '../../components/ExperienceDetails.astro';
import PrintControls from '../../components/PrintControls.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education) ? profile.education : profile.education ? [profile.education] : [];
const certifications = profile.certifications ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const careerHighlights = profile.careerHighlights ?? [];
const resumeHref = profile.resume
  ? profile.resume.startsWith('http') ? profile.resume : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
const showCredentials = certifications.length > 0 || honors.length > 0;
const showInterests = interests.length > 0 || learning.length > 0;
---
<div class="theme-professional">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Libre+Baskerville:wght@700&display=swap" rel="stylesheet" />

  <div class="pro-print-wrap no-print">
    <PrintControls />
  </div>

  <aside class="pro-side">
    <Avatar profile={profile} assetBase={assetBase} size="lg" class="pro-photo no-print" />
    <h1>{profile.name}</h1>
    <p class="role">{profile.role}</p>
    {profile.badge && <p class="badge">{profile.badge}</p>}

    <p class="label">Contact</p>
    <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    <p><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></p>
    <p><a href={profile.github} target="_blank" rel="noreferrer">GitHub</a></p>
    {resumeHref && <p class="no-print"><a href={resumeHref} target="_blank" rel="noreferrer">Resume file</a></p>}
    <p>{profile.location}</p>

    <p class="label">Skills</p>
    <p class="pro-skills-text">{profile.skills.join(' · ')}</p>

    <p class="label">Education</p>
    {education.map((item) => (
      <div class="pro-edu">
        <strong>{item.degree}</strong>
        <p>{item.school}</p>
        <p class="muted">{item.detail}</p>
      </div>
    ))}
  </aside>

  <main class="pro-main">
    <section id="about">
      <h2>Profile</h2>
      <p>{profile.tagline} {profile.about}</p>
    </section>

    <section id="experience">
      <h2>Experience</h2>
      {profile.experience.map((item) => (
        <article class="pro-role">
          <div class="pro-role-top">
            <div>
              <h3>{item.title}</h3>
              <p class="muted">{item.organization}</p>
            </div>
            <time>{item.date}</time>
          </div>
          <ExperienceDetails item={item} />
        </article>
      ))}
    </section>

    {careerHighlights.length > 0 && (
      <section id="highlights">
        <h2>Highlights</h2>
        <ul class="pro-bullets">
          {careerHighlights.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <section id="projects">
      <h2>Projects</h2>
      {profile.projects.map((project) => (
        <article class="pro-role">
          <div class="pro-role-top">
            <h3>
              {project.link ? (
                <a href={project.link} target="_blank" rel="noreferrer">{project.title}</a>
              ) : project.title}
            </h3>
          </div>
          <p>{project.summary}</p>
          {project.skills?.length > 0 && (
            <p class="muted">{project.skills.join(' · ')}</p>
          )}
        </article>
      ))}
    </section>

    {showInterests && (
      <section id="interests">
        <h2>Interests & learning</h2>
        {interests.length > 0 && <p>{interests.join(' · ')}</p>}
        {learning.length > 0 && <p class="muted">Learning: {learning.join(' · ')}</p>}
      </section>
    )}

    {showCredentials && (
      <section id="credentials">
        <h2>Credentials</h2>
        <ul class="pro-bullets">
          {certifications.map((item) => (
            <li>{item.name}{item.issuer ? ` · ${item.issuer}` : ''}</li>
          ))}
          {honors.map((item) => (
            <li>{item.title}{item.detail ? ` · ${item.detail}` : ''}</li>
          ))}
        </ul>
      </section>
    )}
  </main>
</div>

<style>
.theme-professional {
  --ink: #1c1917;
  --text: #44403c;
  --muted: #78716c;
  --line: #e7e5e4;
  --side: #1c1917;
  --side-text: #e7e5e4;
  --accent: #d6d3d1;
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  min-height: 100vh;
  background: #fff;
  color: var(--text);
  font: 400 14px/1.55 "Libre Franklin", "Segoe UI", sans-serif;
}
.theme-professional * { box-sizing: border-box; }
.pro-print-wrap {
  grid-column: 1 / -1;
  padding: 16px 20px 0;
  background: #fafaf9;
}
.pro-side {
  background: var(--side);
  color: var(--side-text);
  padding: 36px 24px 48px;
}
.pro-side h1 {
  margin: 0 0 6px;
  color: #fff;
  font: 700 26px/1.15 "Libre Baskerville", Georgia, serif;
}
.role {
  margin: 0 0 14px;
  color: var(--accent);
  font: 500 13px/1.45 "Libre Franklin", sans-serif;
}
.badge {
  display: inline-block;
  margin: 0 0 16px;
  padding: 4px 0;
  color: #fafaf9;
  font: 600 12px/1.3 "Libre Franklin", sans-serif;
  border-bottom: 1px solid #57534e;
}
.label {
  margin: 22px 0 8px;
  color: #a8a29e;
  font: 700 11px/1.3 "Libre Franklin", sans-serif;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.pro-side p {
  margin: 0 0 5px;
  font-size: 13px;
  color: var(--side-text);
}
.pro-side a { color: #fafaf9; text-decoration: none; }
.pro-side a:hover { text-decoration: underline; }
.pro-skills-text {
  margin: 0 !important;
  color: #d6d3d1 !important;
  font-size: 13px !important;
  line-height: 1.55 !important;
}
.pro-edu { margin-bottom: 12px; }
.pro-edu strong {
  display: block;
  margin-bottom: 2px;
  color: #fff;
  font-size: 13px;
}
.pro-edu .muted { color: #a8a29e !important; }
:global(.pro-photo) {
  width: 104px;
  height: 104px;
  border-radius: 2px;
  object-fit: cover;
  margin-bottom: 18px;
  background: #44403c;
}
:global(.avatar-initials.pro-photo) {
  display: grid;
  place-items: center;
  font: 700 28px "Libre Baskerville", Georgia, serif;
  color: #fff;
}
.pro-main {
  padding: 36px clamp(22px, 4vw, 48px) 64px;
  background: #fff;
}
.pro-main h2 {
  margin: 28px 0 12px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--ink);
  color: var(--ink);
  font: 700 12px/1.3 "Libre Franklin", sans-serif;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.pro-main section:first-of-type h2 { margin-top: 0; }
.pro-main p { margin: 0 0 8px; }
.pro-main a { color: var(--ink); }
.muted { color: var(--muted) !important; }
.pro-role {
  padding: 0 0 14px;
  margin: 0 0 14px;
  border-bottom: 1px solid var(--line);
}
.pro-role:last-child {
  border-bottom: 0;
  margin-bottom: 0;
  padding-bottom: 0;
}
.pro-role-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: baseline;
  margin-bottom: 4px;
}
.pro-role h3 {
  margin: 0;
  color: var(--ink);
  font: 700 15px/1.35 "Libre Franklin", sans-serif;
}
.pro-role h3 a { color: inherit; text-decoration: none; }
.pro-role h3 a:hover { text-decoration: underline; }
.pro-role time {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 12px;
  white-space: nowrap;
}
:global(.theme-professional .exp-summary) {
  margin: 4px 0 0;
  color: var(--text);
  font: 13px/1.5 "Libre Franklin", sans-serif;
}
:global(.theme-professional .exp-highlights) {
  margin: 6px 0 0;
  padding-left: 18px;
  color: var(--muted);
  font: 13px/1.5 "Libre Franklin", sans-serif;
}
.pro-bullets {
  margin: 0;
  padding-left: 18px;
  color: var(--text);
}
.pro-bullets li { margin-bottom: 4px; }
@media (max-width: 800px) {
  .theme-professional { grid-template-columns: 1fr; }
  .pro-side { padding: 28px 20px; }
}
</style>
