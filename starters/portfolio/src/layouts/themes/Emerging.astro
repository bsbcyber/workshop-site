---
import Avatar from '../../components/Avatar.astro';
import ExperienceDetails from '../../components/ExperienceDetails.astro';
import PrintControls from '../../components/PrintControls.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education) ? profile.education : profile.education ? [profile.education] : [];
const certifications = profile.certifications ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const resumeHref = profile.resume
  ? profile.resume.startsWith('http') ? profile.resume : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
const showCredentials = certifications.length > 0 || honors.length > 0;
---
<div class="theme-emerging">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@600;700&display=swap" rel="stylesheet" />

  <PrintControls />

  <div class="em-shell">
    <aside class="em-rail">
      <Avatar profile={profile} assetBase={assetBase} size="lg" class="em-photo no-print" />
      <h1>{profile.name}</h1>
      <p class="em-role">{profile.role}</p>
      {profile.badge && <p class="em-badge">{profile.badge}</p>}
      <p class="em-tagline">{profile.tagline}</p>

      <nav class="em-contact" aria-label="Contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
        {resumeHref && <a class="no-print" href={resumeHref} target="_blank" rel="noreferrer">Resume file</a>}
        <span>{profile.location}</span>
      </nav>

      <div class="em-rail-block">
        <p class="em-label">Skills</p>
        <p class="em-skills">{profile.skills.join(' · ')}</p>
      </div>
    </aside>

    <main class="em-main">
      <section class="em-section">
        <h2>About</h2>
        <p>{profile.about}</p>
      </section>

      {profile.experience?.length > 0 && (
        <section class="em-section" id="experience">
          <h2>Experience</h2>
          <div class="em-stack">
            {profile.experience.map((item) => (
              <article class="em-job">
                <header>
                  <div>
                    <h3>{item.title}</h3>
                    <p class="em-org">{item.organization}</p>
                  </div>
                  <time>{item.date}</time>
                </header>
                <ExperienceDetails item={item} />
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="em-section" id="projects">
        <h2>Projects</h2>
        <div class="em-projects">
          {profile.projects.map((project) => (
            <article class="em-job">
              <header>
                <h3>
                  {project.link ? (
                    <a href={project.link} target="_blank" rel="noreferrer">{project.title}</a>
                  ) : project.title}
                </h3>
              </header>
              <p class="em-body">{project.summary}</p>
              {project.skills?.length > 0 && (
                <p class="em-tools">{project.skills.join(' · ')}</p>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="em-section" id="education">
        <h2>Education</h2>
        <div class="em-stack">
          {education.map((item) => (
            <article class="em-job">
              <header>
                <div>
                  <h3>{item.degree}</h3>
                  <p class="em-org">{item.school}</p>
                </div>
                <time>{item.detail}</time>
              </header>
            </article>
          ))}
        </div>
      </section>

      {showCredentials && (
        <section class="em-section">
          <h2>Credentials</h2>
          <ul class="em-list">
            {certifications.map((item) => (
              <li>{item.name}{item.issuer ? ` · ${item.issuer}` : ''}</li>
            ))}
            {honors.map((item) => (
              <li>{item.title}{item.detail ? ` · ${item.detail}` : ''}</li>
            ))}
          </ul>
        </section>
      )}

      {(interests.length > 0 || learning.length > 0) && (
        <section class="em-section">
          <h2>More</h2>
          {interests.length > 0 && <p><strong>Interests:</strong> {interests.join(' · ')}</p>}
          {learning.length > 0 && <p><strong>Learning:</strong> {learning.join(' · ')}</p>}
        </section>
      )}
    </main>
  </div>
</div>

<style>
.theme-emerging {
  --ink: #102018;
  --text: #2f3b34;
  --muted: #667069;
  --line: #d7e0d9;
  --accent: #1f6b45;
  --rail: #0f2419;
  --rail-text: #d7e6dc;
  min-height: 100vh;
  width: 100%;
  background: #f4f7f5;
  color: var(--text);
  font: 400 16px/1.6 "IBM Plex Sans", "Segoe UI", sans-serif;
}
.theme-emerging * { box-sizing: border-box; }
.em-shell {
  display: grid;
  grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
  min-height: 100vh;
  width: 100%;
}
.em-rail {
  position: sticky;
  top: 0;
  align-self: start;
  min-height: 100vh;
  padding: clamp(32px, 4vw, 48px) clamp(24px, 3vw, 36px);
  background:
    linear-gradient(165deg, rgba(255,255,255,0.04), transparent 40%),
    var(--rail);
  color: var(--rail-text);
}
.em-rail h1 {
  margin: 0 0 8px;
  color: #fff;
  font: 700 clamp(28px, 3vw, 36px)/1.12 "IBM Plex Serif", Georgia, serif;
}
.em-role {
  margin: 0 0 10px;
  color: #b7d0c1;
  font: 600 15px/1.4 "IBM Plex Sans", sans-serif;
}
.em-badge {
  margin: 0 0 14px;
  color: #8fd6ad;
  font: 600 13px/1.3 "IBM Plex Sans", sans-serif;
}
.em-tagline {
  margin: 0 0 22px;
  color: #c7d8ce;
  font-size: 15px;
}
.em-contact {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 0 0 28px;
  font-size: 14px;
}
.em-contact a {
  color: #fff;
  text-decoration: none;
  width: fit-content;
  border-bottom: 1px solid transparent;
}
.em-contact a:hover { border-bottom-color: rgba(255,255,255,0.5); }
.em-contact span { color: #9bb5a6; }
.em-label {
  margin: 0 0 8px;
  color: #8aa496;
  font: 700 11px/1.3 "IBM Plex Sans", sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.em-skills {
  margin: 0;
  color: #d7e6dc;
  font-size: 14px;
  line-height: 1.55;
}
:global(.em-photo) {
  width: 120px;
  height: 120px;
  border-radius: 2px;
  object-fit: cover;
  margin-bottom: 22px;
  background: #1d3a2b;
}
:global(.avatar-initials.em-photo) {
  display: grid;
  place-items: center;
  font: 700 32px "IBM Plex Serif", Georgia, serif;
  color: #fff;
}
.em-main {
  padding: clamp(36px, 5vw, 64px) clamp(28px, 5vw, 72px) 96px;
  max-width: 920px;
}
.em-section {
  padding: 0 0 32px;
  margin: 0 0 32px;
  border-bottom: 1px solid var(--line);
}
.em-section:last-child {
  border-bottom: 0;
  margin-bottom: 0;
}
.em-section h2 {
  margin: 0 0 16px;
  color: var(--ink);
  font: 700 12px/1.3 "IBM Plex Sans", sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.em-stack, .em-projects {
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.em-projects {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px 28px;
}
.em-job header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: baseline;
  margin-bottom: 6px;
}
.em-job h3 {
  margin: 0;
  color: var(--ink);
  font: 700 18px/1.3 "IBM Plex Sans", sans-serif;
}
.em-job h3 a { color: inherit; text-decoration: none; }
.em-job h3 a:hover { color: var(--accent); text-decoration: underline; }
.em-org {
  margin: 2px 0 0;
  color: var(--accent);
  font: 600 14px/1.4 "IBM Plex Sans", sans-serif;
}
.em-job time {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 13px;
  white-space: nowrap;
}
.em-body { margin: 0; }
.em-tools {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 13px;
}
:global(.theme-emerging .exp-summary) {
  margin: 6px 0 0;
  color: var(--text);
  font: 15px/1.55 "IBM Plex Sans", sans-serif;
}
:global(.theme-emerging .exp-highlights) {
  margin: 8px 0 0;
  padding-left: 18px;
  color: var(--muted);
  font: 14px/1.5 "IBM Plex Sans", sans-serif;
}
.em-list {
  margin: 0;
  padding-left: 18px;
  font-size: 15px;
}
.em-section strong { color: var(--ink); }
@media (max-width: 900px) {
  .em-shell { grid-template-columns: 1fr; }
  .em-rail {
    position: static;
    min-height: 0;
  }
  .em-projects { grid-template-columns: 1fr; }
}
</style>
