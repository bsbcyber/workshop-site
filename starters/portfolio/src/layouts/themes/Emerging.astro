---
import Avatar from '../../components/Avatar.astro';
import ExperienceDetails from '../../components/ExperienceDetails.astro';
import PrintControls from '../../components/PrintControls.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education) ? profile.education : profile.education ? [profile.education] : [];
const certifications = profile.certifications ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const resumeHref = profile.resume
  ? profile.resume.startsWith('http') ? profile.resume : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
const showCredentials = certifications.length > 0 || honors.length > 0;
---
<div class="theme-emerging">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@600;700&display=swap" rel="stylesheet" />

  <PrintControls />

  <header class="em-header">
    <div>
      <h1>{profile.name}</h1>
      <p class="em-role">{profile.role}</p>
      <p class="em-tagline">{profile.tagline}</p>
      {profile.badge && <p class="em-badge">{profile.badge}</p>}
      <p class="em-contact">
        <span>{profile.location}</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
        {resumeHref && <a class="no-print" href={resumeHref} target="_blank" rel="noreferrer">Resume file</a>}
      </p>
    </div>
    <Avatar profile={profile} assetBase={assetBase} size="lg" class="em-photo no-print" />
  </header>

  <section class="em-section">
    <h2>About</h2>
    <div>
      <p>{profile.about}</p>
      <p class="em-skills">{profile.skills.join(' · ')}</p>
    </div>
  </section>

  {profile.experience?.length > 0 && (
    <section class="em-section" id="experience">
      <h2>Experience</h2>
      <div class="em-stack">
        {profile.experience.map((item) => (
          <article class="em-job">
            <header>
              <div>
                <h3>{item.title}</h3>
                <p class="em-org">{item.organization}</p>
              </div>
              <time>{item.date}</time>
            </header>
            <ExperienceDetails item={item} />
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="em-section" id="projects">
    <h2>Projects</h2>
    <div class="em-stack">
      {profile.projects.map((project) => (
        <article class="em-job">
          <header>
            <div>
              <h3>
                {project.link ? (
                  <a href={project.link} target="_blank" rel="noreferrer">{project.title}</a>
                ) : project.title}
              </h3>
            </div>
          </header>
          <p class="em-body">{project.summary}</p>
          {project.skills?.length > 0 && (
            <p class="em-tools">{project.skills.join(' · ')}</p>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="em-section" id="education">
    <h2>Education</h2>
    <div class="em-stack">
      {education.map((item) => (
        <article class="em-job">
          <header>
            <div>
              <h3>{item.degree}</h3>
              <p class="em-org">{item.school}</p>
            </div>
            <time>{item.detail}</time>
          </header>
        </article>
      ))}
    </div>
  </section>

  {showCredentials && (
    <section class="em-section">
      <h2>Credentials</h2>
      <ul class="em-list">
        {certifications.map((item) => (
          <li>{item.name}{item.issuer ? ` · ${item.issuer}` : ''}</li>
        ))}
        {honors.map((item) => (
          <li>{item.title}{item.detail ? ` · ${item.detail}` : ''}</li>
        ))}
      </ul>
    </section>
  )}

  {(interests.length > 0 || learning.length > 0) && (
    <section class="em-section">
      <h2>More</h2>
      <div>
        {interests.length > 0 && <p><strong>Interests:</strong> {interests.join(' · ')}</p>}
        {learning.length > 0 && <p><strong>Learning:</strong> {learning.join(' · ')}</p>}
      </div>
    </section>
  )}
</div>

<style>
.theme-emerging {
  --ink: #111827;
  --text: #374151;
  --muted: #6b7280;
  --line: #e5e7eb;
  --accent: #14532d;
  --label: 7.5rem;
  --gap: 1.75rem;
  max-width: calc(var(--label) + var(--gap) + 40rem);
  margin: 0 auto;
  padding: 36px 22px 80px;
  background: #fff;
  color: var(--text);
  font: 400 15px/1.55 "IBM Plex Sans", "Segoe UI", sans-serif;
  min-height: 100vh;
}
.theme-emerging * { box-sizing: border-box; }
.em-header {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  padding-bottom: 22px;
  margin-bottom: 8px;
  border-bottom: 1px solid var(--ink);
}
.em-header h1 {
  margin: 0 0 4px;
  color: var(--ink);
  font: 700 clamp(28px, 4.5vw, 38px)/1.1 "IBM Plex Serif", Georgia, serif;
}
.em-role {
  margin: 0 0 8px;
  color: var(--ink);
  font: 600 15px/1.4 "IBM Plex Sans", sans-serif;
}
.em-tagline { margin: 0 0 8px; max-width: 36rem; }
.em-badge {
  margin: 0 0 10px;
  color: var(--accent);
  font: 600 13px/1.3 "IBM Plex Sans", sans-serif;
}
.em-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 14px;
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}
.em-contact a { color: var(--accent); text-decoration: none; }
.em-contact a:hover { text-decoration: underline; }
:global(.em-photo) {
  width: 92px;
  height: 92px;
  border-radius: 2px;
  object-fit: cover;
  background: #e5e7eb;
  flex-shrink: 0;
}
:global(.avatar-initials.em-photo) {
  display: grid;
  place-items: center;
  font: 700 26px "IBM Plex Serif", Georgia, serif;
  color: var(--ink);
}
.em-section {
  display: grid;
  grid-template-columns: var(--label) minmax(0, 1fr);
  column-gap: var(--gap);
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}
.em-section h2 {
  margin: 0;
  color: var(--ink);
  font: 700 12px/1.4 "IBM Plex Sans", sans-serif;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.em-skills, .em-tools {
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 13px;
}
.em-stack { display: flex; flex-direction: column; gap: 16px; }
.em-job header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: baseline;
  margin-bottom: 4px;
}
.em-job h3 {
  margin: 0;
  color: var(--ink);
  font: 700 15px/1.35 "IBM Plex Sans", sans-serif;
}
.em-job h3 a { color: inherit; text-decoration: none; }
.em-job h3 a:hover { color: var(--accent); text-decoration: underline; }
.em-org {
  margin: 0;
  color: var(--accent);
  font: 600 13px/1.4 "IBM Plex Sans", sans-serif;
}
.em-job time {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 13px;
  white-space: nowrap;
}
.em-body { margin: 0; }
:global(.theme-emerging .exp-summary) {
  margin: 6px 0 0;
  color: var(--text);
  font: 14px/1.55 "IBM Plex Sans", sans-serif;
}
:global(.theme-emerging .exp-highlights) {
  margin: 6px 0 0;
  padding-left: 18px;
  color: var(--muted);
  font: 13px/1.5 "IBM Plex Sans", sans-serif;
}
.em-list {
  margin: 0;
  padding-left: 18px;
  font-size: 14px;
}
.em-section strong { color: var(--ink); }
@media (max-width: 720px) {
  .em-section {
    grid-template-columns: 1fr;
    row-gap: 8px;
  }
  .em-section h2 {
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
  }
  .em-header { flex-direction: column-reverse; }
}
</style>
